@@ -0,0 +1,46 @@
+"""Test the exact examples from the issue description."""
+from __future__ import annotations
+
+
+async def test_issue_example_plus_0200(client, auth_headers, tokens):
+    # Test the exact example from the issue: POST /events with start_time = "2023-01-01T10:00:00+02:00"
+    r = await client.post(
+        "/events",
+        headers=auth_headers(tokens["alice"]),
+        json={
+            "title": "Test Event",
+            "starts_at": "2023-01-01T10:00:00+02:00",
+            "capacity": 5,
+            "price": "10.00",
+        },
+    )
+    assert r.status_code == 201
+    
+    event_id = r.json()["id"]
+    
+    # GET /events/{id} should return start_time = "2023-01-01T08:00:00Z"
+    got = await client.get(f"/events/{event_id}")
+    assert got.status_code == 200
+    assert got.json()["starts_at"] == "2023-01-01T08:00:00+00:00"
+
+
