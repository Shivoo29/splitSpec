--- a/test_pagination_total.py
+++ b/test_pagination_total.py
@@ -0,0 +1,49 @@
+"""Test to verify the pagination total issue."""
+import pytest
+from httpx import AsyncClient
+
+
+@pytest.mark.anyio
+async def test_pagination_total_count(client: AsyncClient):
+    """Test that total reflects the overall count, not just the current page."""
+    
+    # Get all events with a large limit
+    r = await client.get("/events?limit=100&offset=0")
+    assert r.status_code == 200
+    body = r.json()
+    full_count = body["total"]
+    
+    # Get events with a small limit
+    r = await client.get("/events?limit=2&offset=0")
+    assert r.status_code == 200
+    body = r.json()
+    
+    # The total should be the same regardless of limit
+    assert body["total"] == full_count, f"Expected total={full_count}, got {body['total']}"
+    
+    # The items array should respect the limit
+    assert len(body["items"]) == 2, f"Expected 2 items with limit=2, got {len(body['items'])}"
+    
+    # Verify we have more than 2 events in total
+    assert full_count > 2, f"Expected more than 2 events, got {full_count}"
+
+
+@pytest.mark.anyio
+async def test_pagination_total_with_offset(client: AsyncClient):
+    """Test that total is correct even with offset."""
+    
+    # Get all events with a large limit
+    r = await client.get("/events?limit=100&offset=0")
+    assert r.status_code == 200
+    full_count = r.json()["total"]
+    
+    # Get events with offset
+    r = await client.get("/events?limit=1&offset=1")
+    assert r.status_code == 200
+    body = r.json()
+    
+    # The total should still be the same
+    assert body["total"] == full_count, f"Expected total={full_count}, got {body['total']}"
+    
+    # The items array should have 1 item
+    assert len(body["items"]) == 1, f"Expected 1 item with limit=1, got {len(body['items'])}"
