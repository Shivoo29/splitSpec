@@ -0,0 +1,36 @@
+"""Simple script to verify the pagination total fix."""
+import asyncio
+from httpx import AsyncClient
+from app.main import app
+
+
+async def main():
+    async with AsyncClient(app=app, base_url="http://test") as client:
+        # Test 1: Get all events with large limit
+        r = await client.get("/events?limit=100&offset=0")
+        body = r.json()
+        full_count = body["total"]
+        print(f"Full count (limit=100): {full_count}")
+        print(f"Items returned: {len(body['items'])}")
+        
+        # Test 2: Get events with small limit
+        r = await client.get("/events?limit=2&offset=0")
+        body = r.json()
+        print(f"\nWith limit=2:")
+        print(f"Total: {body['total']}")
+        print(f"Items returned: {len(body['items'])}")
+        
+        # Test 3: Get events with offset
+        r = await client.get("/events?limit=1&offset=1")
+        body = r.json()
+        print(f"\nWith limit=1, offset=1:")
+        print(f"Total: {body['total']}")
+        print(f"Items returned: {len(body['items'])}")
+        
+        # Verify the fix
+        assert body["total"] == full_count, f"Total mismatch! Expected {full_count}, got {body['total']}"
+        print(f"\n✓ Fix verified: Total count is consistent across different pagination parameters!")
+
+
+if __name__ == "__main__":
+    asyncio.run(main())
