+"""Test that newly created events appear in the event list immediately."""
+from __future__ import annotations
+
+
+async def test_newly_created_event_appears_in_list(client, auth_headers, tokens):
+    """Test that a newly created event is immediately visible in the event list."""
+    new_event = {
+        "title": "Immediate Test Event",
+        "starts_at": "2026-09-01T18:00:00+00:00",
+        "capacity": 50,
+        "price": "30.00",
+        "currency": "USD",
+    }
+    
+    # Create a new event
+    create_response = await client.post("/events", headers=auth_headers(tokens["alice"]), json=new_event)
+    assert create_response.status_code == 201
+    created_event = create_response.json()
+    event_id = created_event["id"]
+    
+    # Immediately fetch the event list
+    list_response = await client.get("/events")
+    assert list_response.status_code == 200
+    event_list = list_response.json()
+    
+    # Check that the newly created event is in the list
+    event_ids_in_list = [event["id"] for event in event_list["items"]]
+    assert event_id in event_ids_in_list, f"Event {event_id} not found in event list: {event_ids_in_list}"
+    
+    # Also verify the event details match
+    found_event = next((event for event in event_list["items"] if event["id"] == event_id), None)
+    assert found_event is not None
+    assert found_event["title"] == new_event["title"]
