+"""Manual verification of the fix."""
+import pytest
+import httpx
+import pytest_asyncio
+from app.main import create_app
+from app.timeutil import FixedClock
+from seed import ALICE_TOKEN, BOB_TOKEN, seed
+
+FIXED_NOW = "2026-01-01T12:00:00+00:00"
+
+
+@pytest_asyncio.fixture
+async def client():
+    application = create_app("sqlite://", clock=FixedClock.from_iso(FIXED_NOW))
+    with application.state.sessionmaker() as session:
+        seed(session)
+    transport = httpx.ASGITransport(app=application)
+    async with httpx.AsyncClient(transport=transport, base_url="http://test") as ac:
+        yield ac
+
+
+@pytest.mark.asyncio
+async def test_manual_verification(client):
+    # Alice tries to access her own ticket (ticket 1)
+    r = await client.get("/tickets/1", headers={"Authorization": f"Bearer {ALICE_TOKEN}"})
+    print(f"Alice accessing her own ticket: {r.status_code}")
+    if r.status_code == 200:
+        print(f"Response: {r.json()}")
+    
+    # Alice tries to access Carol's ticket (ticket 4)
+    r = await client.get("/tickets/4", headers={"Authorization": f"Bearer {ALICE_TOKEN}"})
+    print(f"Alice accessing Carol's ticket: {r.status_code}")
+    if r.status_code == 200:
+        print(f"Response: {r.json()}")
+    else:
+        print(f"Response: {r.text}")
+    
+    # Bob tries to access Alice's ticket (ticket 1)
+    r = await client.get("/tickets/1", headers={"Authorization": f"Bearer {BOB_TOKEN}"})
+    print(f"Bob accessing Alice's ticket: {r.status_code}")
+    if r.status_code == 200:
+        print(f"Response: {r.json()}")
+    else:
+        print(f"Response: {r.text}")
+
+
+if __name__ == "__main__":
+    pytest.main([__file__, "-v", "-s"])
