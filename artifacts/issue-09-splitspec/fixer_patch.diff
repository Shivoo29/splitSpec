+"""Test that cache invalidation works correctly when creating events."""
+from __future__ import annotations
+
+
+async def test_event_list_cache_invalidation_on_create(client, auth_headers, tokens):
+    """Test that the event list cache is invalidated when a new event is created."""
+    new_event = {
+        "title": "Cached Event",
+        "starts_at": "2026-09-01T18:00:00+00:00",
+        "capacity": 40,
+        "price": "25.00",
+        "currency": "USD",
+    }
+    
+    # First, get the event list to populate the cache
+    list_response1 = await client.get("/events")
+    assert list_response1.status_code == 200
+    initial_count = len(list_response1.json()["items"])
+    
+    # Create a new event
+    create_response = await client.post("/events", headers=auth_headers(tokens["alice"]), json=new_event)
+    assert create_response.status_code == 201
+    event_id = create_response.json()["id"]
+    
+    # Get the event list again - it should include the new event
+    list_response2 = await client.get("/events")
+    assert list_response2.status_code == 200
+    
+    # Check that the count increased and the new event is present
+    assert len(list_response2.json()["items"]) == initial_count + 1, \
+        f"Event count did not increase: {initial_count} -> {len(list_response2.json()['items'])}"
+    
+    event_ids = [item["id"] for item in list_response2.json()["items"]]
+    assert event_id in event_ids, f"Newly created event {event_id} not found in event list"
