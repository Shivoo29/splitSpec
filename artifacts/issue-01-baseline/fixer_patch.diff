+"""Test validation of empty title and negative price."""
+import pytest
+from httpx import AsyncClient
+
+
+async def test_empty_title_is_rejected(client, auth_headers, tokens):
+    """Test that creating an event with empty title is rejected."""
+    payload = {
+        "title": "",
+        "starts_at": "2026-06-01T09:00:00Z",
+        "capacity": 10,
+        "price": "25.00",
+        "currency": "USD",
+    }
+    r = await client.post("/events", headers=auth_headers(tokens["alice"]), json=payload)
+    assert r.status_code == 422  # Unprocessable Entity
+    body = r.json()
+    assert "detail" in body
+    # Check that the event was not created
+    listing = (await client.get("/events")).json()
+    titles = [e["title"] for e in listing["items"]]
+    assert "" not in titles
+
+
+async def test_negative_price_is_rejected(client, auth_headers, tokens):
+    """Test that creating an event with negative price is rejected."""
+    payload = {
+        "title": "Test Event",
+        "starts_at": "2026-06-01T09:00:00Z",
+        "capacity": 10,
+        "price": "-25.00",
+        "currency": "USD",
+    }
+    r = await client.post("/events", headers=auth_headers(tokens["alice"]), json=payload)
+    assert r.status_code == 422  # Unprocessable Entity
+    body = r.json()
+    assert "detail" in body
+    # Check that the event was not created
+    listing = (await client.get("/events")).json()
+    titles = [e["title"] for e in listing["items"]]
