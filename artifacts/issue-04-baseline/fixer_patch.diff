+"""Test that issue-04 (Money rounding for JPY) is fixed."""
+from decimal import Decimal
+import pytest
+from app import money
+
+
+def test_jpy_has_zero_decimal_places():
+    """JPY should be configured with 0 decimal places."""
+    assert money.SUPPORTED["JPY"] == 0
+
+
+def test_jpy_quantize_rounds_to_integer():
+    """JPY amounts should be quantized to integers."""
+    # Test round-half-up behavior
+    assert money.quantize(Decimal("1200.0"), "JPY") == Decimal("1200")
+    assert money.quantize(Decimal("1200.49"), "JPY") == Decimal("1200")
+    assert money.quantize(Decimal("1200.50"), "JPY") == Decimal("1201")
+    assert money.quantize(Decimal("1200.75"), "JPY") == Decimal("1201")
+    assert money.quantize(Decimal("1200.99"), "JPY") == Decimal("1201")
+
+
+def test_jpy_render_no_decimal_point():
+    """JPY amounts should render without decimal points."""
+    assert money.render(Decimal("1200"), "JPY") == "1200"
+    assert money.render(Decimal("1200.0"), "JPY") == "1200"
+    assert money.render(Decimal("1200.5"), "JPY") == "1201"
+    assert money.render(Decimal("1200.75"), "JPY") == "1201"
+
+
+def test_usd_still_has_two_decimal_places():
+    """USD should still have 2 decimal places (unchanged)."""
+    assert money.SUPPORTED["USD"] == 2
+    assert money.quantize(Decimal("1200.75"), "USD") == Decimal("1200.75")
+    assert money.render(Decimal("1200.75"), "USD") == "1200.75"
+
+
+@pytest.mark.asyncio
+async def test_jpy_event_creation_and_retrieval(client, auth_headers, tokens):
+    """Test that JPY events are created and retrieved with integer prices."""
+    # Create event with fractional JPY price
+    response = await client.post(
+        "/events",
+        headers=auth_headers(tokens["alice"]),
+        json={
+            "title": "Test JPY Event",
+            "starts_at": "2026-07-01T10:00:00Z",
+            "capacity": 10,
+            "price": "1500.75",
+            "currency": "JPY",
+        },
+    )
+    assert response.status_code == 201
+    data = response.json()
+    assert data["currency"] == "JPY"
+    assert data["price"] == "1501"  # Rounded to integer
+
+    # Retrieve the event and verify it still has integer price
+    event_id = data["id"]
+    response = await client.get(f"/events/{event_id}")
+    assert response.status_code == 200
+    data = response.json()
+    assert data["currency"] == "JPY"
+    assert data["price"] == "1501"  # Still integer
+
+
+@pytest.mark.asyncio
+async def test_jpy_payment(client, auth_headers, tokens):
+    """Test that JPY payments are created with integer amounts."""
+    # Create a JPY event first
+    response = await client.post(
+        "/events",
+        headers=auth_headers(tokens["alice"]),
+        json={
+            "title": "JPY Payment Test",
+            "starts_at": "2026-07-01T10:00:00Z",
+            "capacity": 10,
+            "price": "2000.50",
+            "currency": "JPY",
+        },
+    )
+    assert response.status_code == 201
+    event_data = response.json()
+    event_id = event_data["id"]
+
+    # Charge for the event
+    headers = {
+        **auth_headers(tokens["dana"]),
+        "Idempotency-Key": "test-jpy-payment-fix",
+    }
+    response = await client.post(
+        "/payments", headers=headers, json={"event_id": event_id}
+    )
+    assert response.status_code == 201
+    payment_data = response.json()
+    assert payment_data["currency"] == "JPY"
+    assert payment_data["amount"] == "2001"  # Rounded to integer
+
+
+if __name__ == "__main__":
+    pytest.main([__file__, "-v", "-s"])
