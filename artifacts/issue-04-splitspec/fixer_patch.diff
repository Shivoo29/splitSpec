+"""Integration test for JPY handling in API responses."""
+from datetime import datetime
+from decimal import Decimal
+from app import money
+from app.models import Event, Payment
+from app.routes.events import event_payload
+from app.routes.payments import payment_payload
+
+
+def test_event_payload_jpy():
+    """Test that event payloads correctly format JPY amounts."""
+    # Create a mock event with JPY currency
+    event = Event(
+        id=1,
+        title="Test Event",
+        description="Test",
+        starts_at=datetime(2026, 3, 10, 14, 0, 0),
+        capacity=10,
+        price=Decimal("1200"),
+        currency="JPY",
+        created_by=1,
+        created_at=datetime(2025, 11, 1, 9, 0, 0),
+    )
+    
+    # Get the payload
+    payload = event_payload(event)
+    
+    # Verify JPY price is rendered as integer string
+    assert payload["price"] == "1200"
+    assert payload["currency"] == "JPY"
+
+
+def test_event_payload_jpy_with_fraction():
+    """Test that fractional JPY amounts are rounded and formatted correctly."""
+    event = Event(
+        id=2,
+        title="Test Event 2",
+        description="Test 2",
+        starts_at=datetime(2026, 3, 10, 14, 0, 0),
+        capacity=10,
+        price=Decimal("1200.5"),
+        currency="JPY",
+        created_by=1,
+        created_at=datetime(2025, 11, 1, 9, 0, 0),
+    )
+    
+    payload = event_payload(event)
+    
+    # Verify fractional JPY is rounded to 1201 and rendered as integer
+    assert payload["price"] == "1201"
+    assert payload["currency"] == "JPY"
+
+
+def test_payment_payload_jpy():
+    """Test that payment payloads correctly format JPY amounts."""
+    payment = Payment(
+        id=1,
+        user_id=1,
+        event_id=1,
+        amount=Decimal("1500"),
+        currency="JPY",
+        idempotency_key="test-001",
+        status="succeeded",
+        created_at=datetime(2025, 12, 1, 8, 5, 0),
+    )
+    
+    payload = payment_payload(payment)
+    
+    # Verify JPY amount is rendered as integer string
+    assert payload["amount"] == "1500"
+    assert payload["currency"] == "JPY"
+
+
+if __name__ == "__main__":
+    test_event_payload_jpy()
+    test_event_payload_jpy_with_fraction()
+    test_payment_payload_jpy()
+    print("All API integration tests passed!")
