+"""Comprehensive tests for JPY handling."""
+from decimal import Decimal
+from app import money
+
+
+def test_jpy_cash_places():
+    """JPY should have 0 decimal places."""
+    assert money.cash_places("JPY") == 0
+
+
+def test_jpy_quantize_whole_number():
+    """Whole JPY amounts should remain unchanged."""
+    assert money.quantize(Decimal("1200"), "JPY") == Decimal("1200")
+
+
+def test_jpy_quantize_rounding():
+    """Fractional JPY amounts should round to whole numbers."""
+    # Round half up: 0.5 rounds up
+    assert money.quantize(Decimal("1200.5"), "JPY") == Decimal("1201")
+    assert money.quantize(Decimal("1200.4"), "JPY") == Decimal("1200")
+    assert money.quantize(Decimal("1200.6"), "JPY") == Decimal("1201")
+
+
+def test_jpy_render_whole_number():
+    """Whole JPY amounts should render as integers without decimal places."""
+    assert money.render(Decimal("1200"), "JPY") == "1200"
+
+
+def test_jpy_render_rounded():
+    """Fractional JPY amounts should render as rounded integers."""
+    assert money.render(Decimal("1200.5"), "JPY") == "1201"
+    assert money.render(Decimal("1200.4"), "JPY") == "1200"
+
+
+def test_usd_unchanged():
+    """USD should still work with 2 decimal places."""
+    assert money.cash_places("USD") == 2
+    assert money.quantize(Decimal("1.005"), "USD") == Decimal("1.01")
+    assert money.render(Decimal("25"), "USD") == "25.00"
+
+
+if __name__ == "__main__":
+    # Run tests manually
+    test_jpy_cash_places()
+    test_jpy_quantize_whole_number()
+    test_jpy_quantize_rounding()
+    test_jpy_render_whole_number()
+    test_jpy_render_rounded()
+    test_usd_unchanged()
+    print("All JPY tests passed!")
