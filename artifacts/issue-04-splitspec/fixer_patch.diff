--- a/test_issue_04_resolved.py
+++ b/test_issue_04_resolved.py
@@ -0,0 +1,38 @@
+"""Test to demonstrate that issue-04 is resolved."""
+from decimal import Decimal
+from app import money
+
+
+def test_jpy_no_decimal_places():
+    """JPY amounts should have no decimal places."""
+    # Test with whole number
+    assert money.render(Decimal("1200"), "JPY") == "1200"
+    
+    # Test with fractional amount (should round)
+    assert money.render(Decimal("1200.5"), "JPY") == "1201"
+    
+    # Verify no ".00" suffix
+    result = money.render(Decimal("1200"), "JPY")
+    assert "." not in result
+    assert result == "1200"
+
+
+def test_jpy_rounding():
+    """JPY fractional amounts should round to whole numbers."""
+    # Round half up
+    assert money.quantize(Decimal("1200.5"), "JPY") == Decimal("1201")
+    assert money.quantize(Decimal("1200.4"), "JPY") == Decimal("1200")
+    assert money.quantize(Decimal("1200.6"), "JPY") == Decimal("1201")
+
+
+def test_usd_unchanged():
+    """USD should still work with 2 decimal places."""
+    assert money.render(Decimal("25"), "USD") == "25.00"
+    assert money.quantize(Decimal("1.005"), "USD") == Decimal("1.01")
+
+
+if __name__ == "__main__":
+    test_jpy_no_decimal_places()
+    test_jpy_rounding()
+    test_usd_unchanged()
+    print("✓ Issue-04 resolved: JPY amounts are now correctly formatted without decimal places")
