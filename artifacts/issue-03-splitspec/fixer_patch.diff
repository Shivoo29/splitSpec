+"""Test to reproduce the timezone offset issue."""
+import pytest
+from datetime import datetime, timezone
+
+
+async def test_nonzero_offset_roundtrips(client, auth_headers, tokens):
+    """Test that a timestamp with a non-zero offset is correctly stored and retrieved."""
+    # Create event with +02:00 offset (10:00 AM in timezone with +2 hours from UTC)
+    r = await client.post(
+        "/events",
+        headers=auth_headers(tokens["alice"]),
+        json={
+            "title": "Morning Standup",
+            "starts_at": "2023-09-01T10:00:00+02:00",
+            "capacity": 5,
+            "price": "10.00",
+        },
+    )
+    assert r.status_code == 201
+    
+    # The returned timestamp should represent the same instant in time
+    # Either as UTC (08:00:00Z) or with the original offset (10:00:00+02:00)
+    returned_timestamp = r.json()["starts_at"]
+    print(f"Returned timestamp: {returned_timestamp}")
+    
+    # Parse both timestamps and compare
+    original = datetime.fromisoformat("2023-09-01T10:00:00+02:00")
+    returned = datetime.fromisoformat(returned_timestamp)
+    
+    print(f"Original timestamp: {original}")
+    print(f"Returned timestamp: {returned}")
+    
+    # Both should represent the same instant in time
+    # When converted to UTC, they should be equal
+    assert original.astimezone(timezone.utc) == returned.astimezone(timezone.utc)
+    
+    event_id = r.json()["id"]
+    
+    # Also check the GET endpoint
+    got = await client.get(f"/events/{event_id}")
+    assert got.status_code == 200
+    retrieved_timestamp = got.json()["starts_at"]
+    print(f"Retrieved timestamp: {retrieved_timestamp}")
+    
+    retrieved = datetime.fromisoformat(retrieved_timestamp)
+    assert original.astimezone(timezone.utc) == retrieved.astimezone(timezone.utc)
+
+
+if __name__ == "__main__":
+    pytest.main([__file__, "-v", "-s"])
