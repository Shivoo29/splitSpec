+"""Test to verify the pagination total issue."""
+import pytest
+from fastapi.testclient import TestClient
+
+
+async def test_pagination_total_issue(client: TestClient):
+    """Test that total reflects all events, not just the current page."""
+    
+    # Get first page with limit=2
+    response1 = await client.get("/events?limit=2&offset=0")
+    assert response1.status_code == 200
+    data1 = response1.json()
+    
+    # Get second page with limit=2
+    response2 = await client.get("/events?limit=2&offset=2")
+    assert response2.status_code == 200
+    data2 = response2.json()
+    
+    # Get all events with large limit
+    response3 = await client.get("/events?limit=100&offset=0")
+    assert response3.status_code == 200
+    data3 = response3.json()
+    
+    print(f"Page 1 (limit=2, offset=0): total={data1['total']}, items={len(data1['items'])}")
+    print(f"Page 2 (limit=2, offset=2): total={data2['total']}, items={len(data2['items'])}")
+    print(f"All events (limit=100): total={data3['total']}, items={len(data3['items'])}")
+    
+    # The total should be the same for all requests and equal to the actual total number of events
+    assert data1['total'] == data2['total'] == data3['total'], "Total should be consistent across all requests"
+    assert data1['total'] == len(data3['items']), "Total should equal the actual number of events"
+    
+    # Each page should have the correct number of items
+    assert len(data1['items']) == 2, "First page should have 2 items"
+    assert len(data2['items']) == 1, "Second page should have 1 item (3 total events)"
+    assert len(data3['items']) == 3, "Large limit should return all 3 events"
+
+
+if __name__ == "__main__":
+    pytest.main([__file__, "-v", "-s"])
