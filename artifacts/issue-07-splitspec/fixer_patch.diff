+"""Test that concurrent registration attempts are handled correctly."""
+import pytest
+from sqlalchemy import create_engine
+from sqlalchemy.orm import sessionmaker
+
+from app.db import Base
+from app.models import Event, Registration, User
+from app.routes.registrations import RegisterIn, register
+from app.timeutil import FixedClock
+from seed import seed
+from unittest.mock import Mock
+from fastapi import HTTPException
+
+
+@pytest.fixture
+def db_session():
+    """Create a fresh in-memory database for each test."""
+    engine = create_engine("sqlite:///:memory:", connect_args={"check_same_thread": False})
+    Base.metadata.create_all(engine)
+    Session = sessionmaker(bind=engine, expire_on_commit=False)
+    session = Session()
+    seed(session)
+    yield session
+    session.close()
+
+
+def test_concurrent_registration_with_lock(db_session):
+    """Test that the FOR UPDATE lock prevents duplicate confirmed registrations."""
+    from app.main import create_app
+    
+    # Create a mock request
+    app = create_app("sqlite://", clock=FixedClock.from_iso("2026-01-01T12:00:00+00:00"))
+    
+    # Get user and event
+    user = db_session.get(User, 4)  # Dana
+    event = db_session.get(Event, 1)  # PyConf 2026
+    
+    # First registration should succeed
+    payload = RegisterIn(event_id=1)
+    mock_request = Mock(spec=Mock)
+    mock_request.app = app
+    
+    result1 = register(
+        payload=payload,
+        request=mock_request,
+        user=user,
+        session=db_session
+    )
+    
+    assert result1["status"] == "confirmed"
+    assert result1["user_id"] == user.id
+    assert result1["event_id"] == event.id
+    
+    # Second registration should fail with 409
+    try:
+        result2 = register(
+            payload=payload,
+            request=mock_request,
+            user=user,
+            session=db_session
+        )
+        assert False, "Should have raised HTTPException for duplicate registration"
+    except HTTPException as e:
+        assert e.status_code == 409
+        assert "already registered" in e.detail.lower()
+    
+    # Verify only one confirmed registration exists
+    confirmed_regs = db_session.query(Registration).filter(
+        Registration.user_id == user.id,
+        Registration.event_id == event.id,
+        Registration.status == "confirmed"
+    ).all()
+    
+    assert len(confirmed_regs) == 1, f"Expected 1 confirmed registration, got {len(confirmed_regs)}"
+
+
+def test_reactivate_cancelled_registration(db_session):
+    """Test that a cancelled registration can be reactivated."""
+    from app.main import create_app
+    
+    # Create a mock request
+    app = create_app("sqlite://", clock=FixedClock.from_iso("2026-01-01T12:00:00+00:00"))
+    
+    # Get user and event - Bob has a cancelled registration for PyConf 2026
+    user = db_session.get(User, 2)  # Bob
+    event = db_session.get(Event, 1)  # PyConf 2026
+    
+    # Verify Bob has a cancelled registration
+    cancelled_reg = db_session.query(Registration).filter(
+        Registration.user_id == user.id,
+        Registration.event_id == event.id,
+        Registration.status == "cancelled"
+    ).first()
+    
+    assert cancelled_reg is not None, "Bob should have a cancelled registration"
+    
+    # Reactivate the registration
+    payload = RegisterIn(event_id=1)
+    mock_request = Mock(spec=Mock)
+    mock_request.app = app
+    
+    result = register(
+        payload=payload,
+        request=mock_request,
+        user=user,
+        session=db_session
+    )
+    
+    assert result["status"] == "confirmed"
+    assert result["user_id"] == user.id
+    assert result["event_id"] == event.id
+    
+    # Verify the registration was updated, not created new
+    regs = db_session.query(Registration).filter(
+        Registration.user_id == user.id,
+        Registration.event_id == event.id
+    ).all()
+    
+    assert len(regs) == 1, f"Expected 1 registration total, got {len(regs)}"
+    assert regs[0].status == "confirmed", "Registration should be confirmed"
+
+
+if __name__ == "__main__":
+    pytest.main([__file__, "-v", "-s"])
