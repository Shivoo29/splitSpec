+    
+    # Bob already has a cancelled registration for PyConf 2026
+    regs = session.query(Registration).filter(
+        Registration.user_id == user.id,
+        Registration.event_id == event.id
+    ).all()
+    
+    print(f"Bob has {len(regs)} registrations for PyConf 2026")
+    for reg in regs:
+        print(f"  - Status: {reg.status}")
+    
+    session.close()
+
