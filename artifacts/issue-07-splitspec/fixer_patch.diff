+    session = Session()
+    seed(session)
+    yield session
+    session.close()
+
+
+def test_race_condition_simulation(db_session):
+    """Simulate a race condition by manually creating duplicate registrations."""
+    from app.main import create_app
+    from app.routes.registrations import register
+    from fastapi import Request
+    from unittest.mock import Mock
+    
+    # Create a mock request
+    app = create_app("sqlite://", clock=FixedClock.from_iso("2026-01-01T12:00:00+00:00"))
+    
+    # Get user and event
+    user = db_session.get(User, 4)  # Dana
+    event = db_session.get(Event, 1)  # PyConf 2026
+    
+    # Simulate the race condition by manually inserting a registration
+    # This simulates what happens if two requests pass the check simultaneously
+    reg1 = Registration(
+        user_id=user.id,
+        event_id=event.id,
+        status="confirmed",
+        created_at=FixedClock.from_iso("2026-01-01T12:00:00+00:00").utcnow()
+    )
+    db_session.add(reg1)
+    db_session.commit()
+    
+    # Now try to create another registration for the same user/event
+    # This should fail, but with the current code it might succeed
+    payload = RegisterIn(event_id=1)
+    
+    # Create a mock request
+    mock_request = Mock(spec=Request)
+    mock_request.app = app
+    
+    try:
+        result = register(
+            payload=payload,
+            request=mock_request,
+            user=user,
+            session=db_session
+        )
+        # If we get here, the registration was created, which is the bug!
+        assert False, "Should have raised HTTPException for duplicate registration"
+    except Exception as e:
+        # Expected: should raise HTTPException with status 409
+        assert "409" in str(e) or "already registered" in str(e).lower()
+    
+    # Verify only one confirmed registration exists
+    confirmed_regs = db_session.scalars(
+        select(Registration)
+        .where(Registration.user_id == user.id)
+        .where(Registration.event_id == event.id)
+        .where(Registration.status == "confirmed")
+    ).all()
+    
+    assert len(confirmed_regs) == 1, f"Expected 1 confirmed registration, got {len(confirmed_regs)}"
+
+
+if __name__ == "__main__":
+    pytest.main([__file__, "-v", "-s"])
