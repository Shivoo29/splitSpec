# Copy to .env. Never commit .env. Never paste these into a chat.
#
# Every provider below is used through its OpenAI-compatible endpoint, so switching
# vendors is a base_url + model change, never a code change.
#
# The fixer and verifier are pinned to DIFFERENT models on purpose: "the verifier is
# independent of the fixer" is a much stronger claim when they are not the same weights.
# Both are recorded into result.json for every run.

# --- Fixer agent -------------------------------------------------------------
SPLITSPEC_FIXER_BASE_URL=https://api.groq.com/openai/v1
# Verified working on Groq: qwen/qwen3.8-27b, qwen/qwen3.6-27b, openai/gpt-oss-120b.
# `GET /openai/v1/models` lists what your key can actually reach.
SPLITSPEC_FIXER_MODEL=qwen/qwen3.8-27b
# Comma-separated, no spaces needed: gsk_aaa,gsk_bbb,gsk_ccc
# Several keys for the SAME model are rotated on 429 for throughput only. Adding keys
# raises your rate ceiling; it never changes the experiment.
SPLITSPEC_FIXER_API_KEYS=gsk_...

# --- Verifier agent ----------------------------------------------------------
SPLITSPEC_VERIFIER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Pin an exact version. The floating `gemini-flash-latest` alias returns 503 under load,
# and a sweep whose model changed halfway is not a sweep.
SPLITSPEC_VERIFIER_MODEL=gemini-2.5-flash
SPLITSPEC_VERIFIER_API_KEYS=...

# --- Contract builder --------------------------------------------------------
# Blank means "reuse the verifier's provider", which is the pragmatic default and
# what the first runs used. Be aware of what it costs you: the contract is handed
# to BOTH agents, so building it with the verifier's own model gives the verifier
# a mild home-field advantage - it receives a problem framed by its own family.
#
# Setting a THIRD model here removes that. Verified working as a neutral third:
#   SPLITSPEC_CONTRACT_BASE_URL=https://api.groq.com/openai/v1
#   SPLITSPEC_CONTRACT_MODEL=openai/gpt-oss-120b
# It is a reasoning model, so it needs the full token budget and burns through a
# free tier's per-minute limit quickly. Prefer it once the pipeline is stable and
# you are recording results; the blank default is fine while developing.
#
# Whatever you choose, keep it fixed for a whole sweep and report it: the contract
# model shapes what both agents were asked to satisfy.
SPLITSPEC_CONTRACT_BASE_URL=
SPLITSPEC_CONTRACT_MODEL=
SPLITSPEC_CONTRACT_API_KEYS=

# --- Budgets and limits ------------------------------------------------------
SPLITSPEC_MAX_TOKENS_PER_AGENT=200000
SPLITSPEC_AGENT_TIMEOUT_SEC=900
SPLITSPEC_MAX_RETRIES=5
SPLITSPEC_RETRY_BASE_DELAY_SEC=2

# Cross-MODEL failover is off by default, and the recommendation is to leave it off
# and leave these blank. It does not make a run "work": any case that fails over is
# marked degraded and dropped from the headline metric, so a sweep that leans on it
# finishes with fewer usable results than one that simply waited.
#
# Rate limits are not what this is for. A 429 rotates to your next key for the same
# model and then backs off exponentially, which is the correct response to a free
# tier and needs no configuration. Add more keys to SPLITSPEC_*_API_KEYS instead -
# that raises your ceiling without touching the experiment.
#
# The one case that justifies filling this in: a long unattended sweep where a
# provider outage would otherwise lose hours of work, and you would rather have a
# degraded, clearly-labelled result than no result. Then point it at a model you
# are content to name in the writeup as "some cases ran on X instead".
SPLITSPEC_ALLOW_CROSS_MODEL_FALLBACK=false
SPLITSPEC_FALLBACK_BASE_URL=
SPLITSPEC_FALLBACK_MODEL=
SPLITSPEC_FALLBACK_API_KEYS=

# --- Sandbox -----------------------------------------------------------------
SPLITSPEC_SANDBOX_IMAGE=splitspec-sandbox:latest
SPLITSPEC_SANDBOX_NETWORK=none
