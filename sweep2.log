        "contents": "import pytest\nimport asyncio\nfrom httpx import AsyncClient\n\n@pytest.mark.asyncio\nasync def test_concurrent_registration_should_not_duplicate(client, auth_headers, tokens):\n    # Use 'dana' who is not pre-registered for event 1.\n    headers = auth_headers(tokens['dana'])\n    payload = {'event_id': 1}\n    \n    # Send two requests concurrently to trigger the race condition.\n    tasks = [\n        client.post('/registrations', headers=headers, json=payload),\n        client.post('/registrations', headers=headers, json=payload)\n    ]\n    \n    results = await asyncio.gather(*tasks)\n    \n    # In the buggy system, both requests can succeed (return 201), creating duplicate records.\n    # The invariant is that no more than one registration record should exist.\n    status_codes = [r.status_code for r in results]\n    \n    # Verify that we don't have multiple successful registrations.\n    assert status_codes.count(201) == 1, f'Expected exactly one 201, got {status_codes}'\n    \n    # Verify final database state: only one record for this user/event pair.\n    r = await client.get('/registrations', headers=headers)\n    regs = [reg for reg in r.json() if reg['event_id'] == 1]\n    assert len(regs) == 1, f'Expected 1 registration in final list, got {len(regs)}'\n",
