      "patch": {
        "case_id": "issue-09",
        "diff": "--- a/app/routes/events.py\n+++ b/app/routes/events.py\n@@ -87,6 +87,8 @@\n     )\n     session.add(event)\n     session.commit()\n+    # Invalidate cache to ensure new event appears in list immediately\n+    request.app.state.cache.invalidate()\n     return event_payload(event)\n \n \n@@ -130,4 +132,4 @@\n         raise HTTPException(status_code=404, detail=\"event not found\")\n     payload = event_payload(event)\n     request.app.state.cache.set(key, payload)\n-    return payload+    return payload\n--- a/visible_tests/issue-09/test_event_cache_comprehensive.py\n+++ b/visible_tests/issue-09/test_event_cache_comprehensive.py\n@@ -0,0 +1,74 @@\n+\"\"\"Comprehensive tests for event cache invalidation.\"\"\"\n+from __future__ import annotations\n+\n+\n+async def test_multiple_events_appear_in_list(client, auth_headers, tokens):\n+    \"\"\"Test that multiple newly created events appear in the list immediately.\"\"\"\n+    # Get initial event count\n+    initial_response = await client.get(\"/events\")\n+    initial_count = initial_response.json()[\"total\"]\n+    \n+    # Create first event\n+    event1 = {\n+        \"title\": \"Test Event 1\",\n+        \"starts_at\": \"2026-09-01T18:00:00+00:00\",\n+        \"capacity\": 40,\n+        \"price\": \"25.00\",\n+        \"currency\": \"USD\",\n+    }\n+    create_response1 = await client.post(\"/events\", headers=auth_headers(tokens[\"alice\"]), json=event1)\n+    assert create_response1.status_code == 201\n+    event_id1 = create_response1.json()[\"id\"]\n+    \n+    # Verify first event appears in list\n+    list_response1 = await client.get(\"/events\")\n+    assert list_response1.status_code == 200\n+    assert list_response1.json()[\"total\"] == initial_count + 1\n+    assert event_id1 in [item[\"id\"] for item in list_response1.json()[\"items\"]]\n+    \n+    # Create second event\n+    event2 = {\n+        \"title\": \"Test Event 2\",\n+        \"starts_at\": \"2026-09-02T18:00:00+00:00\",\n+        \"capacity\": 50,\n+        \"price\": \"30.00\",\n+        \"currency\": \"USD\",\n+    }\n+    create_response2 = await client.post(\"/events\", headers=auth_headers(tokens[\"alice\"]), json=event2)\n+    assert create_response2.status_code == 201\n+    event_id2 = create_response2.json()[\"id\"]\n+    \n+    # Verify both events appear in list\n+    list_response2 = await client.get(\"/events\")\n+    assert list_response2.status_code == 200\n+    assert list_response2.json()[\"total\"] == initial_count + 2\n+    event_ids_in_list = [item[\"id\"] for item in list_response2.json()[\"items\"]]\n+    assert event_id1 in event_ids_in_list\n+    assert event_id2 in event_ids_in_list\n+\n+\n+async def test_event_list_with_pagination(client, auth_headers, tokens):\n+    \"\"\"Test that newly created events appear in paginated lists.\"\"\"\n+    # Create a new event\n+    new_event = {\n+        \"title\": \"Paginated Test Event\",\n+        \"starts_at\": \"2026-09-01T18:00:00+00:00\",\n+        \"capacity\": 40,\n+        \"price\": \"25.00\",\n+        \"currency\": \"USD\",\n+    }\n+    create_response = await client.post(\"/events\", headers=auth_headers(tokens[\"alice\"]), json=new_event)\n+    assert create_response.status_code == 201\n+    event_id = create_response.json()[\"id\"]\n+    \n+    # Verify event appears in list with default pagination\n+    list_response = await client.get(\"/events?limit=5&offset=0\")\n+    assert list_response.status_code == 200\n+    event_ids_in_list = [item[\"id\"] for item in list_response.json()[\"items\"]]\n+    assert event_id in event_ids_in_list\n+    \n+    # Verify event appears in list with different pagination\n+    list_response2 = await client.get(\"/events?limit=10&offset=0\")\n+    assert list_response2.status_code == 200\n+    event_ids_in_list2 = [item[\"id\"] for item in list_response2.json()[\"items\"]]\n+    assert event_id in event_ids_in_list2\n--- a/visible_tests/issue-09/test_event_cache_edge_cases.py\n+++ b/visible_tests/issue-09/test_event_cache_edge_cases.py\n@@ -0,0 +1,89 @@\n+\"\"\"Edge case tests for event cache invalidation.\"\"\"\n+from __future__ import annotations\n+\n+\n+async def test_event_cache_invalidation_consistency(client, auth_headers, tokens):\n+    \"\"\"Test that cache invalidation works consistently across multiple requests.\"\"\"\n+    # Create first event\n+    event1 = {\n+        \"title\": \"First Event\",\n+        \"starts_at\": \"2026-09-01T18:00:00+00:00\",\n+        \"capacity\": 40,\n+        \"price\": \"25.00\",\n+        \"currency\": \"USD\",\n+    }\n+    create_response1 = await client.post(\"/events\", headers=auth_headers(tokens[\"alice\"]), json=event1)\n+    assert create_response1.status_code == 201\n+    event_id1 = create_response1.json()[\"id\"]\n+    \n+    # Get event list multiple times to ensure cache is working\n+    for _ in range(3):\n+        list_response = await client.get(\"/events\")\n+        assert list_response.status_code == 200\n+        assert event_id1 in [item[\"id\"] for item in list_response.json()[\"items\"]]\n+    \n+    # Create second event\n+    event2 = {\n+        \"title\": \"Second Event\",\n+        \"starts_at\": \"2026-09-02T18:00:00+00:00\",\n+        \"capacity\": 50,\n+        \"price\": \"30.00\",\n+        \"currency\": \"USD\",\n+    }\n+    create_response2 = await client.post(\"/events\", headers=auth_headers(tokens[\"alice\"]), json=event2)\n+    assert create_response2.status_code == 201\n+    event_id2 = create_response2.json()[\"id\"]\n+    \n+    # Verify both events appear in list immediately after creation\n+    list_response = await client.get(\"/events\")\n+    assert list_response.status_code == 200\n+    event_ids_in_list = [item[\"id\"] for item in list_response.json()[\"items\"]]\n+    assert event_id1 in event_ids_in_list\n+    assert event_id2 in event_ids_in_list\n+    \n+    # Get event list multiple times to ensure cache is updated\n+    for _ in range(3):\n+        list_response = await client.get(\"/events\")\n+        assert list_response.status_code == 200\n+        event_ids_in_list = [item[\"id\"] for item in list_response.json()[\"items\"]]\n+        assert event_id1 in event_ids_in_list\n+        assert event_id2 in event_ids_in_list\n+\n+\n+async def test_event_cache_with_different_users(client, auth_headers, tokens):\n+    \"\"\"Test that events created by different users all appear in the list.\"\"\"\n+    # Get initial event count\n+    initial_response = await client.get(\"/events\")\n+    initial_count = initial_response.json()[\"total\"]\n+    \n+    # Create event with alice\n+    event1 = {\n+        \"title\": \"Alice's Event\",\n+        \"starts_at\": \"2026-09-01T18:00:00+00:00\",\n+        \"capacity\": 40,\n+        \"price\": \"25.00\",\n+        \"currency\": \"USD\",\n+    }\n+    create_response1 = await client.post(\"/events\", headers=auth_headers(tokens[\"alice\"]), json=event1)\n+    assert create_response1.status_code == 201\n+    event_id1 = create_response1.json()[\"id\"]\n+    \n+    # Create event with bob\n+    event2 = {\n+        \"title\": \"Bob's Event\",\n+        \"starts_at\": \"2026-09-02T18:00:00+00:00\",\n+        \"capacity\": 50,\n+        \"price\": \"30.00\",\n+        \"currency\": \"USD\",\n+    }\n+    create_response2 = await client.post(\"/events\", headers=auth_headers(tokens[\"bob\"]), json=event2)\n+    assert create_response2.status_code == 201\n+    event_id2 = create_response2.json()[\"id\"]\n+    \n+    # Verify both events appear in list\n+    list_response = await client.get(\"/events\")\n+    assert list_response.status_code == 200\n+    assert list_response.json()[\"total\"] == initial_count + 2\n+    event_ids_in_list = [item[\"id\"] for item in list_response.json()[\"items\"]]\n+    assert event_id1 in event_ids_in_list\n+    assert event_id2 in event_ids_in_list\n--- a/visible_tests/issue-09/test_event_list_cache.py\n+++ b/visible_tests/issue-09/