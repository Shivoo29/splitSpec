        "case_id": "issue-08",
        "summary": "A retry of a payment request with the same Idempotency-Key can create multiple payment records, violating the expected idempotent behavior.",
        "invariants": [
          "For any given Idempotency-Key, the system must create at most one payment record, regardless of how many times the same request is received.",
          "When a duplicate request with an already\u2011processed Idempotency-Key is received, the system must return the same result (e.g., payment identifier, status) as the original request without initiating a new charge."
        ],
        "inputs": [
          "A POST /payments (or equivalent) request containing a unique Idempotency-Key header and a payment payload.",
          "A second POST /payments request sent after the first request timed out, using the identical Idempotency-Key and identical payload."
        ],
        "expected_outputs": [
          "Exactly one payment record persisted in the database for the given Idempotency-Key.",
          "Only one external charge request sent to the bank/payment gateway for the given Idempotency-Key.",
          "The response to the second request matches the response of the first request (same payment ID, status, etc.) and indicates that the request was handled as a duplicate."
        ],
        "out_of_scope": [
          "Network latency or client\u2011side timeout handling beyond the receipt of the request.",
          "How the Idempotency-Key is generated or stored internally.",
          "Performance characteristics of the retry mechanism.",
          "Bank\u2011side duplicate detection beyond the scope of this service."
        ],
