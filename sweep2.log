      "patch": {
        "case_id": "issue-03",
        "diff": "--- a/app/routes/events.py\n+++ b/app/routes/events.py\n@@ -13,7 +13,7 @@\n from app.auth import get_current_user\n from app.db import get_session\n from app.models import Event, User\n-from app.timeutil import iso8601_utc\n+from app.timeutil import iso8601_utc, to_utc_naive\n \n router = APIRouter(prefix=\"/events\", tags=[\"events\"])\n \n@@ -78,7 +78,7 @@\n     event = Event(\n         title=payload.title,\n         description=payload.description,\n-        starts_at=payload.starts_at.replace(tzinfo=None),\n+        starts_at=to_utc_naive(payload.starts_at),\n         capacity=payload.capacity,\n         price=money.quantize(payload.price, payload.currency),\n         currency=payload.currency,\n@@ -131,4 +131,4 @@\n         raise HTTPException(status_code=404, detail=\"event not found\")\n     payload = event_payload(event)\n     request.app.state.cache.set(key, payload)\n-    return payload+    return payload\n--- a/test_api_timezone.py\n+++ b/test_api_timezone.py\n@@ -0,0 +1,70 @@\n+\"\"\"Test API timezone handling with non-UTC offsets.\"\"\"\n+import pytest\n+from httpx import AsyncClient\n+from datetime import datetime\n+\n+\n+@pytest.mark.asyncio\n+async def test_event_creation_with_timezone_offset(client, auth_headers, tokens):\n+    \"\"\"Test that an event created with a +02:00 offset is stored correctly.\"\"\"\n+    # Create event with +02:00 offset (10:00 AM in timezone with +02:00 offset)\n+    # This should be stored as 08:00:00 UTC\n+    r = await client.post(\n+        \"/events\",\n+        headers=auth_headers(tokens[\"alice\"]),\n+        json={\n+            \"title\": \"Meeting with timezone\",\n+            \"starts_at\": \"2023-09-15T10:00:00+02:00\",\n+            \"capacity\": 5,\n+            \"price\": \"10.00\",\n+        },\n+    )\n+    \n+    print(f\"Create response: {r.json()}\")\n+    assert r.status_code == 201\n+    \n+    # The response should show the UTC time (08:00:00)\n+    assert r.json()[\"starts_at\"] == \"2023-09-15T08:00:00+00:00\"\n+    \n+    event_id = r.json()[\"id\"]\n+    \n+    # Retrieve the event\n+    got = await client.get(f\"/events/{event_id}\")\n+    print(f\"Get response: {got.json()}\")\n+    assert got.status_code == 200\n+    \n+    # Should still be 08:00:00 UTC\n+    assert got.json()[\"starts_at\"] == \"2023-09-15T08:00:00+00:00\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_event_creation_with_negative_offset(client, auth_headers, tokens):\n+    \"\"\"Test that an event created with a -05:00 offset is stored correctly.\"\"\"\n+    # Create event with -05:00 offset (10:00 AM in timezone with -05:00 offset)\n+    # This should be stored as 15:00:00 UTC\n+    r = await client.post(\n+        \"/events\",\n+        headers=auth_headers(tokens[\"alice\"]),\n+        json={\n+            \"title\": \"Meeting with negative offset\",\n+            \"starts_at\": \"2023-09-15T10:00:00-05:00\",\n+            \"capacity\": 5,\n+            \"price\": \"10.00\",\n+        },\n+    )\n+    \n+    print(f\"Create response: {r.json()}\")\n+    assert r.status_code == 201\n+    \n+    # The response should show the UTC time (15:00:00)\n+    assert r.json()[\"starts_at\"] == \"2023-09-15T15:00:00+00:00\"\n+    \n+    event_id = r.json()[\"id\"]\n+    \n+    # Retrieve the event\n+    got = await client.get(f\"/events/{event_id}\")\n+    print(f\"Get response: {got.json()}\")\n+    assert got.status_code == 200\n+    \n+    # Should still be 15:00:00 UTC\n+    assert got.json()[\"starts_at\"] == \"2023-09-15T15:00:00+00:00\"\n--- a/test_comprehensive_timezone.py\n+++ b/test_comprehensive_timezone.py\n@@ -0,0 +1,48 @@\n+\"\"\"Comprehensive test for timezone handling.\"\"\"\n+import pytest\n+from httpx import AsyncClient\n+from datetime import datetime\n+\n+\n+@pytest.mark.asyncio\n+async def test_timezone_conversion_comprehensive(client, auth_headers, tokens):\n+    \"\"\"Test various timezone offsets are correctly converted to UTC.\"\"\"\n+    test_cases = [\n+        # (input_time, expected_utc_time, description)\n+        (\"2023-09-15T10:00:00+02:00\", \"2023-09-15T08:00:00+00:00\", \"Positive offset (+02:00)\"),\n+        (\"2023-09-15T10:00:00-05:00\", \"2023-09-15T15:00:00+00:00\", \"Negative offset (-05:00)\"),\n+        (\"2023-09-15T10:00:00Z\", \"2023-09-15T10:00:00+00:00\", \"UTC (Z suffix)\"),\n+        (\"2023-09-15T10:00:00+00:00\", \"2023-09-15T10:00:00+00:00\", \"UTC (+00:00)\"),\n+        (\"2023-09-15T10:00:00\", \"2023-09-15T10:00:00+00:00\", \"Naive (treated as UTC)\"),\n+        (\"2023-09-15T10:00:00+05:30\", \"2023-09-15T04:30:00+00:00\", \"Positive offset with minutes (+05:30)\"),\n+        (\"2023-09-15T10:00:00-08:00\", \"2023-09-15T18:00:00+00:00\", \"Negative offset (-08:00)\"),\n+    ]\n+    \n+    for input_time, expected_utc, description in test_cases:\n+        # Create event\n+        r = await client.post(\n+            \"/events\",\n+            headers=auth_headers(tokens[\"alice\"]),\n+            json={\n+                \"title\": f\"Test Event - {description}\",\n+                \"starts_at\": input_time,\n+                \"capacity\": 5,\n+                \"price\": \"10.00\",\n+            },\n+        )\n+        \n+        assert r.status_code == 201, f\"Failed to create event for {description}\"\n+        assert r.json()[\"starts_at\"] == expected_utc, f\"Create response mismatch for {description}: expected {expected_utc}, got {r.json()['starts_at']}\"\n+        \n+        event_id = r.json()[\"id\"]\n+        \n+        # Retrieve the event\n+        got = await client.get(f\"/events/{event_id}\")\n+        assert got.status_code == 200, f\"Failed to get event for {description}\"\n+        assert got.json()[\"starts_at\"] == expected_utc, f\"Get response mismatch for {description}: expected {expected_utc}, got {got.json()['starts_at']}\"\n+        \n+        print(f\"\u2713 {description}: {input_time} -> {expected_utc}\")\n+\n+\n+if __name__ == \"__main__\":\n+    pytest.main([__file__, \"-v\", \"-s\"])\n--- a/test_issue_example.py\n+++ b/test_issue_example.py\n@@ -0,0 +1,41 @@\n+\"\"\"Test the exact example from the issue description.\"\"\"\n+import pytest\n+from httpx import AsyncClient\n+\n+\n+@pytest.mark.asyncio\n+async def test_issue_example(client, auth_headers, tokens):\n+    \"\"\"Test the exact example from issue-03: 2023-09-15T10:00:00+02:00 should become 2023-09-15T08:00:00Z.\"\"\"\n+    # Create event with the exact input from the issue\n+    r = await client.post(\n+        \"/events\",\n+        headers=auth_headers(tokens[\"alice\"]),\n+        json={\n+            \"title\": \"Issue Example Event\",\n+            \"starts_at\": \"2023-09-15T10:00:00+02:00\",\n+            \"capacity\": 5,\n+            \"price\": \"10.00\",\n+        },\n+    )\n+    \n+    print(f\"Create response: {r.json()}\")\n+    assert r.status_code == 201\n+    \n+    # The stored UTC timestamp should equal the input timestamp converted to UTC\n+    # Input: 2023-09-15T10:00:00+02:00\n+    # Expected UTC: 2023-09-15T08:00:00Z (or 2023-09-15T08:00:00+00:00)\n+    assert r.json()[\"starts_at\"] == \"2023-09-15T08:00:00+00:00\"\n+    \n+    event_id = r.json()[\"id\"]\n+    \n+    # Retrieve the event - should return the same UTC timestamp\n+    got = await client.get(f\"/events/{event_id}\")\n+    print(f\"Get response: {got.json()}\")\n+    assert got.status_code == 200\n+    assert got.json()[\"starts_at\"] == \"2023-09-15T08:00:00+00:00\"\n+    \n+    print(\"\u2713 Issue example test passed!\")\n+\n+\n+if __name__ == \"__main__\":\n+    pytest.main([__file__, \"-v\", \"-s\"])\n--- a/test_timezone_issue.py\n+++ b/test_timezone_issue.py\n@@ -0,0 +1,35 @@\n+\"\"\"Test to reproduce the timezone conversion issue.\"\"\"\n+import pytest\n+from datetime import datetime\n+from app.timeutil import to_utc_naive, iso8601_utc\n+\n+\n+def test_timezone_conversion_issue():\n+    \"\"\"Test that a datetime with +02:00 offset is correctly converted to UTC.\"\"\"\n+    # Input: 2023-09-15T10:00:00+02:00 (which is 2023-09-15T08:00:00Z in UTC)\n+    dt_with_offset = datetime.fromisoformat(\"2023-09-15T10:00:00+02:00\")\n+    \n+    # Convert to UTC naive\n+    utc_naive = to_utc_naive(dt_with_offset)\n+    \n+    # Should be 2023-09-15T08:00:00 (UTC)\n+    expected = datetime.fromisoformat(\"2023-09-15T08:00:00+00:00\")\n+    \n+    print(f\"Input: {dt_with_offset}\")\n+    print(f\"Converted to UTC naive: {utc_naive}\")\n+    print(f\"Expected: {expected}\")\n+    \n+    assert utc_naive == expected.replace(tzinfo=None), f\"Expected {expected.replace(tzinfo=None)}, got {utc_naive}\"\n+\n+\n+def test_iso8601_utc_output():\n+    \"\"\"Test that iso8601_utc correctly formats a UTC naive datetime.\"\"\"\n+    utc_naive = datetime.fromisoformat(\"2023-09-15T08:00:00\")\n+    result = iso8601_utc(utc_naive)\n+    print(f\"ISO8601 output: {result}\")\n+    assert result == \"2023-09-15T08:00:00+00:00\"\n+\n+\n+if __name__ == \"__main__\":\n+    test_timezone_conversion_issue()\n+    test_iso8601_utc_output()\n",
        "files_changed": [
