unchanged):\")\n+print(f\"150.00 -> {money.quantize(Decimal('150.00'), 'USD')}\")\n+print(f\"0.00 -> {money.quantize(Decimal('0.00'), 'USD')}\")\n+print(f\"1200 (JPY) -> {money.quantize(Decimal('1200'), 'JPY')}\")\n+\n+print(\"\\nVerifying the invariants:\")\n+# Test that half-cents always round up\n+assert money.quantize(Decimal(\"1.005\"), \"USD\") == Decimal(\"1.01\"), \"1.005 should round to 1.01\"\n+assert money.quantize(Decimal(\"1.025\"), \"USD\") == Decimal(\"1.03\"), \"1.025 should round to 1.03\"\n+assert money.quantize(Decimal(\"1.045\"), \"USD\") == Decimal(\"1.05\"), \"1.045 should round to 1.05\"\n+\n+# Test that invoice total is never less than quoted amount\n+quoted = Decimal(\"1.025\")\n+invoice_total = money.quantize(quoted, \"USD\")\n+assert invoice_total >= quoted, f\"Invoice total {invoice_total} should not be less than quoted {quoted}\"\n+\n+print(\"All invariants verified!\")\n--- a/test_rounding_manual.py\n+++ b/test_rounding_manual.py\n@@ -0,0 +1,37 @@\n+\"\"\"Manual test to verify rounding behavior.\"\"\"\n+from decimal import Decimal\n+from app import money\n+\n+\n+def test_half_cent_rounding():\n+    \"\"\"Test that half-cents always round up.\"\"\"\n+    assert money.quantize(Decimal(\"1.005\"), \"USD\") == Decimal(\"1.01\")\n+    assert money.quantize(Decimal(\"1.025\"), \"USD\") == Decimal(\"1.03\")\n+    assert money.quantize(Decimal(\"1.045\"), \"USD\") == Decimal(\"1.05\")\n+    assert money.quantize(Decimal(\"2.675\"), \"USD\") == Decimal(\"2.68\")\n+\n+\n+def test_non_half_cent_rounding():\n+    \"\"\"Test that non-half-cents behave correctly.\"\"\"\n+    assert money.quantize(Decimal(\"1.004\"), \"USD\") == Decimal(\"1.00\")\n+    assert money.quantize(Decimal(\"1.006\"), \"USD\") == Decimal(\"1.01\")\n+    assert money.quantize(Decimal(\"1.00\"), \"USD\") == Decimal(\"1.00\")\n+    assert money.quantize(Decimal(\"2.34\"), \"USD\") == Decimal(\"2.34\")\n+\n+\n+def test_exact_cent_values():\n+    \"\"\"Test that exact cent values are unchanged.\"\"\"\n+    assert money.quantize(Decimal(\"150.00\"), \"USD\") == Decimal(\"150.00\")\n+    assert money.quantize(Decimal(\"0.00\"), \"USD\") == Decimal(\"0.00\")\n+    assert money.quantize(Decimal(\"1200\"), \"JPY\") == Decimal(\"1200\")\n+\n+\n+def test_invoice_total_never_less_than_quoted():\n+    \"\"\"Test that invoice total is never less than quoted amount.\"\"\"\n+    quoted = Decimal(\"1.025\")\n+    invoice_total = money.quantize(quoted, \"USD\")\n+    assert invoice_total >= quoted\n+    \n+    quoted = Decimal(\"1.005\")\n+    invoice_total = money.quantize(quoted, \"USD\")\n+    assert invoice_total >= quoted\n",
