        "diff": "--- a/app/routes/events.py\n+++ b/app/routes/events.py\n@@ -87,6 +87,8 @@\n     )\n     session.add(event)\n     session.commit()\n+    # Invalidate cache to ensure the new event appears in lists immediately\n+    request.app.state.cache.invalidate()\n     return event_payload(event)\n \n \n@@ -130,4 +132,4 @@\n         raise HTTPException(status_code=404, detail=\"event not found\")\n     payload = event_payload(event)\n     request.app.state.cache.set(key, payload)\n-    return payload+    return payload\n--- a/test_cache_issue.py\n+++ b/test_cache_issue.py\n@@ -0,0 +1,67 @@\n+\"\"\"Test to reproduce the cache issue with newly created events.\"\"\"\n+from __future__ import annotations\n+\n+import pytest\n+from fastapi.testclient import TestClient\n+\n+from app.main import create_app\n+from app.models import Event, User\n+from app.db import get_session\n+\n+\n+@pytest.fixture\n+def client():\n+    app = create_app(\":memory:\")\n+    return TestClient(app)\n+\n+\n+@pytest.fixture\n+def setup_data():\n+    \"\"\"Create a test user and return auth token.\"\"\"\n+    # This would normally be done through the API, but for simplicity\n+    # we'll use the test client setup from conftest\n+    pass\n+\n+\n+def test_newly_created_event_appears_in_list(client):\n+    \"\"\"Test that a newly created event appears in the list immediately.\"\"\"\n+    \n+    # First, get the initial list\n+    initial_response = client.get(\"/events\")\n+    assert initial_response.status_code == 200\n+    initial_count = len(initial_response.json()[\"items\"])\n+    \n+    # Create a new event\n+    new_event_data = {\n+        \"title\": \"Test Event\",\n+        \"starts_at\": \"2026-09-01T18:00:00+00:00\",\n+        \"capacity\": 40,\n+        \"price\": \"25.00\",\n+        \"currency\": \"USD\",\n+    }\n+    \n+    # Note: We need authentication to create an event\n+    # For now, let's just check if the issue can be reproduced\n+    \n+    # Get the list again - it should reflect any new events\n+    final_response = client.get(\"/events\")\n+    assert final_response.status_code == 200\n+    final_count = len(final_response.json()[\"items\"])\n+    \n+    # The count should be at least as much as before\n+    assert final_count >= initial_count\n+\n+\n+def test_cache_invalidation_on_create():\n+    \"\"\"Test that creating an event invalidates the cache.\"\"\"\n+    app = create_app(\":memory:\")\n+    \n+    # Get initial cache state\n+    initial_cache = app.state.cache\n+    \n+    # Simulate a cache hit scenario\n+    # The issue is that when an event is created, the cache should be invalidated\n+    # but currently it's not being invalidated in the create_event endpoint\n+    \n+    print(\"Cache version:\", initial_cache._version)\n+    print(\"Cache data:\", initial_cache._data)\n--- a/test_cache_reproduction.py\n+++ b/test_cache_reproduction.py\n@@ -0,0 +1,113 @@\n+\"\"\"Test to reproduce the cache issue with newly created events.\"\"\"\n+from __future__ import annotations\n+\n+import pytest\n+import httpx\n+\n+from app.main import create_app\n+from seed import ALICE_TOKEN, seed\n+\n+\n+@pytest.mark.asyncio\n+async def test_newly_created_event_appears_in_list():\n+    \"\"\"Test that a newly created event appears in the list immediately.\"\"\"\n+    \n+    # Create app with fresh database\n+    app = create_app(\"sqlite://\")\n+    with app.state.sessionmaker() as session:\n+        seed(session)\n+    \n+    transport = httpx.ASGITransport(app=app)\n+    async with httpx.AsyncClient(transport=transport, base_url=\"http://test\") as client:\n+        \n+        # First, get the initial list\n+        initial_response = await client.get(\"/events\")\n+        assert initial_response.status_code == 200\n+        initial_data = initial_response.json()\n+        initial_count = len(initial_data[\"items\"])\n+        initial_total = initial_data[\"total\"]\n+        \n+        print(f\"Initial count: {initial_count}, total: {initial_total}\")\n+        \n+        # Create a new event\n+        new_event_data = {\n+            \"title\": \"Test Event\",\n+            \"starts_at\": \"2026-09-01T18:00:00+00:00\",\n+            \"capacity\": 40,\n+            \"price\": \"25.00\",\n+            \"currency\": \"USD\",\n+        }\n+        \n+        auth_headers = {\"Authorization\": f\"Bearer {ALICE_TOKEN}\"}\n+        create_response = await client.post(\"/events\", headers=auth_headers, json=new_event_data)\n+        assert create_response.status_code == 201\n+        \n+        created_event = create_response.json()\n+        print(f\"Created event: {created_event['id']}\")\n+        \n+        # Get the list again - it should include the new event\n+        final_response = await client.get(\"/events\")\n+        assert final_response.status_code == 200\n+        final_data = final_response.json()\n+        final_count = len(final_data[\"items\"])\n+        final_total = final_data[\"total\"]\n+        \n+        print(f\"Final count: {final_count}, total: {final_total}\")\n+        \n+        # The count should be one more than before\n+        assert final_count == initial_count + 1, f\"Expected {initial_count + 1} items, got {final_count}\"\n+        assert final_total == initial_total + 1, f\"Expected total {initial_total + 1}, got {final_total}\"\n+        \n+        # The new event should be in the list\n+        event_ids = [item[\"id\"] for item in final_data[\"items\"]]\n+        assert created_event[\"id\"] in event_ids, f\"Created event {created_event['id']} not found in list\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_cache_invalidation_on_create():\n+    \"\"\"Test that creating an event invalidates the cache properly.\"\"\"\n+    \n+    app = create_app(\"sqlite://\")\n+    with app.state.sessionmaker() as session:\n+        seed(session)\n+    \n+    transport = httpx.ASGITransport(app=app)\n+    async with httpx.AsyncClient(transport=transport, base_url=\"http://test\") as client:\n+        \n+        auth_headers = {\"Authorization\": f\"Bearer {ALICE_TOKEN}\"}\n+        \n+        # Get the cache version before creating an event\n+        cache_before = app.state.cache\n+        version_before = cache_before._version\n+        data_before = cache_before._data.copy()\n+        \n+        print(f\"Cache version before: {version_before}\")\n+        print(f\"Cache data before: {list(data_before.keys())}\")\n+        \n+        # Create a new event\n+        new_event_data = {\n+            \"title\": \"Cache Test Event\",\n+            \"starts_at\": \"2026-09-01T18:00:00+00:00\",\n+            \"capacity\": 50,\n+            \"price\": \"30.00\",\n+            \"currency\": \"USD\",\n+        }\n+        \n+        create_response = await client.post(\"/events\", headers=auth_headers, json=new_event_data)\n+        assert create_response.status_code == 201\n+        \n+        # Check cache version after creating an event\n+        cache_after = app.state.cache\n+        version_after = cache_after._version\n+        data_after = cache_after._data.copy()\n+        \n+        print(f\"Cache version after: {version_after}\")\n+        print(f\"Cache data after: {list(data_after.keys())}\")\n+        \n+        # The cache should have been invalidated (version should increase)\n+        # If the version is the same, then the cache wasn't invalidated\n+        if version_before == version_after:\n+            print(\"WARNING: Cache was NOT invalidated after creating an event!\")\n+            print(\"This could cause newly created events to not appear in the list.\")\n+        else:\n+            print(\"Cache was properly invalidated.\")\n--- a/test_comprehensive_cache.py\n+++ b/test_comprehensive_cache.py\n@@ -0,0 +1,156 @@\n+\"\"\"Comprehensive test for cache invalidation.\"\"\"\n+from __future__ import annotations\n+\n+import pytest\n+import httpx\n+\n+from app.main import create_app\n+from seed import ALICE_TOKEN, seed\n+\n+\n+@pytest.mark.asyncio\n+async def test_multiple_events_cache_invalidation():\n+    \"\"\"Test that creating multiple events properly invalidates cache each time.\"\"\"\n+    \n+    app = create_app(\"sqlite://\")\n+    with app.state.sessionmaker() as session:\n+        seed(session)\n+    \n+    transport = httpx.ASGITransport(app=app)\n+    async with httpx.AsyncClient(transport=transport, base_url=\"http://test\") as client:\n+        \n+        auth_headers = {\"Authorization\": f\"Bearer {ALICE_TOKEN}\"}\n+        \n+        # Get initial list\n+        response = await client.get(\"/events\")\n+        assert response.status_code == 200\n+        initial_count = len(response.json()[\"items\"])\n+        \n+        # Create first event\n+        event1_data = {\n+            \"title\": \"Event 1\",\n+            \"starts_at\": \"2026-09-01T18:00:00+00:00\",\n+            \"capacity\": 40,\n+            \"price\": \"25.00\",\n+            \"currency\": \"USD\",\n+        }\n+        \n+        create_response1 = await client.post(\"/events\", headers=auth_headers, json=event1_data)\n+        assert create_response1.status_code == 201\n+        event1_id = create_response1.json()[\"id\"]\n+        \n+        # Verify it appears in list\n+        response = await client.get(\"/events\")\n+        assert response.status_code == 200\n+        assert len(response.json()[\"items\"]) == initial_count + 1\n+        assert event1_id in [item[\"id\"] for item in response.json()[\"items\"]]\n+        \n+        # Create second event\n+        event2_data = {\n+            \"title\": \"Event 2\",\n+            \"starts_at\": \"2026-09-02T18:00:00+00:00\",\n+            \"capacity\": 50,\n+            \"price\": \"30.00\",\n+            \"currency\": \"USD\",\n+        }\n+        \n+        create_response2 = await client.post(\"/events\", headers=auth_headers, json=event2_data)\n+        assert create_response2.status_code == 201\n+        event2_id = create_response2.json()[\"id\"]\n+        \n+        # Verify both events appear in list\n+        response = await client.get(\"/events\")\n+        assert response.status_code == 200\n+        data = response.json()\n+        assert len(data[\"items\"]) == initial_count + 2\n+        assert event1_id in [item[\"id\"] for item in data[\"items\"]]\n+        assert event2_id in [item[\"id\"] for item in data[\"items\"]]\n+        \n+        # Verify total count is correct\n+        assert data[\"total\"] == initial_count + 2\n+\n+\n+@pytest.mark.asyncio\n+async def test_pagination_with_cache_invalidation():\n+    \"\"\"Test that pagination works correctly with cache invalidation.\"\"\"\n+    \n+    app = create_app(\"sqlite://\")\n+    with app.state.sessionmaker() as session:\n+        seed(session)\n+    \n+    transport = httpx.ASGITransport(app=app)\n+    async with httpx.AsyncClient(transport=transport, base_url=\"http://test\") as client:\n+        \n+        auth_headers = {\"Authorization\": f\"Bearer {ALICE_TOKEN}\"}\n+        \n+        # Get first page\n+        response = await client.get(\"/events?limit=2&offset=0\")\n+        assert response.status_code == 200\n+        page1_before = response.json()\n+        \n+        # Create a new event\n+        new_event_data = {\n+            \"title\": \"New Event\",\n+            \"starts_at\": \"2026-09-01T18:00:00+00:00\",\n+            \"capacity\": 40,\n+            \"price\": \"25.00\",\n+            \"currency\": \"USD\",\n+        }\n+        \n+        create_response = await client.post(\"/events\", headers=auth_headers, json=new_event_data)\n+        assert create_response.status_code == 201\n+        \n+        # Get first page again - should reflect new total\n+        response = await client.get(\"/events?limit=2&offset=0\")\n+        assert response.status_code == 200\n+        page1_after = response.json()\n+        \n+        # Total should have increased\n+        assert page1_after[\"total\"] == page1_before[\"total\"] + 1\n+        \n+        # Get second page - should also reflect correct total\n+        response = await client.get(\"/events?limit=2&offset=2\")\n+        assert response.status_code == 200\n+        page2_after = response.json()\n+        \n+        # Total should be consistent across pages\n+        assert page2_after[\"total\"] == page1_after[\"total\"]\n+\n+\n+@pytest.mark.asyncio\n+async def test_individual_event_cache_not_affected():\n+    \"\"\"Test that individual event cache is not affected by list cache invalidation.\"\"\"\n+    \n+    app = create_app(\"sqlite://\")\n+    with app.state.sessionmaker() as session:\n+        seed(session)\n+    \n+    transport = httpx.ASGITransport(app=app)\n+    async with httpx.AsyncClient(transport=transport, base_url=\"http://test\") as client:\n+        \n+        auth_headers = {\"Authorization\": f\"Bearer {ALICE_TOKEN}\"}\n+        \n+        # Get an existing event\n+        response = await client.get(\"/events/1\")\n+        assert response.status_code == 200\n+        event_before = response.json()\n+        \n+        # Create a new event (this invalidates the list cache)\n+        new_event_data = {\n+            \"title\": \"Another Event\",\n+            \"starts_at\": \"2026-09-01T18:00:00+00:00\",\n+            \"capacity\": 40,\n+            \"price\": \"25.00\",\n+            \"currency\": \"USD\",\n+        }\n+        \n+        create_response = await client.post(\"/events\", headers=auth_headers, json=new_event_data)\n+        assert create_response.status_code == 201\n+        \n+        # Get the same event again - should still be cached or at least not affected\n+        response = await client.get(\"/events/1\")\n+        assert response.status_code == 200\n+        event_after = response.json()\n+        \n+        # The event data should be the same\n+        assert event_after == event_before\n--- a/test_final_verification.py\n+++ b/test_final_verification.py\n@@ -0,0 +1,104 @@\n+\"\"\"Final verification that the issue is resolved.\"\"\"\n+from __future__ import annotations\n+\n+import pytest\n+import httpx\n+\n+from app.main import create_app\n+from seed import ALICE_TOKEN, seed\n+\n+\n+@pytest.mark.asyncio\n+async def test_issue_09_resolved():\n+    \"\"\"\n+    Test that reproduces and verifies the fix for issue-09:\n+    \"Newly created events sometimes do not show up in the event list\"\n+    \n+    This test ensures that:\n+    1. A newly created event is immediately visible in the events list\n+    2. The cache is properly invalidated after event creation\n+    3. The event appears in both the items list and the total count\n+    \"\"\"\n+    \n+    app = create_app(\"sqlite://\")\n+    with app.state.sessionmaker() as session:\n+        seed(session)\n+    \n+    transport = httpx.ASGITransport(app=app)\n+    async with httpx.AsyncClient(transport=transport, base_url=\"http://test\") as client:\n+        \n+        auth_headers = {\"Authorization\": f\"Bearer {ALICE_TOKEN}\"}\n+        \n+        # Step 1: Get the initial event list\n+        initial_response = await client.get(\"/events\")\n+        assert initial_response.status_code == 200\n+        initial_data = initial_response.json()\n+        initial_item_count = len(initial_data[\"items\"])\n+        initial_total = initial_data[\"total\"]\n+        \n+        print(f\"Initial state: {initial_item_count} items, total: {initial_total}\")\n+        \n+        # Step 2: Create a new event\n+        new_event_data = {\n+            \"title\": \"Late Addition\",\n+            \"starts_at\": \"2026-09-01T18:00:00+00:00\",\n+            \"capacity\": 40,\n+            \"price\": \"25.00\",\n+            \"currency\": \"USD\",\n+        }\n+        \n+        create_response = await client.post(\"/events\", headers=auth_headers, json=new_event_data)\n+        assert create_response.status_code == 201, \"Event creation should succeed\"\n+        \n+        created_event = create_response.json()\n+        created_event_id = created_event[\"id\"]\n+        print(f\"Created event with ID: {created_event_id}\")\n+        \n+        # Step 3: Verify the event can be accessed directly by ID\n+        direct_response = await client.get(f\"/events/{created_event_id}\")\n+        assert direct_response.status_code == 200, \"Event should be accessible by ID\"\n+        assert direct_response.json()[\"id\"] == created_event_id\n+        print(f\"Event {created_event_id} is accessible directly\")\n+        \n+        # Step 4: Get the event list again - this is where the bug would manifest\n+        final_response = await client.get(\"/events\")\n+        assert final_response.status_code == 200\n+        final_data = final_response.json()\n+        final_item_count = len(final_data[\"items\"])\n+        final_total = final_data[\"total\"]\n+        \n+        print(f\"Final state: {final_item_count} items, total: {final_total}\")\n+        \n+        # Step 5: Verify the new event appears in the list\n+        # This is the core assertion that would fail before the fix\n+        assert final_item_count == initial_item_count + 1, \\\n+            f\"Expected {initial_item_count + 1} items after creation, got {final_item_count}\"\n+        \n+        assert final_total == initial_total + 1, \\\n+            f\"Expected total {initial_total + 1} after creation, got {final_total}\"\n+        \n+        # Step 6: Verify the specific event is in the list\n+        event_ids_in_list = [item[\"id\"] for item in final_data[\"items\"]]\n+        assert created_event_id in event_ids_in_list, \\\n+            f\"Created event {created_event_id} not found in the event list\"\n+        \n+        print(f\"SUCCESS: Event {created_event_id} is visible in the event list\")\n+        \n+        # Step 7: Verify cache was invalidated\n+        cache = app.state.cache\n+        # After creating an event, if we access the list again, it should not return stale data\n+        # The cache invalidation ensures this\n+        very_final_response = await client.get(\"/events\")\n+        assert very_final_response.status_code == 200\n+        very_final_data = very_final_response.json()\n+        \n+        assert len(very_final_data[\"items\"]) == final_item_count\n+        assert very_final_data[\"total\"] == final_total\n+        assert created_event_id in [item[\"id\"] for item in very_final_data[\"items\"]]\n+        \n+        print(\"SUCCESS: Cache invalidation is working correctly\")\n+\n+\n+if __name__ == \"__main__\":\n+    import asyncio\n+    asyncio.run(test_issue_09_resolved())\n",
