t registration requests don't create duplicate registrations.\"\"\"\n+    \n+    async def register_user():\n+        return await concurrent_client.post(\n+            \"/registrations\", \n+            headers={\"Authorization\": f\"Bearer {ALICE_TOKEN}\"},\n+            json={\"event_id\": 1}\n+        )\n+    \n+    # Alice is already registered for event 1 (registration id=1, status=confirmed)\n+    # Let's try to register her again concurrently\n+    \n+    # First, cancel her existing registration to test the race condition\n+    await concurrent_client.delete(\"/registrations/1\", headers={\"Authorization\": f\"Bearer {ALICE_TOKEN}\"})\n+    \n+    # Now try to register concurrently multiple times\n+    tasks = [register_user() for _ in range(10)]\n+    responses = await asyncio.gather(*tasks, return_exceptions=True)\n+    \n+    # Count successful registrations (status 201) and conflicts (status 409)\n+    success_count = sum(1 for r in responses if isinstance(r, httpx.Response) and r.status_code == 201)\n+    conflict_count = sum(1 for r in responses if isinstance(r, httpx.Response) and r.status_code == 409)\n+    other_count = sum(1 for r in responses if isinstance(r, httpx.Response) and r.status_code not in [201, 409])\n+    \n+    print(f\"Success: {success_count}, Conflicts: {conflict_count}, Others: {other_count}\")\n+    for i, r in enumerate(responses):\n+        if isinstance(r, httpx.Response):\n+            print(f\"Response {i}: {r.status_code}\")\n+        else:\n+            print(f\"Response {i}: Exception {r}\")\n+    \n+    # Verify in the database that only one registration exists\n+    from sqlalchemy import select\n+    from app.models import Registration\n+    \n+    with concurrent_client.app.state.sessionmaker() as session:\n+        registrations = session.scalars(\n+            select(Registration).where(\n+                Registration.user_id == 1,\n+                Registration.event_id == 1\n+            )\n+        ).all()\n+        \n+        print(f\"Total registrations for user 1, event 1: {len(registrations)}\")\n+        for reg in registrations:\n+            print(f\"Registration {reg.id}: status={reg.status}\")\n+        \n+        confirmed_count = sum(1 for r in registrations if r.status == \"confirmed\")\n+        print(f\"Confirmed registrations: {confirmed_count}\")\n+        \n+        # We should have exactly 1 confirmed registration\n+        assert confirmed_count == 1, f\"Expected 1 confirmed registration, got {confirmed_count}\"\n+\n+\n+if __name__ == \"__main__\":\n+    pytest.main([__file__, \"-v\", \"-s\"])\n",
