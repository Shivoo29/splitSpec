        "case_id": "issue-05",
        "diff": "--- a/app/routes/tickets.py\n+++ b/app/routes/tickets.py\n@@ -46,4 +46,7 @@\n     # but a revoked ticket is not readable.\n     if ticket.registration.status != \"confirmed\":\n         raise HTTPException(status_code=404, detail=\"ticket revoked by cancellation\")\n-    return ticket_payload(ticket)+    # Users may only read their own tickets\n+    if ticket.user_id != user.id:\n+        raise HTTPException(status_code=404, detail=\"ticket not found\")\n+    return ticket_payload(ticket)\n--- a/test_fix_verification.py\n+++ b/test_fix_verification.py\n@@ -0,0 +1,56 @@\n+\"\"\"Test to verify the cross-user access fix.\"\"\"\n+import pytest\n+from httpx import AsyncClient\n+\n+\n+@pytest.mark.asyncio\n+async def test_cross_user_access_prevented():\n+    \"\"\"Verify that users cannot access tickets belonging to other users.\"\"\"\n+    from conftest import client, auth_headers, tokens\n+    \n+    # Alice (user 1) tries to access Carol's ticket (ticket 4, user 3)\n+    c = client\n+    alice_headers = auth_headers(tokens[\"alice\"])\n+    \n+    response = await c.get(\"/tickets/4\", headers=alice_headers)\n+    \n+    # Should return 404 (not found) since Alice doesn't own this ticket\n+    assert response.status_code == 404, f\"Expected 404, got {response.status_code}\"\n+    \n+    # Response should not contain any ticket details\n+    data = response.json()\n+    assert \"code\" not in data, \"Ticket code should not be in response\"\n+    assert \"user_id\" not in data, \"User ID should not be in response\"\n+    assert \"event_id\" not in data, \"Event ID should not be in response\"\n+    \n+    print(\"\u2713 Cross-user access is properly prevented\")\n+\n+\n+@pytest.mark.asyncio\n+async def test_own_ticket_access_works():\n+    \"\"\"Verify that users can still access their own tickets.\"\"\"\n+    from conftest import client, auth_headers, tokens\n+    \n+    # Alice (user 1) accesses her own ticket (ticket 1)\n+    c = client\n+    alice_headers = auth_headers(tokens[\"alice\"])\n+    \n+    response = await c.get(\"/tickets/1\", headers=alice_headers)\n+    \n+    # Should return 200 with ticket details\n+    assert response.status_code == 200, f\"Expected 200, got {response.status_code}\"\n+    \n+    # Response should contain ticket details\n+    data = response.json()\n+    assert \"code\" in data, \"Ticket code should be in response\"\n+    assert data[\"code\"] == \"T0001-0001\", \"Ticket code should match\"\n+    assert data[\"user_id\"] == 1, \"User ID should match Alice\"\n+    \n+    print(\"\u2713 Own ticket access works correctly\")\n+\n+\n+if __name__ == \"__main__\":\n+    import asyncio\n+    asyncio.run(test_cross_user_access_prevented())\n+    asyncio.run(test_own_ticket_access_works())\n+    print(\"\\n\u2705 All verification tests passed!\")\n--- a/visible_tests/issue-05/test_comprehensive_cross_user.py\n+++ b/visible_tests/issue-05/test_comprehensive_cross_user.py\n@@ -0,0 +1,52 @@\n+\"\"\"Comprehensive tests for cross-user ticket access prevention.\"\"\"\n+from __future__ import annotations\n+\n+\n+async def test_alice_cannot_access_bobs_ticket(client, auth_headers, tokens):\n+    # Alice (user 1) tries to access Bob's ticket (ticket 2)\n+    # Ticket 2 has cancelled registration, so it should be 404 anyway\n+    r = await client.get(\"/tickets/2\", headers=auth_headers(tokens[\"alice\"]))\n+    assert r.status_code == 404\n+    # Make sure no ticket details are in the response\n+    assert \"code\" not in r.json()\n+\n+\n+async def test_alice_cannot_access_carols_ticket(client, auth_headers, tokens):\n+    # Alice (user 1) tries to access Carol's ticket (ticket 4)\n+    # Ticket 4 belongs to user 3 (Carol) and has confirmed registration\n+    r = await client.get(\"/tickets/4\", headers=auth_headers(tokens[\"alice\"]))\n+    assert r.status_code == 404\n+    # Make sure no ticket details are in the response\n+    assert \"code\" not in r.json()\n+\n+\n+async def test_bob_cannot_access_alices_ticket(client, auth_headers, tokens):\n+    # Bob (user 2) tries to access Alice's ticket (ticket 1)\n+    r = await client.get(\"/tickets/1\", headers=auth_headers(tokens[\"bob\"]))\n+    assert r.status_code == 404\n+    # Make sure no ticket details are in the response\n+    assert \"code\" not in r.json()\n+\n+\n+async def test_carol_cannot_access_alices_ticket(client, auth_headers, tokens):\n+    # Carol (user 3) tries to access Alice's ticket (ticket 3)\n+    r = await client.get(\"/tickets/3\", headers=auth_headers(tokens[\"carol\"]))\n+    assert r.status_code == 404\n+    # Make sure no ticket details are in the response\n+    assert \"code\" not in r.json()\n+\n+\n+async def test_user_can_access_own_ticket(client, auth_headers, tokens):\n+    # Alice can access her own ticket (ticket 1)\n+    r = await client.get(\"/tickets/1\", headers=auth_headers(tokens[\"alice\"]))\n+    assert r.status_code == 200\n+    assert r.json()[\"code\"] == \"T0001-0001\"\n+    assert r.json()[\"user_id\"] == 1\n+\n+\n+async def test_user_can_access_own_other_ticket(client, auth_headers, tokens):\n+    # Alice can access her other ticket (ticket 3)\n+    r = await client.get(\"/tickets/3\", headers=auth_headers(tokens[\"alice\"]))\n+    assert r.status_code == 200\n+    assert r.json()[\"code\"] == \"T0003-0001\"\n+    assert r.json()[\"user_id\"] == 1\n--- a/visible_tests/issue-05/test_cross_user_access.py\n+++ b/visible_tests/issue-05/test_cross_user_access.py\n@@ -0,0 +1,15 @@\n+\"\"\"Visible: a user cannot read another user's ticket.\"\"\"\n+from __future__ import annotations\n+\n+\n+async def test_user_cannot_read_another_users_ticket(client, auth_headers, tokens):\n+    # Alice (user 1) tries to access Bob's ticket (ticket 2)\n+    # Ticket 2 belongs to user 2 (Bob) but has cancelled registration, so it should be 404\n+    # Let's try with a valid ticket that belongs to someone else\n+    # Ticket 4 belongs to user 3 (Carol)\n+    r = await client.get(\"/tickets/4\", headers=auth_headers(tokens[\"alice\"]))\n+    # Should return 403 or 404, not 200 with ticket details\n+    assert r.status_code in [403, 404], f\"Expected 403 or 404, got {r.status_code}\"\n+    # Response should not contain ticket details\n+    if r.status_code == 200:\n+        assert False, \"Should not return ticket details for another user's ticket\"\n",
