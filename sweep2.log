        "diff": "--- a/app/routes/payments.py\n+++ b/app/routes/payments.py\n@@ -63,6 +63,17 @@\n     if currency != event.currency:\n         raise HTTPException(status_code=400, detail=\"charge currency must match the event currency\")\n \n+    # Check for existing payment with the same idempotency key BEFORE creating a new one\n+    existing = session.scalar(select(Payment).where(Payment.idempotency_key == idempotency_key))\n+    if existing is not None:\n+        if existing.user_id != user.id:\n+            raise HTTPException(\n+                status_code=409, detail=\"idempotency key belongs to another user\"\n+            )\n+        # Return the existing payment without creating a new one\n+        response.status_code = 200\n+        return payment_payload(existing)\n+\n     payment = Payment(\n         user_id=user.id,\n         event_id=event.id,\n@@ -77,6 +88,7 @@\n         session.commit()\n     except IntegrityError:\n         session.rollback()\n+        # This should not happen since we checked above, but handle it just in case\n         existing = session.scalar(select(Payment).where(Payment.idempotency_key == idempotency_key))\n         if existing is not None:\n             if existing.user_id != user.id:\n@@ -87,10 +99,5 @@\n             return payment_payload(existing)\n         raise HTTPException(status_code=409, detail=\"idempotency key already in use\") from None\n \n-    existing = session.scalar(select(Payment).where(Payment.idempotency_key == idempotency_key))\n-    if existing is not None and existing.id != payment.id:\n-        # Another payment with the same key exists - but we already created ours!\n-        pass  # Don't raise, just return the new payment (wrong behavior)\n-\n     response.status_code = 201\n-    return payment_payload(payment)+    return payment_payload(payment)\n--- a/test_race_condition.py\n+++ b/test_race_condition.py\n@@ -0,0 +1,60 @@\n+\"\"\"Test to demonstrate the race condition in idempotency key handling.\"\"\"\n+import asyncio\n+from httpx import AsyncClient\n+\n+\n+async def test_concurrent_requests():\n+    \"\"\"Test that concurrent requests with the same idempotency key don't create duplicate payments.\"\"\"\n+    from seed import seed_db\n+    from app.main import app\n+    from app.db import get_session\n+    from app.models import Payment\n+    from sqlalchemy import select\n+    \n+    # Seed the database\n+    await seed_db()\n+    \n+    # Get auth token for alice\n+    from conftest import auth_headers\n+    from seed import tokens\n+    \n+    async with AsyncClient(app=app, base_url=\"http://test\") as client:\n+        headers = {\n+            **auth_headers(tokens[\"alice\"]), \n+            \"Idempotency-Key\": \"race-test-key\"\n+        }\n+        \n+        # Send two concurrent requests\n+        task1 = client.post(\"/payments\", headers=headers, json={\"event_id\": 1})\n+        task2 = client.post(\"/payments\", headers=headers, json={\"event_id\": 1})\n+        \n+        responses = await asyncio.gather(task1, task2)\n+        \n+        print(f\"Response 1 status: {responses[0].status_code}\")\n+        print(f\"Response 2 status: {responses[1].status_code}\")\n+        \n+        body1 = responses[0].json()\n+        body2 = responses[1].json()\n+        \n+        print(f\"Response 1 payment_id: {body1.get('id')}\")\n+        print(f\"Response 2 payment_id: {body2.get('id')}\")\n+        \n+        # Check if they created the same payment or different ones\n+        if body1.get('id') != body2.get('id'):\n+            print(\"ERROR: Different payment IDs created!\")\n+            print(f\"  Payment 1: {body1}\")\n+            print(f\"  Payment 2: {body2}\")\n+            return False\n+        else:\n+            print(f\"SUCCESS: Same payment ID returned: {body1.get('id')}\")\n+            return True\n+\n+\n+if __name__ == \"__main__\":\n+    result = asyncio.run(test_concurrent_requests())\n+    if not result:\n+        print(\"\\nRace condition detected!\")\n+        exit(1)\n+    else:\n+        print(\"\\nNo race condition detected.\")\n+        exit(0)\n--- a/visible_tests/issue-08/test_idempotency_security.py\n+++ b/visible_tests/issue-08/test_idempotency_security.py\n@@ -0,0 +1,27 @@\n+\"\"\"Test idempotency key security.\"\"\"\n+import pytest\n+\n+\n+@pytest.mark.asyncio\n+async def test_different_user_same_key(client, auth_headers, tokens):\n+    \"\"\"Test that a different user cannot use the same idempotency key.\"\"\"\n+    headers_alice = {\n+        **auth_headers(tokens[\"alice\"]), \n+        \"Idempotency-Key\": \"shared-key-test\"\n+    }\n+    \n+    # Alice creates a payment\n+    response1 = await client.post(\"/payments\", headers=headers_alice, json={\"event_id\": 1})\n+    assert response1.status_code == 201\n+    body1 = response1.json()\n+    \n+    # Bob tries to use the same key\n+    headers_bob = {\n+        **auth_headers(tokens[\"bob\"]), \n+        \"Idempotency-Key\": \"shared-key-test\"\n+    }\n+    response2 = await client.post(\"/payments\", headers=headers_bob, json={\"event_id\": 1})\n+    \n+    # Bob should get a 409 error\n+    assert response2.status_code == 409\n+    assert \"idempotency key belongs to another user\" in response2.text\n--- a/visible_tests/issue-08/test_race_condition.py\n+++ b/visible_tests/issue-08/test_race_condition.py\n@@ -0,0 +1,34 @@\n+\"\"\"Test to demonstrate the race condition in idempotency key handling.\"\"\"\n+import pytest\n+\n+\n+@pytest.mark.asyncio\n+async def test_sequential_requests_same_key(client, auth_headers, tokens):\n+    \"\"\"Test that sequential requests with the same idempotency key don't create duplicate payments.\"\"\"\n+    headers = {\n+        **auth_headers(tokens[\"alice\"]), \n+        \"Idempotency-Key\": \"seq-test-key-unique\"\n+    }\n+    \n+    # Send first request\n+    response1 = await client.post(\"/payments\", headers=headers, json={\"event_id\": 1})\n+    print(f\"Response 1 status: {response1.status_code}\")\n+    body1 = response1.json()\n+    print(f\"Response 1 payment_id: {body1.get('id')}\")\n+    \n+    # Send second request with same key\n+    response2 = await client.post(\"/payments\", headers=headers, json={\"event_id\": 1})\n+    print(f\"Response 2 status: {response2.status_code}\")\n+    body2 = response2.json()\n+    print(f\"Response 2 payment_id: {body2.get('id')}\")\n+    \n+    # Check if they created the same payment or different ones\n+    assert body1.get('id') == body2.get('id'), \\\n+        f\"Different payment IDs created! Payment 1: {body1.get('id')}, Payment 2: {body2.get('id')}\"\n+    \n+    # Both should have the same data\n+    assert body1[\"amount\"] == body2[\"amount\"]\n+    assert body1[\"currency\"] == body2[\"currency\"]\n+    assert body1[\"status\"] == body2[\"status\"]\n+    assert body1[\"user_id\"] == body2[\"user_id\"]\n+    assert body1[\"event_id\"] == body2[\"event_id\"]\n",
