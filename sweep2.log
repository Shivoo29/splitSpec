        "case_id": "issue-06",
        "summary": "Cancellation of a registration must be allowed only for the owning user; attempts by non\u2011owners must be rejected and leave the registration unchanged.",
        "invariants": [
          "A cancel request for a registration succeeds only when the authenticated user is the owner of that registration.",
          "When the authenticated user is not the owner, the cancel request must be rejected and the registration's data must remain unchanged."
        ],
        "inputs": [
          "Authenticated user ID + registration ID belonging to that user (valid ownership).",
          "Authenticated user ID + registration ID belonging to a different user (invalid ownership)."
        ],
