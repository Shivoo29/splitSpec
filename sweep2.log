        "contents": "import pytest\nfrom httpx import AsyncClient\n\n@pytest.mark.asyncio\nasync def test_timezone_conversion_offset(client, auth_headers, tokens):\n    \"\"\"\n    Invariant: When an event creation request includes a start_time that carries a non-zero timezone offset,\n    the system must store the start_time as the exact same instant converted to UTC.\n    Input: \"2023-09-15T10:00:00+02:00\" (UTC should be 08:00:00)\n    \"\"\"\n    payload = {\n        \"title\": \"Timezone Test Event\",\n        \"starts_at\": \"2023-09-15T10:00:00+02:00\",\n        \"capacity\": 10,\n        \"price\": \"5.00\"\n    }\n    \n    # Create the event\n    r = await client.post(\n        \"/events\",\n        headers=auth_headers(tokens[\"alice\"]),\n        json=payload\n    )\n    assert r.status_code == 201\n    \n    event_id = r.json()[\"id\"]\n    \n    # Retrieve the event\n    got = await client.get(f\"/events/{event_id}\")\n    assert got.status_code == 200\n    \n    # The stored time should be 08:00:00+00:00\n    # The issue states there is a 2-hour shift, so instead of 08:00:00,\n    # the faulty code returns 10:00:00+00:00.\n    assert got.json()[\"starts_at\"] == \"2023-09-15T08:00:00+00:00\"\n",
