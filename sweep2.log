=0 on the same database\n+    # Expected: Response includes \"total\": 6, returns exactly 6 event objects\n+    r2 = await client.get(\"/events?limit=100&offset=0\")\n+    assert r2.status_code == 200\n+    body2 = r2.json()\n+    \n+    # The key invariant: total should be the same regardless of pagination\n+    assert body1['total'] == body2['total'], \\\n+        f\"Total should be consistent: {body1['total']} != {body2['total']}\"\n+    \n+    # Total should equal the actual count when fetching all events\n+    assert body2['total'] == len(body2['items']), \\\n+        f\"Total should equal all items: {body2['total']} != {len(body2['items'])}\"\n+    \n+    # First request should return at most the requested limit\n+    assert len(body1['items']) <= 2, \\\n+        f\"First page should have <= 2 items, got {len(body1['items'])}\"\n+    \n+    # The \"total\" field should be >= the number of event objects returned\n+    assert body1['total'] >= len(body1['items']), \\\n+        f\"Total should be >= items on page\"\n+    \n+    print(f\"\u2713 Issue-12 fixed: total={body1['total']} is consistent across pagination\")\n+    print(f\"\u2713 First page: limit=2, items={len(body1['items'])}, total={body1['total']}\")\n+    print(f\"\u2713 All events: limit=100, items={len(body2['items'])}, total={body2['total']}\")\n--- a/test_pagination_comprehensive.py\n+++ b/test_pagination_comprehensive.py\n@@ -0,0 +1,74 @@\n+\"\"\"Comprehensive tests for pagination total fix.\"\"\"\n+import pytest\n+from httpx import AsyncClient\n+\n+\n+@pytest.mark.anyio\n+async def test_pagination_total_with_different_offsets(client: AsyncClient):\n+    \"\"\"Test that total is consistent across different pagination parameters.\"\"\"\n+    # Test various limit and offset combinations\n+    test_cases = [\n+        (2, 0),  # First page, 2 items\n+        (2, 2),  # Second page, 2 items\n+        (1, 0),  # First page, 1 item\n+        (1, 1),  # Second page, 1 item\n+        (1, 2),  # Third page, 1 item\n+        (10, 0), # Large limit\n+        (100, 0), # Very large limit\n+    ]\n+    \n+    totals = []\n+    for limit, offset in test_cases:\n+        r = await client.get(f\"/events?limit={limit}&offset={offset}\")\n+        assert r.status_code == 200\n+        body = r.json()\n+        totals.append(body['total'])\n+        print(f\"limit={limit}, offset={offset}: total={body['total']}, items={len(body['items'])}\")\n+        \n+        # Verify items count is correct for the page\n+        assert len(body['items']) <= limit, f\"Items count {len(body['items'])} exceeds limit {limit}\"\n+        assert body['total'] >= len(body['items']), f\"Total {body['total']} < items {len(body['items'])}\"\n+    \n+    # All totals should be the same\n+    assert all(t == totals[0] for t in totals), f\"Totals are not consistent: {totals}\"\n+\n+\n+@pytest.mark.anyio\n+async def test_pagination_total_matches_full_result(client: AsyncClient):\n+    \"\"\"Test that total matches the count when fetching all events.\"\"\"\n+    # Get all events\n+    r = await client.get(\"/events?limit=100\")\n+    assert r.status_code == 200\n+    body = r.json()\n+    \n+    # Total should equal the number of items when we fetch all\n+    assert body['total'] == len(body['items']), f\"Total {body['total']} != items count {len(body['items'])}\"\n+    \n+    # Verify with default limit too\n+    r2 = await client.get(\"/events\")\n+    assert r2.status_code == 200\n+    body2 = r2.json()\n+    \n+    assert body2['total'] == body['total'], f\"Total mismatch: {body2['total']} != {body['total']}\"\n+\n+\n+@pytest.mark.anyio\n+async def test_pagination_boundary_conditions(client: AsyncClient):\n+    \"\"\"Test edge cases in pagination.\"\"\"\n+    # Get total count\n+    r = await client.get(\"/events?limit=100\")\n+    total = r.json()['total']\n+    \n+    # Test offset beyond total (should return empty items but correct total)\n+    r = await client.get(f\"/events?limit=10&offset={total + 10}\")\n+    assert r.status_code == 200\n+    body = r.json()\n+    assert body['total'] == total, f\"Total changed with large offset: {body['total']} != {total}\"\n+    assert len(body['items']) == 0, f\"Should have no items with large offset, got {len(body['items'])}\"\n+    \n+    # Test offset at total (should return empty items but correct total)\n+    r = await client.get(f\"/events?limit=10&offset={total}\")\n+    assert r.status_code == 200\n+    body = r.json()\n+    assert body['total'] == total, f\"Total changed with offset=total: {body['total']} != {total}\"\n+    assert len(body['items']) == 0, f\"Should have no items with offset=total, got {len(body['items'])}\"\n--- a/test_pagination_total.py\n+++ b/test_pagination_total.py\n@@ -0,0 +1,32 @@\n+\"\"\"Test to verify the pagination total issue.\"\"\"\n+import pytest\n+from httpx import AsyncClient\n+\n+\n+@pytest.mark.anyio\n+async def test_pagination_total_issue(client: AsyncClient):\n+    \"\"\"Test that total reflects all events, not just the current page.\"\"\"\n+    # Get first page with limit=2\n+    r1 = await client.get(\"/events?limit=2&offset=0\")\n+    assert r1.status_code == 200\n+    body1 = r1.json()\n+    \n+    # Get all events with large limit\n+    r2 = await client.get(\"/events?limit=100&offset=0\")\n+    assert r2.status_code == 200\n+    body2 = r2.json()\n+    \n+    print(f\"First page (limit=2): total={body1['total']}, items={len(body1['items'])}\")\n+    print(f\"All events (limit=100): total={body2['total']}, items={len(body2['items'])}\")\n+    \n+    # The total should be the same regardless of pagination\n+    assert body1['total'] == body2['total'], f\"Total mismatch: {body1['total']} != {body2['total']}\"\n+    \n+    # The total should equal the actual number of events in the database\n+    assert body2['total'] == len(body2['items']), f\"Total should equal all items: {body2['total']} != {len(body2['items'])}\"\n+    \n+    # First page should have at most 2 items