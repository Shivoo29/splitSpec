        "case_id": "issue-06",
        "diff": "--- a/app/routes/registrations.py\n+++ b/app/routes/registrations.py\n@@ -151,9 +151,11 @@\n     reg = session.get(Registration, registration_id)\n     if reg is None:\n         raise HTTPException(status_code=404, detail=\"registration not found\")\n+    if reg.user_id != user.id:\n+        raise HTTPException(status_code=403, detail=\"not authorized to cancel this registration\")\n     if reg.status == \"cancelled\":\n         raise HTTPException(status_code=400, detail=\"registration already cancelled\")\n     reg.status = \"cancelled\"\n     session.commit()\n     request.app.state.cache.invalidate()\n-    return registration_payload(reg)+    return registration_payload(reg)\n--- a/visible_tests/issue-06/test_ownership.py\n+++ b/visible_tests/issue-06/test_ownership.py\n@@ -0,0 +1,17 @@\n+\"\"\"Visible: test that cancellation requires ownership.\"\"\"\n+from __future__ import annotations\n+\n+\n+async def test_cancel_others_registration_is_rejected(client, auth_headers, tokens):\n+    # Alice (user_id=1) tries to cancel Carol's registration (registration_id=4, user_id=3)\n+    r = await client.delete(\"/registrations/4\", headers=auth_headers(tokens[\"alice\"]))\n+    assert r.status_code == 403\n+    \n+    # Verify the registration is still confirmed (not cancelled)\n+    r = await client.get(\"/registrations\", headers=auth_headers(tokens[\"carol\"]))\n+    assert r.status_code == 200\n+    registrations = r.json()\n+    # Find registration with id=4\n+    reg4 = next((reg for reg in registrations if reg[\"id\"] == 4), None)\n+    assert reg4 is not None\n+    assert reg4[\"status\"] == \"confirmed\"\n--- a/visible_tests/issue-06/test_ownership_edge_cases.py\n+++ b/visible_tests/issue-06/test_ownership_edge_cases.py\n@@ -0,0 +1,54 @@\n+\"\"\"Visible: additional edge case tests for ownership check.\"\"\"\n+from __future__ import annotations\n+\n+\n+async def test_cancel_own_registration_still_works(client, auth_headers, tokens):\n+    # Alice cancels her own registration (id=1)\n+    r = await client.delete(\"/registrations/1\", headers=auth_headers(tokens[\"alice\"]))\n+    assert r.status_code == 200\n+    assert r.json()[\"status\"] == \"cancelled\"\n+    \n+    # Verify it's actually cancelled\n+    r = await client.get(\"/registrations\", headers=auth_headers(tokens[\"alice\"]))\n+    assert r.status_code == 200\n+    registrations = r.json()\n+    reg1 = next((reg for reg in registrations if reg[\"id\"] == 1), None)\n+    assert reg1 is not None\n+    assert reg1[\"status\"] == \"cancelled\"\n+\n+\n+async def test_cancel_cancelled_registration_ownership_check(client, auth_headers, tokens):\n+    # Bob's registration (id=2) is already cancelled in the seed data\n+    # Alice tries to cancel it (should fail on ownership, not on already-cancelled)\n+    r = await client.delete(\"/registrations/2\", headers=auth_headers(tokens[\"alice\"]))\n+    assert r.status_code == 403\n+    \n+    # Bob tries to cancel his own already-cancelled registration (should fail on already-cancelled)\n+    r = await client.delete(\"/registrations/2\", headers=auth_headers(tokens[\"bob\"]))\n+    assert r.status_code == 400\n+    assert \"already cancelled\" in r.json()[\"detail\"]\n+\n+\n+async def test_multiple_users_cannot_cancel_each_others_registrations(client, auth_headers, tokens):\n+    # Alice tries to cancel Carol's registration\n+    r = await client.delete(\"/registrations/4\", headers=auth_headers(tokens[\"alice\"]))\n+    assert r.status_code == 403\n+    \n+    # Bob tries to cancel Alice's registration\n+    r = await client.delete(\"/registrations/1\", headers=auth_headers(tokens[\"bob\"]))\n+    assert r.status_code == 403\n+    \n+    # Dana tries to cancel Carol's registration\n+    r = await client.delete(\"/registrations/4\", headers=auth_headers(tokens[\"dana\"]))\n+    assert r.status_code == 403\n+    \n+    # Verify all registrations are still in their original state\n+    r = await client.get(\"/registrations\", headers=auth_headers(tokens[\"alice\"]))\n+    alice_regs = r.json()\n+    reg1 = next((reg for reg in alice_regs if reg[\"id\"] == 1), None)\n+    assert reg1[\"status\"] == \"confirmed\"\n+    \n+    r = await client.get(\"/registrations\", headers=auth_headers(tokens[\"carol\"]))\n+    carol_regs = r.json()\n+    reg4 = next((reg for reg in carol_regs if reg[\"id\"] == 4), None)\n+    assert reg4[\"status\"] == \"confirmed\"\n",
        "files_changed": [
