 \"currency\": \"USD\",\n+    }\n+    r = await client.post(\"/events\", headers=auth_headers(tokens[\"alice\"]), json=payload_whitespace_title)\n+    assert r.status_code == 422, f\"Expected 422, got {r.status_code}\"\n+    \n+    # Test 3: Negative price should be rejected\n+    payload_negative_price = {\n+        \"title\": \"Test Event\",\n+        \"starts_at\": \"2026-06-01T09:00:00Z\",\n+        \"capacity\": 10,\n+        \"price\": \"-5.00\",\n+        \"currency\": \"USD\",\n+    }\n+    r = await client.post(\"/events\", headers=auth_headers(tokens[\"alice\"]), json=payload_negative_price)\n+    assert r.status_code == 422, f\"Expected 422, got {r.status_code}\"\n+    \n+    # Test 4: Valid event should still work\n+    payload_valid = {\n+        \"title\": \"Valid Event\",\n+        \"starts_at\": \"2026-06-01T09:00:00Z\",\n+        \"capacity\": 10,\n+        \"price\": \"25.00\",\n+        \"currency\": \"USD\",\n+    }\n+    r = await client.post(\"/events\", headers=auth_headers(tokens[\"alice\"]), json=payload_valid)\n+    assert r.status_code == 201, f\"Expected 201, got {r.status_code}\"\n+    \n+    # Verify the valid event was created\n+    listing = (await client.get(\"/events\")).json()\n+    titles = [e[\"title\"] for e in listing[\"items\"]]\n+    assert \"Valid Event\" in titles\n+    \n+    # Verify invalid events were NOT created\n+    assert \"\" not in titles\n+    assert \"   \" not in titles\n+    assert \"Test Event\" not in titles\n+\n+\n+if __name__ == \"__main__\":\n+    pytest.main([__file__, \"-v\"])\n--- a/test_validation.py\n+++ b/test_validation.py\n@@ -0,0 +1,49 @@\n+\"\"\"Test validation for empty title and negative price.\"\"\"\n+import pytest\n+from httpx import AsyncClient\n+\n+\n+async def test_empty_title_validation(client: AsyncClient, auth_headers, tokens):\n+    \"\"\"Test that empty title is rejected.\"\"\"\n+    payload = {\n+        \"title\": \"\",\n+        \"starts_at\": \"2026-06-01T09:00:00Z\",\n+        \