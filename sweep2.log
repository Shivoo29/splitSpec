        "case_id": "issue-11",
        "diff": "--- a/app/routes/registrations.py\n+++ b/app/routes/registrations.py\n@@ -64,12 +64,12 @@\n         raise HTTPException(status_code=404, detail=\"event not found\")\n     # One row per (user, event) for the lifetime of the pair: the DB unique constraint\n     # says so. A cancelled row is therefore reactivated, never duplicated.\n-    existing = session.scalar(\n+    existing = session.scalars(\n         select(Registration).where(\n             Registration.user_id == user.id,\n             Registration.event_id == event.id,\n-        )\n-    )\n+        ).options(selectinload(Registration.ticket))\n+    ).first()\n     if existing is not None and existing.status == \"confirmed\":\n         raise HTTPException(status_code=409, detail=\"already registered for this event\")\n     confirmed = session.scalar(\n@@ -158,4 +158,4 @@\n     reg.status = \"cancelled\"\n     session.commit()\n     request.app.state.cache.invalidate()\n-    return registration_payload(reg)+    return registration_payload(reg)\n--- a/visible_tests/issue-11/test_concurrent_registration.py\n+++ b/visible_tests/issue-11/test_concurrent_registration.py\n@@ -0,0 +1,56 @@\n+\"\"\"Test concurrent registration scenarios to ensure registrations don't disappear.\"\"\"\n+from __future__ import annotations\n+\n+\n+async def test_concurrent_registration_attempts(client, auth_headers, tokens):\n+    \"\"\"Test that concurrent registration attempts don't cause registrations to disappear.\"\"\"\n+    # Use Dana's token (user 4) who has no existing registrations\n+    headers = auth_headers(tokens[\"dana\"])\n+    \n+    # First registration should succeed\n+    response1 = await client.post(\"/registrations\", json={\"event_id\": 2}, headers=headers)\n+    assert response1.status_code == 201\n+    registration_id = response1.json()[\"id\"]\n+    \n+    # Verify the registration appears in the list\n+    registrations = await client.get(\"/registrations\", headers=headers)\n+    assert registrations.status_code == 200\n+    registration_ids = [x[\"id\"] for x in registrations.json()]\n+    assert registration_id in registration_ids\n+    \n+    # Try to register for the same event again (should fail with 409)\n+    response2 = await client.post(\"/registrations\", json={\"event_id\": 2}, headers=headers)\n+    assert response2.status_code == 409\n+    \n+    # Verify the registration still appears in the list\n+    registrations = await client.get(\"/registrations\", headers=headers)\n+    assert registrations.status_code == 200\n+    registration_ids = [x[\"id\"] for x in registrations.json()]\n+    assert registration_id in registration_ids\n+    \n+    # Verify the registration has the correct data\n+    reg = next(x for x in registrations.json() if x[\"id\"] == registration_id)\n+    assert reg[\"status\"] == \"confirmed\"\n+    assert reg[\"ticket\"] is not None\n+\n+\n+async def test_registration_with_ticket_consistency(client, auth_headers, tokens):\n+    \"\"\"Test that registrations always have consistent ticket information.\"\"\"\n+    headers = auth_headers(tokens[\"dana\"])\n+    \n+    # Create a new registration\n+    response = await client.post(\"/registrations\", json={\"event_id\": 3}, headers=headers)\n+    assert response.status_code == 201\n+    registration_id = response.json()[\"id\"]\n+    ticket_code = response.json()[\"ticket\"][\"code\"]\n+    \n+    # List registrations multiple times and verify ticket consistency\n+    for _ in range(5):\n+        registrations = await client.get(\"/registrations\", headers=headers)\n+        assert registrations.status_code == 200\n+        \n+        reg = next(x for x in registrations.json() if x[\"id\"] == registration_id)\n+        assert reg[\"ticket\"] is not None\n+        assert reg[\"ticket\"][\"code\"] == ticket_code\n+        assert reg[\"ticket\"][\"user_id\"] == 4  # Dana's user ID\n+        assert reg[\"ticket\"][\"event_id\"] == 3\n--- a/visible_tests/issue-11/test_reactivation.py\n+++ b/visible_tests/issue-11/test_reactivation.py\n@@ -0,0 +1,54 @@\n+\"\"\"Test for registration reactivation scenario that could cause registrations to disappear.\"\"\"\n+from __future__ import annotations\n+\n+\n+async def test_reactivate_cancelled_registration_then_list(client, auth_headers, tokens):\n+    \"\"\"Test that reactivating a cancelled registration works correctly and the registration appears in the list.\"\"\"\n+    headers = auth_headers(tokens[\"bob\"])\n+    \n+    # Bob has registration ID 2 which is cancelled (for event ID 1)\n+    # First, verify the cancelled registration is in the list\n+    registrations_before = await client.get(\"/registrations\", headers=headers)\n+    assert registrations_before.status_code == 200\n+    registration_ids_before = [x[\"id\"] for x in registrations_before.json()]\n+    assert 2 in registration_ids_before  # cancelled registration should be visible\n+    \n+    # Reactivate the cancelled registration by registering again for the same event\n+    # This should reuse the existing registration row\n+    reactivate_response = await client.post(\"/registrations\", json={\"event_id\": 1}, headers=headers)\n+    assert reactivate_response.status_code == 201\n+    assert reactivate_response.json()[\"id\"] == 2  # Should reuse the same registration ID\n+    assert reactivate_response.json()[\"status\"] == \"confirmed\"\n+    \n+    # Verify the registration appears in the list with the correct status and ticket\n+    registrations_after = await client.get(\"/registrations\", headers=headers)\n+    assert registrations_after.status_code == 200\n+    registration_ids_after = [x[\"id\"] for x in registrations_after.json()]\n+    assert 2 in registration_ids_after  # Registration should still be visible\n+    \n+    # Find the reactivated registration and verify it has a ticket\n+    reactivated_reg = next(x for x in registrations_after.json() if x[\"id\"] == 2)\n+    assert reactivated_reg[\"status\"] == \"confirmed\"\n+    assert reactivated_reg[\"ticket\"] is not None  # Should have a ticket now\n+    assert reactivated_reg[\"ticket\"][\"code\"] == \"T0001-0002\"  # Should reuse the same ticket code\n+\n+\n+async def test_reactivate_then_list_multiple_times(client, auth_headers, tokens):\n+    \"\"\"Test that reactivating a registration and listing multiple times is consistent.\"\"\"\n+    headers = auth_headers(tokens[\"bob\"])\n+    \n+    # Reactivate the cancelled registration\n+    reactivate_response = await client.post(\"/registrations\", json={\"event_id\": 1}, headers=headers)\n+    assert reactivate_response.status_code == 201\n+    \n+    # List registrations multiple times to ensure consistency\n+    for _ in range(3):\n+        registrations = await client.get(\"/registrations\", headers=headers)\n+        assert registrations.status_code == 200\n+        registration_ids = [x[\"id\"] for x in registrations.json()]\n+        assert 2 in registration_ids  # Registration should always be visible\n+        \n+        # Verify the registration has the correct data\n+        reg = next(x for x in registrations.json() if x[\"id\"] == 2)\n+        assert reg[\"status\"] == \"confirmed\"\n+        assert reg[\"ticket\"] is not None\n",
