        "diff": "--- a/app/money.py\n+++ b/app/money.py\n@@ -8,7 +8,7 @@\n \n from decimal import ROUND_HALF_UP, Decimal\n \n-SUPPORTED = {\"USD\": 2, \"EUR\": 2, \"GBP\": 2, \"CHF\": 2, \"CAD\": 2, \"JPY\": 2}\n+SUPPORTED = {\"USD\": 2, \"EUR\": 2, \"GBP\": 2, \"CHF\": 2, \"CAD\": 2, \"JPY\": 0}\n \n \n def assert_amount(value: object) -> Decimal:\n@@ -37,4 +37,4 @@\n     amount = assert_amount(amount)\n     if currency is not None:\n         amount = quantize(amount, currency)\n-    return str(amount)+    return str(amount)\n--- a/test_seed_jpy.py\n+++ b/test_seed_jpy.py\n@@ -0,0 +1,19 @@\n+\"\"\"Test that seeded JPY data works correctly.\"\"\"\n+from app import money\n+\n+# Test the seeded JPY value\n+def test_seeded_jpy_value():\n+    # The seed has: price=money.quantize(\"1200\", \"JPY\")\n+    quantized = money.quantize(\"1200\", \"JPY\")\n+    rendered = money.render(quantized, \"JPY\")\n+    \n+    print(f\"Quantized: {quantized}\")\n+    print(f\"Rendered: {rendered}\")\n+    \n+    assert quantized == money.assert_amount(\"1200\")\n+    assert rendered == \"1200\"\n+    assert \".\" not in rendered\n+\n+if __name__ == \"__main__\":\n+    test_seeded_jpy_value()\n+    print(\"Seeded JPY test passed!\")\n--- a/visible_tests/issue-04/test_jpy_api.py\n+++ b/visible_tests/issue-04/test_jpy_api.py\n@@ -0,0 +1,112 @@\n+\"\"\"Visible: JPY API endpoints return whole numbers without decimals.\"\"\"\n+from __future__ import annotations\n+\n+import pytest\n+from decimal import Decimal\n+\n+from app import money\n+\n+\n+async def test_create_jpy_event_rounds_to_whole_yen(client, auth_headers, tokens):\n+    \"\"\"Creating a JPY event should round to whole yen and return without decimals.\"\"\"\n+    r = await client.post(\n+        \"/events\",\n+        headers=auth_headers(tokens[\"alice\"]),\n+        json={\n+            \"title\": \"Tokyo Meetup\",\n+            \"starts_at\": \"2026-07-01T10:00:00Z\",\n+            \"capacity\": 20,\n+            \"price\": \"1200.5\",\n+            \"currency\": \"JPY\",\n+        },\n+    )\n+    assert r.status_code == 201\n+    body = r.json()\n+    assert body[\"price\"] == \"1201\"  # Rounded from 1200.5\n+    assert body[\"currency\"] == \"JPY\"\n+\n+\n+async def test_get_jpy_event_shows_whole_yen(client, auth_headers, tokens):\n+    \"\"\"Getting a JPY event should show price without decimals.\"\"\"\n+    # First create an event\n+    r = await client.post(\n+        \"/events\",\n+        headers=auth_headers(tokens[\"alice\"]),\n+        json={\n+            \"title\": \"Osaka Conference\",\n+            \"starts_at\": \"2026-07-01T10:00:00Z\",\n+            \"capacity\": 20,\n+            \"price\": \"1500.75\",\n+            \"currency\": \"JPY\",\n+        },\n+    )\n+    assert r.status_code == 201\n+    event_id = r.json()[\"id\"]\n+    \n+    # Now get the event\n+    r = await client.get(f\"/events/{event_id}\", headers=auth_headers(tokens[\"alice\"]))\n+    assert r.status_code == 200\n+    body = r.json()\n+    assert body[\"price\"] == \"1501\"  # Rounded from 1500.75\n+    assert body[\"currency\"] == \"JPY\"\n+\n+\n+async def test_charge_jpy_payment(client, auth_headers, tokens):\n+    \"\"\"Charging a JPY payment should show amount without decimals.\"\"\"\n+    # First create a JPY event\n+    r = await client.post(\n+        \"/events\",\n+        headers=auth_headers(tokens[\"bob\"]),\n+        json={\n+            \"title\": \"Yen Event\",\n+            \"starts_at\": \"2026-07-01T10:00:00Z\",\n+            \"capacity\": 10,\n+            \"price\": \"1000.25\",\n+            \"currency\": \"JPY\",\n+        },\n+    )\n+    assert r.status_code == 201\n+    event_id = r.json()[\"id\"]\n+    \n+    # Now charge for it\n+    headers = auth_headers(tokens[\"carol\"])\n+    headers[\"Idempotency-Key\"] = \"vis-04-jpy-k1\"\n+    r = await client.post(\"/payments\", headers=headers, json={\"event_id\": event_id})\n+    assert r.status_code == 201\n+    body = r.json()\n+    assert body[\"amount\"] == \"1000\"  # Rounded from 1000.25\n+    assert body[\"currency\"] == \"JPY\"\n+\n+\n+async def test_list_events_includes_jpy_without_decimals(client, auth_headers, tokens):\n+    \"\"\"Listing events should show JPY prices without decimals.\"\"\"\n+    # Create a JPY event with a unique title\n+    unique_title = \"Kyoto Festival Unique Test\"\n+    r = await client.post(\n+        \"/events\",\n+        headers=auth_headers(tokens[\"alice\"]),\n+        json={\n+            \"title\": unique_title,\n+            \"starts_at\": \"2026-07-01T10:00:00Z\",\n+            \"capacity\": 50,\n+            \"price\": \"2500.99\",\n+            \"currency\": \"JPY\",\n+        },\n+    )\n+    assert r.status_code == 201\n+    \n+    # List events\n+    r = await client.get(\"/events\", headers=auth_headers(tokens[\"alice\"]))\n+    assert r.status_code == 200\n+    body = r.json()\n+    \n+    # Find our specific JPY event by title\n+    our_event = None\n+    for event in body[\"items\"]:\n+        if event[\"currency\"] == \"JPY\" and event[\"title\"] == unique_title:\n+            our_event = event\n+            break\n+    \n+    assert our_event is not None\n+    assert \".\" not in our_event[\"price\"]  # No decimal point\n+    assert our_event[\"price\"] == \"2501\"  # Rounded from 2500.99\n--- a/visible_tests/issue-04/test_jpy_rounding.py\n+++ b/visible_tests/issue-04/test_jpy_rounding.py\n@@ -0,0 +1,36 @@\n+\"\"\"Visible: JPY amounts render without decimal places and round correctly.\"\"\"\n+from __future__ import annotations\n+\n+from decimal import Decimal\n+\n+from app import money\n+\n+\n+def test_jpy_rounding_to_whole_numbers():\n+    \"\"\"JPY should round to whole numbers (0 decimal places).\"\"\"\n+    # Test round-half-up behavior\n+    assert money.quantize(Decimal(\"1200.0\"), \"JPY\") == Decimal(\"1200\")\n+    assert money.quantize(Decimal(\"1200.4\"), \"JPY\") == Decimal(\"1200\")\n+    assert money.quantize(Decimal(\"1200.5\"), \"JPY\") == Decimal(\"1201\")\n+    assert money.quantize(Decimal(\"1200.6\"), \"JPY\") == Decimal(\"1201\")\n+    assert money.quantize(Decimal(\"1200.99\"), \"JPY\") == Decimal(\"1201\")\n+\n+\n+def test_jpy_rendering_no_decimals():\n+    \"\"\"JPY amounts should render without decimal point or trailing zeros.\"\"\"\n+    assert money.render(Decimal(\"1200\"), \"JPY\") == \"1200\"\n+    assert money.render(Decimal(\"1200.0\"), \"JPY\") == \"1200\"\n+    assert money.render(Decimal(\"1200.4\"), \"JPY\") == \"1200\"\n+    assert money.render(Decimal(\"1200.5\"), \"JPY\") == \"1201\"\n+    assert money.render(Decimal(\"1200.75\"), \"JPY\") == \"1201\"\n+\n+\n+def test_jpy_cash_places():\n+    \"\"\"JPY should have 0 cash places.\"\"\"\n+    assert money.cash_places(\"JPY\") == 0\n+\n+\n+def test_usd_unchanged():\n+    \"\"\"USD should still have 2 decimal places.\"\"\"\n+    assert money.cash_places(\"USD\") == 2\n+    assert money.render(Decimal(\"25\"), \"USD\") == \"25.00\"\n--- a/visible_tests/issue-04/test_seeded_jpy.py\n+++ b/visible_tests/issue-04/test_seeded_jpy.py\n@@ -0,0 +1,23 @@\n+\"\"\"Test that the seeded JPY event works correctly.\"\"\"\n+from __future__ import annotations\n+\n+async def test_seeded_jpy_event_shows_correct_price(client, auth_headers, tokens):\n+    \"\"\"The seeded JPY event (id=2) should show price without decimals.\"\"\"\n+    r = await client.get(\"/events/2\", headers=auth_headers(tokens[\"alice\"]))\n+    assert r.status_code == 200\n+    body = r.json()\n+    assert body[\"currency\"] == \"JPY\"\n+    assert body[\"price\"] == \"1200\"  # Seeded value\n+    assert \".\" not in body[\"price\"]  # No decimal point\n+\n+\n+async def test_seeded_jpy_payment_shows_correct_amount(client, auth_headers, tokens):\n+    \"\"\"Creating a payment for the seeded JPY event should show amount without decimals.\"\"\"\n+    headers = auth_headers(tokens[\"dana\"])\n+    headers[\"Idempotency-Key\"] = \"vis-04-seed-jpy-k1\"\n+    r = await client.post(\"/payments\", headers=headers, json={\"event_id\": 2})\n+    assert r.status_code == 201\n+    body = r.json()\n+    assert body[\"currency\"] == \"JPY\"\n+    assert body[\"amount\"] == \"1200\"  # Seeded value\n+    assert \".\" not in body[\"amount\"]  # No decimal point\n",
