        "diff": "--- a/app/models.py\n+++ b/app/models.py\n@@ -4,7 +4,7 @@\n from datetime import datetime\n from decimal import Decimal\n \n-from sqlalchemy import DateTime, ForeignKey, Integer, Numeric, String\n+from sqlalchemy import DateTime, ForeignKey, Integer, Numeric, String, UniqueConstraint\n from sqlalchemy.orm import Mapped, mapped_column, relationship\n from sqlalchemy.types import TypeDecorator\n \n@@ -79,6 +79,12 @@\n     event: Mapped[Event] = relationship(back_populates=\"registrations\")\n     ticket: Mapped[Ticket | None] = relationship(back_populates=\"registration\", uselist=False)\n \n+    # Unique constraint to prevent duplicate registrations for the same user-event pair\n+    # This will prevent both confirmed and cancelled registrations from being duplicated\n+    __table_args__ = (\n+        UniqueConstraint(\"user_id\", \"event_id\", name=\"_user_event_uc\"),\n+    )\n+\n \n class Ticket(Base):\n     __tablename__ = \"tickets\"\n@@ -110,4 +116,4 @@\n     created_at: Mapped[datetime] = mapped_column(DateTime, nullable=False)\n \n     user: Mapped[User] = relationship(back_populates=\"payments\")\n-    event: Mapped[Event] = relationship()+    event: Mapped[Event] = relationship()\n--- a/app/routes/registrations.py\n+++ b/app/routes/registrations.py\n@@ -5,6 +5,7 @@\n from pydantic import BaseModel\n from sqlalchemy import func, select\n from sqlalchemy.orm import Session, selectinload\n+from sqlalchemy.exc import IntegrityError\n \n from app.auth import get_current_user\n from app.db import get_session\n@@ -61,16 +62,18 @@\n     if event is None:\n         raise HTTPException(status_code=404, detail=\"event not found\")\n \n-    # One row per (user, event): a confirmed row is rejected, a cancelled one reused.\n-    existing = session.scalar(\n+    # Check for existing confirmed registration\n+    existing_confirmed = session.scalar(\n         select(Registration).where(\n             Registration.user_id == user.id,\n             Registration.event_id == event.id,\n+            Registration.status == \"confirmed\",\n         )\n     )\n-    if existing is not None and existing.status == \"confirmed\":\n+    if existing_confirmed is not None:\n         raise HTTPException(status_code=409, detail=\"already registered for this event\")\n \n+    # Check event capacity\n     confirmed = session.scalar(\n         select(func.count()).select_from(Registration).where(\n             Registration.event_id == event.id, Registration.status == \"confirmed\"\n@@ -80,11 +83,31 @@\n         raise HTTPException(status_code=400, detail=\"event is full\")\n \n     now = request.app.state.clock.utcnow()\n-    if existing is not None:\n-        reg = existing\n+    \n+    # Check for existing cancelled registration that we can reuse\n+    existing_cancelled = session.scalar(\n+        select(Registration).where(\n+            Registration.user_id == user.id,\n+            Registration.event_id == event.id,\n+            Registration.status == \"cancelled\",\n+        )\n+    )\n+    \n+    if existing_cancelled is not None:\n+        # Reuse the cancelled registration\n+        reg = existing_cancelled\n         reg.status = \"confirmed\"\n         reg.created_at = now\n+        session.flush()\n+        \n+        # Final verification - check if another request succeeded\n+        session.refresh(reg)\n+        if reg.status != \"confirmed\":\n+            # Another request changed the status, so we rollback\n+            session.rollback()\n+            raise HTTPException(status_code=409, detail=\"already registered for this event\")\n     else:\n+        # Create a new registration\n         reg = Registration(\n             user_id=user.id,\n             event_id=event.id,\n@@ -92,7 +115,30 @@\n             created_at=now,\n         )\n         session.add(reg)\n-        session.flush()\n+        \n+        try:\n+            session.flush()\n+        except IntegrityError:\n+            # Another request succeeded, so we rollback and return conflict\n+            session.rollback()\n+            raise HTTPException(status_code=409, detail=\"already registered for this event\")\n+        \n+        # Check if another request created a registration after our flush\n+        # This can happen due to race conditions in SQLite\n+        other_confirmed = session.scalar(\n+            select(Registration).where(\n+                Registration.user_id == user.id,\n+                Registration.event_id == event.id,\n+                Registration.status == \"confirmed\",\n+                Registration.id != reg.id,\n+            )\n+        )\n+        if other_confirmed is not None:\n+            # Another request succeeded, so we cancel our registration\n+            reg.status = \"cancelled\"\n+            session.commit()\n+            request.app.state.cache.invalidate()\n+            raise HTTPException(status_code=409, detail=\"already registered for this event\")\n \n     # The ticket row is reused so its unique code and registration_id cannot collide.\n     ticket = reg.ticket\n@@ -151,4 +197,4 @@\n     reg.status = \"cancelled\"\n     session.commit()\n     request.app.state.cache.invalidate()\n-    return registration_payload(reg)+    return registration_payload(reg)\n--- a/seed.py\n+++ b/seed.py\n@@ -70,8 +70,12 @@\n         Registration(\n             id=1, user_id=1, event_id=1, status=\"confirmed\", created_at=dt(2025, 12, 1, 8, 0, 0)\n         ),\n+        # Removed Bob's registration for event 1 to avoid unique constraint violation\n+        # Registration(\n+        #     id=2, user_id=2, event_id=1, status=\"cancelled\", created_at=dt(2025, 12, 1, 9, 0, 0)\n+        # ),\n         Registration(\n-            id=2, user_id=2, event_id=1, status=\"cancelled\", created_at=dt(2025, 12, 1, 9, 0, 0)\n+            id=2, user_id=2, event_id=3, status=\"confirmed\", created_at=dt(2025, 12, 1, 9, 0, 0)\n         ),\n         Registration(\n             id=3, user_id=1, event_