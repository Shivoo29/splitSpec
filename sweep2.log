      "contract": {
        "case_id": "issue-04",
        "summary": "Monetary values for currencies without sub\u2011units (e.g., Japanese Yen) must be represented without decimal fractions and any fractional input must be deterministically rounded to a whole number.",
        "invariants": [
          "When formatting a monetary amount for a currency that has no sub\u2011unit, the output must contain no decimal point and must be an integer value (e.g., \"1200\" not \"1200.00\").",
          "The server\u2019s stored representation of an amount in a non\u2011decimal currency must be an integer (no fractional part) after creation or update.",
          "If a client supplies a fractional amount for a non\u2011decimal currency, the server must apply a deterministic rounding rule to produce an integer amount before storage and before any response is returned.",
          "Aggregated totals (e.g., sums of ticket prices) for a non\u2011decimal currency must equal the client\u2011side total after the same rounding rule is applied."
        ],
        "inputs": [
          "Create or update a ticket priced at 1200 JPY (integer input).",
          "Create or update a ticket priced at 1200.75 JPY (fractional input).",
          "Request a list of tickets priced in JPY and compute the total price on the server."
        ],
        "expected_outputs": [
          "The price for 1200 JPY is returned as \"1200\" (no decimal places).",
          "A price submitted as 1200.75 JPY is stored and returned as an integer (e.g., 1201 or 1200 depending on the rounding rule).",
          "The sum of multiple JPY ticket prices returned by the server matches the client\u2011side sum after applying the same rounding rule."
        ],
        "out_of_scope": [
          "Rounding and formatting behavior for currencies that have sub\u2011units (e.g., USD).",
          "User\u2011interface styling or localisation beyond the numeric representation.",
          "Changes to database schema unrelated to the numeric representation of money."
        ],
        "ambiguities": [
          "The exact rounding mode to apply to fractional inputs (nearest\u2011away\u2011from\u2011zero, floor, ceil, bankers rounding, etc.).",
          "Whether fractional inputs should be rejected with an error or automatically rounded.",
          "Whether rounding occurs at input validation, storage, or only at output formatting.",
          "The data type used for the output (string vs numeric) and its precision guarantees."
        ],
        "confidence": "medium"
      },
      "patch": {
        "case_id": "issue-04",
        "diff": "--- a/app/money.py\n+++ b/app/money.py\n@@ -8,7 +8,7 @@\n \n from decimal import ROUND_HALF_UP, Decimal\n \n-SUPPORTED = {\"USD\": 2, \"EUR\": 2, \"GBP\": 2, \"CHF\": 2, \"CAD\": 2, \"JPY\": 2}\n+SUPPORTED = {\"USD\": 2, \"EUR\": 2, \"GBP\": 2, \"CHF\": 2, \"CAD\": 2, \"JPY\": 0}\n \n \n def assert_amount(value: object) -> Decimal:\n@@ -37,4 +37,7 @@\n     amount = assert_amount(amount)\n     if currency is not None:\n         amount = quantize(amount, currency)\n-    return str(amount)+    # For currencies with no decimal places (like JPY), return as integer string\n+    if currency is not None and cash_places(currency) == 0:\n+        return str(int(amount))\n+    return str(amount)\n--- a/final_verification.py\n+++ b/final_verification.py\n@@ -0,0 +1,47 @@\n+\"\"\"Final verification that issue-04 requirements are met.\"\"\"\n+from decimal import Decimal\n+from app import money\n+\n+\n+def test_all_requirements():\n+    print(\"Testing all requirements from issue-04...\")\n+    \n+    # Requirement 1: JPY has 0 decimal places\n+    assert money.cash_places(\"JPY\") == 0\n+    print(\"\u2713 JPY has 0 decimal places\")\n+    \n+    # Requirement 2: Integer JPY amounts are formatted without decimal point\n+    assert money.render(Decimal(\"1200\"), \"JPY\") == \"1200\"\n+    assert \".\" not in money.render(Decimal(\"1200\"), \"JPY\")\n+    print(\"\u2713 Integer JPY amounts formatted without decimal point\")\n+    \n+    # Requirement 3: Fractional JPY amounts are rounded deterministically\n+    assert money.quantize(Decimal(\"1200.75\"), \"JPY\") == Decimal(\"1201\")\n+    assert money.quantize(Decimal(\"1200.49\"), \"JPY\") == Decimal(\"1200\")\n+    assert money.quantize(Decimal(\"1200.50\"), \"JPY\") == Decimal(\"1201\")\n+    print(\"\u2713 Fractional JPY amounts rounded deterministically (ROUND_HALF_UP)\")\n+    \n+    # Requirement 4: Rendered fractional JPY amounts have no decimal point\n+    assert money.render(Decimal(\"1200.75\"), \"JPY\") == \"1201\"\n+    assert money.render(Decimal(\"1200.49\"), \"JPY\") == \"1200\"\n+    print(\"\u2713 Rendered fractional JPY amounts have no decimal point\")\n+    \n+    # Requirement 5: Aggregated totals match client-side rounding\n+    amounts = [Decimal(\"1200.75\"), Decimal(\"1200.49\"), Decimal(\"1200.50\")]\n+    server_rounded = [money.quantize(amt, \"JPY\") for amt in amounts]\n+    client_rounded = [money.quantize(amt, \"JPY\") for amt in amounts]\n+    assert server_rounded == client_rounded\n+    assert money.total(server_rounded) == money.total(client_rounded)\n+    print(\"\u2713 Aggregated totals match client-side rounding\")\n+    \n+    # Requirement 6: USD still works correctly (2 decimal places)\n+    assert money.cash_places(\"USD\") == 2\n+    assert money.quantize(Decimal(\"1.005\"), \"USD\") == Decimal(\"1.01\")\n+    assert money.render(Decimal(\"25\"), \"USD\") == \"25.00\"\n+    print(\"\u2713 USD still works correctly with 2 decimal places\")\n+    \n+    print(\"\\n\u2705 All requirements from issue-04 are satisfied!\")\n+\n+\n+if __name__ == \"__main__\":\n+    test_all_requirements()\n--- a/test_issue_04_requirements.py\n+++ b/test_issue_04_requirements.py\n@@ -0,0 +1,118 @@\n+\"\"\"Test all requirements from issue-04.\"\"\"\n+from decimal import Decimal\n+import pytest\n+import pytest_asyncio\n+from app import money\n+\n+\n+def test_requirement_1_jpy_no_decimal_places():\n+    \"\"\"When formatting a monetary amount for JPY, the output must contain no decimal point.\"\"\"\n+    assert money.render(Decimal(\"1200\"), \"JPY\") == \"1200\"\n+    assert \".\" not in money.render(Decimal(\"1200\"), \"JPY\")\n+\n+\n+def test_requirement_2_jpy_integer_value():\n+    \"\"\"The output must be an integer value (e.g., \"1200\" not \"1200.00\").\"\"\"\n+    result = money.render(Decimal(\"1200\"), \"JPY\")\n+    assert result == \"1200\"\n+    assert result == str(int(result))\n+\n+\n+def test_requirement_3_server_stored_as_integer():\n+    \"\"\"The server's stored representation must be an integer after creation or update.\"\"\"\n+    # This is tested through quantize which ensures the amount is rounded to 0 decimal places\n+    quantized = money.quantize(Decimal(\"1200.75\"), \"JPY\")\n+    assert quantized == Decimal(\"1201\")\n+    assert quantized % 1 == 0  # No fractional part\n+\n+\n+def test_requirement_4_fractional_input_rounded():\n+    \"\"\"If a client supplies a fractional amount for JPY, it must be deterministically rounded.\"\"\"\n+    # Test various fractional inputs\n+    assert money.quantize(Decimal(\"1200.75\"), \"JPY\") == Decimal(\"1201\")\n+    assert money.quantize(Decimal(\"1200.49\"), \"JPY\") == Decimal(\"1200\")\n+    assert money.quantize(Decimal(\"1200.50\"), \"JPY\") == Decimal(\"1201\")\n+    assert money.quantize(Decimal(\"1200.51\"), \"JPY\") == Decimal(\"1201\")\n+\n+\n+def test_requirement_5_aggregated_totals():\n+    \"\"\"Aggregated totals for JPY must equal the client-side total after the same rounding rule.\"\"\"\n+    # Client provides these amounts\n+    client_amounts = [Decimal(\"1200.75\"), Decimal(\"1200.49\"), Decimal(\"1200.50\")]\n+    \n+    # Server rounds each individually\n+    server_rounded = [money.quantize(amt, \"JPY\") for amt in client_amounts]\n+    assert server_rounded == [Decimal(\"1201\"), Decimal(\"1200\"), Decimal(\"1201\")]\n+    \n+    # Client also rounds each individually\n+    client_rounded = [money.quantize(amt, \"JPY\") for amt in client_amounts]\n+    \n+    # Both should have the same rounded values\n+    assert server_rounded == client_rounded\n+    \n+    # Sums should match\n+    server_sum = money.total(server_rounded)\n+    client_sum = money.total(client_rounded)\n+    assert server_sum == client_sum\n+    assert server_sum == Decimal(\"3602\")\n+\n+\n+@pytest.mark.asyncio\n+async def test_requirement_6_api_integration(client, auth_headers, tokens):\n+    \"\"\"Test the full API flow with JPY.\"\"\"\n+    # Create event with integer JPY price\n+    r = await client.post(\n+        \"/events\",\n+        headers=auth_headers(tokens[\"alice\"]),\n+        json={\n+            \"title\": \"Test Event\",\n+            \"starts_at\": \"2026-07-01T10:00:00Z\",\n+            \"capacity\": 100,\n+            \"price\": \"1200\",\n+            \"currency\": \"JPY\",\n+        },\n+    )\n+    assert r.status_code == 201\n+    assert r.json()[\"price\"] == \"1200\"\n+    event_id = r.json()[\"id\"]\n+    \n+    # Create event with fractional JPY price (should be rounded)\n+    r = await client.post(\n+        \"/events\",\n+        headers=auth_headers(tokens[\"alice\"]),\n+        json={\n+            \"title\": \"Test Event 2\",\n+            \"starts_at\": \"2026-07-02T10:00:00Z\",\n+            \"capacity\": 100,\n+            \"price\": \"1200.75\",\n+            \"currency\": \"JPY\",\n+        },\n+    )\n+    assert r.status_code == 201\n+    assert r.json()[\"price\"] == \"1201\"  # Rounded\n+    \n+    # List events and verify JPY prices\n+    r = await client.get(\"/events\")\n+    assert r.status_code == 200\n+    jpy_events = [e for e in r.json()[\"items\"] if e[\"currency\"] == \"JPY\"]\n+    for event in jpy_events:\n+        assert \".\" not in event[\"price\"]\n+        assert event[\"price\"] == str(int(float(event[\"price\"])))\n+    \n+    # Create payment for JPY event\n+    headers = {\n+        **auth_headers(tokens[\"dana\"]),\n+        \"Idempotency-Key\": \"issue-04-test\"\n+    }\n+    r = await client.post(\n+        \"/payments\",\n+        headers=headers,\n+        json={\"event_id\": event_id}\n+    )\n+    assert r.status_code == 201\n+    assert r.json()[\"amount\"] == \"1200\"\n+    assert r.json()[\"currency\"] == \"JPY\"\n+\n+\n+if __name__ == \"__main__\":\n+    pytest.main([__file__, \"-v\"])\n--- a/test_jpy.py\n+++ b/test_jpy.py\n@@ -0,0 +1,54 @@\n+\"\"\"Test JPY rounding and formatting.\"\"\"\n+from decimal import Decimal\n+from app import money\n+\n+\n+def test_jpy_no_decimal_places():\n+    \"\"\"JPY should have 0 decimal places.\"\"\"\n+    assert money.cash_places(\"JPY\") == 0\n+\n+\n+def test_jpy_quantize_integer():\n+    \"\"\"Integer JPY amounts should remain unchanged.\"\"\"\n+    assert money.quantize(Decimal(\"1200\"), \"JPY\") == Decimal(\"1200\")\n+\n+\n+def test_jpy_quantize_fractional():\n+    \"\"\"Fractional JPY amounts should be rounded to nearest integer.\"\"\"\n+    # 1200.75 should round to 1201 (round-half-up)\n+    assert money.quantize(Decimal(\"1200.75\"), \"JPY\") == Decimal(\"1201\")\n+    # 1200.49 should round to 1200\n+    assert money.quantize(Decimal(\"1200.49\"), \"JPY\") == Decimal(\"1200\")\n+    # 1200.50 should round to 1201\n+    assert money.quantize(Decimal(\"1200.50\"), \"JPY\") == Decimal(\"1201\")\n+\n+\n+def test_jpy_render_integer():\n+    \"\"\"Integer JPY amounts should render without decimal point.\"\"\"\n+    assert money.render(Decimal(\"1200\"), \"JPY\") == \"1200\"\n+\n+\n+def test_jpy_render_fractional():\n+    \"\"\"Fractional JPY amounts should be rounded and rendered without decimal point.\"\"\"\n+    assert money.render(Decimal(\"1200.75\"), \"JPY\") == \"1201\"\n+    assert money.render(Decimal(\"1200.49\"), \"JPY\") == \"1200\"\n+\n+\n+def test_jpy_total():\n+    \"\"\"Sum of JPY amounts should be correct.\"\"\"\n+    amounts = [Decimal(\"1200.75\"), Decimal(\"1200.49\"), Decimal(\"1200.50\")]\n+    # Each should be rounded individually\n+    # 1200.75 -> 1201, 1200.49 -> 1200, 1200.50 -> 1201\n+    # Sum = 1201 + 1200 + 1201 = 3602\n+    total = money.total(amounts)\n+    assert money.quantize(total, \"JPY\") == Decimal(\"3602\")\n+\n+\n+if __name__ == \"__main__\":\n+    test_jpy_no_decimal_places()\n+    test_jpy_quantize_integer()\n+    test_jpy_quantize_fractional()\n+    test_jpy_render_integer()\n+    test_jpy_render_fractional()\n+    test_jpy_total()\n+    print(\"All JPY tests passed!\")\n--- a/test_jpy_integration.py\n+++ b/test_jpy_integration.py\n@@ -0,0 +1,68 @@\n+\"\"\"Integration test for JPY handling in the API.\"\"\"\n+from decimal import Decimal\n+import pytest\n+import pytest_asyncio\n+\n+from app import money\n+\n+\n+@pytest.mark.asyncio\n+async def test_jpy_event_creation(client, auth_headers, tokens):\n+    \"\"\"Test creating an event with JPY currency.\"\"\"\n+    # Test with integer price\n+    r = await client.post(\n+        \"/events\",\n+        headers=auth_headers(tokens[\"alice\"]),\n+        json={\n+            \"title\": \"Tokyo Conference\",\n+            \"starts_at\": \"2026-07-01T10:00:00Z\",\n+            \"capacity\": 100,\n+            \"price\": \"1200\",\n+            \"currency\": \"JPY\",\n+        },\n+    )\n+    assert r.status_code == 201\n+    data = r.json()\n+    assert data[\"price\"] == \"1200\"  # No decimal places\n+    assert data[\"currency\"] == \"JPY\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_jpy_event_creation_with_fractional(client, auth_headers, tokens):\n+    \"\"\"Test creating an event with fractional JPY price (should be rounded).\"\"\"\n+    r = await client.post(\n+        \"/events\",\n+        headers=auth_headers(tokens[\"alice\"]),\n+        json={\n+            \"title\": \"Tokyo Conference 2\",\n+            \"starts_at\": \"2026-07-01T10:00:00Z\",\n+            \"capacity\": 100,\n+            \"price\": \"1200.75\",\n+            \"currency\": \"JPY\",\n+        },\n+    )\n+    assert r.status_code == 201\n+    data = r.json()\n+    assert data[\"price\"] == \"1201\"  # Rounded to nearest integer\n+    assert data[\"currency\"] == \"JPY\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_jpy_event_list(client):\n+    \"\"\"Test listing events with JPY prices.\"\"\"\n+    # List events\n+    r = await client.get(\"/events\")\n+    assert r.status_code == 200\n+    data = r.json()\n+    \n+    # Find JPY events (if any)\n+    jpy_events = [e for e in data[\"items\"] if e.get(\"currency\") == \"JPY\"]\n+    \n+    # Verify prices are formatted correctly\n+    for event in jpy_events:\n+        assert \".\" not in event[\"price\"]  # No decimal point\n+        assert event[\"price\"] == str(int(float(event[\"price\"])))\n+\n+\n+if __name__ == \"__main__\":\n+    pytest.main([__file__, \"-v\"])\n--- a/test_jpy_payments.py\n+++ b/test_jpy_payments.py\n@@ -0,0 +1,75 @@\n+\"\"\"Test JPY payments.\"\"\"\n+import pytest\n+import pytest_asyncio\n+\n+\n+@pytest.mark.asyncio\n+async def test_jpy_payment(client, auth_headers, tokens):\n+    \"\"\"Test creating a payment for a JPY event.\"\"\"\n+    # First create a JPY event\n+    r = await client.post(\n+        \"/events\",\n+        headers=auth_headers(tokens[\"alice\"]),\n+        json={\n+            \"title\": \"Tokyo Conference\",\n+            \"starts_at\": \"2026-07-01T10:00:00Z\",\n+            \"capacity\": 100,\n+            \"price\": \"1500.50\",\n+            \"currency\": \"JPY\",\n+        },\n+    )\n+    assert r.status_code == 201\n+    event_id = r.json()[\"id\"]\n+    \n+    # Now create a payment for this event\n+    headers = {\n+        **auth_headers(tokens[\"dana\"]),\n+        \"Idempotency-Key\": \"jpy-payment-test-1\"\n+    }\n+    r = await client.post(\n+        \"/payments\",\n+        headers=headers,\n+        json={\"event_id\": event_id}\n+    )\n+    assert r.status_code == 201\n+    data = r.json()\n+    assert data[\"amount\"] == \"1501\"  # Rounded from 1500.50\n+    assert data[\"currency\"] == \"JPY\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_jpy_payment_with_integer_price(client, auth_headers, tokens):\n+    \"\"\"Test creating a payment for a JPY event with integer price.\"\"\"\n+    # First create a JPY event with integer price\n+    r = await client.post(\n+        \"/events\",\n+        headers=auth_headers(tokens[\"alice\"]),\n+        json={\n+            \"title\": \"Tokyo Conference 2\",\n+            \"starts_at\": \"2026-07-01T10:00:00Z\",\n+            \"capacity\": 100,\n+            \"price\": \"1200\",\n+            \"currency\": \"JPY\",\n+        },\n+    )\n+    assert r.status_code == 201\n+    event_id = r.json()[\"id\"]\n+    \n+    # Now create a payment for this event\n+    headers = {\n+        **auth_headers(tokens[\"dana\"]),\n+        \"Idempotency-Key\": \"jpy-payment-test-2\"\n+    }\n+    r = await client.post(\n+        \"/payments\",\n+        headers=headers,\n+        json={\"event_id\": event_id}\n+    )\n+    assert r.status_code == 201\n+    data = r.json()\n+    assert data[\"amount\"] == \"1200\"  # No rounding needed\n+    assert data[\"currency\"] == \"JPY\"\n+\n+\n+if __name__ == \"__main__\":\n+    pytest.main([__file__, \"-v\"])\n",
