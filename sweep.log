      "contract": {
        "case_id": "issue-05",
        "summary": "A user must only be able to retrieve tickets that they own; requests for tickets belonging to other users must not disclose ticket details.",
        "invariants": [
          "When an authenticated request asks for a ticket by its identifier, the API must return the ticket\u2019s full details only if the ticket is owned by the requesting user; otherwise it must not return those details."
        ],
        "inputs": [
          "Authenticated GET request for a ticket ID that belongs to the requesting user.",
          "Authenticated GET request for a ticket ID that belongs to a different user.",
          "Unauthenticated GET request for any ticket ID."
        ],
        "expected_outputs": [
          "For a ticket owned by the requester: HTTP 200 with the ticket\u2019s data.",
          "For a ticket not owned by the requester: an error response that does not contain ticket details (e.g., HTTP 403 Forbidden or HTTP 404 Not Found).",
          "For an unauthenticated request: an authentication error response (e.g., HTTP 401 Unauthorized)."
        ],
        "out_of_scope": [
          "Ticket creation, payment handling, barcode generation, UI rendering, performance optimizations, audit\u2011logging details, and any behavior unrelated to read\u2011only ticket access."
        ],
        "ambiguities": [
          "Exact HTTP status code and error payload to be used for unauthorized access (403 vs 404).",
          "Specific authentication mechanism and token format used by the API.",
          "How ownership is defined if tickets can be shared among team members.",
          "The precise endpoint path if it differs from /tickets/{id}."
        ],
        "confidence": "high"
      },
      "patch": {
        "case_id": "issue-05",
        "diff": "--- a/app/routes/tickets.py\n+++ b/app/routes/tickets.py\n@@ -46,4 +46,7 @@\n     # but a revoked ticket is not readable.\n     if ticket.registration.status != \"confirmed\":\n         raise HTTPException(status_code=404, detail=\"ticket revoked by cancellation\")\n-    return ticket_payload(ticket)+    # Users may only read their own tickets\n+    if ticket.user_id != user.id:\n+        raise HTTPException(status_code=404, detail=\"ticket not found\")\n+    return ticket_payload(ticket)\n--- a/test_comprehensive.py\n+++ b/test_comprehensive.py\n@@ -0,0 +1,76 @@\n+\"\"\"Comprehensive test for ticket access control.\"\"\"\n+import pytest\n+from httpx import AsyncClient\n+\n+\n+@pytest.mark.asyncio\n+async def test_alice_access_own_tickets(client: AsyncClient, auth_headers, tokens):\n+    \"\"\"Alice can access her own tickets (1 and 3).\"\"\"\n+    # Ticket 1 belongs to Alice\n+    r = await client.get(\"/tickets/1\", headers=auth_headers(tokens[\"alice\"]))\n+    assert r.status_code == 200\n+    assert r.json()[\"user_id\"] == 1\n+    \n+    # Ticket 3 belongs to Alice\n+    r = await client.get(\"/tickets/3\", headers=auth_headers(tokens[\"alice\"]))\n+    assert r.status_code == 200\n+    assert r.json()[\"user_id\"] == 1\n+\n+\n+@pytest.mark.asyncio\n+async def test_alice_cannot_access_others_tickets(client: AsyncClient, auth_headers, tokens):\n+    \"\"\"Alice cannot access tickets belonging to other users.\"\"\"\n+    # Ticket 2 belongs to Bob (but has cancelled registration, so should be 404 anyway)\n+    r = await client.get(\"/tickets/2\", headers=auth_headers(tokens[\"alice\"]))\n+    assert r.status_code == 404\n+    \n+    # Ticket 4 belongs to Carol\n+    r = await client.get(\"/tickets/4\", headers=auth_headers(tokens[\"alice\"]))\n+    assert r.status_code == 404\n+\n+\n+@pytest.mark.asyncio\n+async def test_bob_cannot_access_alice_tickets(client: AsyncClient, auth_headers, tokens):\n+    \"\"\"Bob cannot access Alice's tickets.\"\"\"\n+    # Ticket 1 belongs to Alice\n+    r = await client.get(\"/tickets/1\", headers=auth_headers(tokens[\"bob\"]))\n+    assert r.status_code == 404\n+    \n+    # Ticket 3 belongs to Alice\n+    r = await client.get(\"/tickets/3\", headers=auth_headers(tokens[\"bob\"]))\n+    assert r.status_code == 404\n+\n+\n+@pytest.mark.asyncio\n+async def test_carol_can_access_own_ticket(client: AsyncClient, auth_headers, tokens):\n+    \"\"\"Carol can access her own ticket (4).\"\"\"\n+    r = await client.get(\"/tickets/4\", headers=auth_headers(tokens[\"carol\"]))\n+    assert r.status_code == 200\n+    assert r.json()[\"user_id\"] == 3\n+\n+\n+@pytest.mark.asyncio\n+async def test_carol_cannot_access_alice_tickets(client: AsyncClient, auth_headers, tokens):\n+    \"\"\"Carol cannot access Alice's tickets.\"\"\"\n+    r = await client.get(\"/tickets/1\", headers=auth_headers(tokens[\"carol\"]))\n+    assert r.status_code == 404\n+    \n+    r = await client.get(\"/tickets/3\", headers=auth_headers(tokens[\"carol\"]))\n+    assert r.status_code == 404\n+\n+\n+@pytest.mark.asyncio\n+async def test_unauthenticated_cannot_access_any_ticket(client: AsyncClient):\n+    \"\"\"Unauthenticated requests are rejected.\"\"\"\n+    r = await client.get(\"/tickets/1\")\n+    assert r.status_code == 401\n+    \n+    r = await client.get(\"/tickets/4\")\n+    assert r.status_code == 401\n+\n+\n+@pytest.mark.asyncio\n+async def test_nonexistent_ticket_returns_404(client: AsyncClient, auth_headers, tokens):\n+    \"\"\"Non-existent tickets return 404.\"\"\"\n+    r = await client.get(\"/tickets/999\", headers=auth_headers(tokens[\"alice\"]))\n+    assert r.status_code == 404\n--- a/test_cross_user.py\n+++ b/test_cross_user.py\n@@ -0,0 +1,37 @@\n+\"\"\"Test cross-user ticket access.\"\"\"\n+import pytest\n+from httpx import AsyncClient\n+\n+\n+@pytest.mark.asyncio\n+async def test_user_cannot_access_other_users_ticket(client: AsyncClient, auth_headers, tokens):\n+    \"\"\"Test that Alice cannot access Bob's ticket.\"\"\"\n+    # Alice (user 1) tries to access ticket 4 which belongs to Carol (user 3)\n+    r = await client.get(\"/tickets/4\", headers=auth_headers(tokens[\"alice\"]))\n+    # Should return 403 or 404, not 200 with ticket details\n+    assert r.status_code in [403, 404]\n+    # Should not contain ticket details\n+    if r.status_code == 200:\n+        pytest.fail(\"Should not return ticket details for another user's ticket\")\n+\n+\n+@pytest.mark.asyncio\n+async def test_user_can_access_own_ticket(client: AsyncClient, auth_headers, tokens):\n+    \"\"\"Test that Alice can access her own ticket.\"\"\"\n+    # Alice (user 1) accesses her own ticket 1\n+    r = await client.get(\"/tickets/1\", headers=auth_headers(tokens[\"alice\"]))\n+    assert r.status_code == 200\n+    assert r.json()[\"code\"] == \"T0001-0001\"\n+    assert r.json()[\"user_id\"] == 1\n+\n+\n+@pytest.mark.asyncio\n+async def test_bob_cannot_access_alice_ticket(client: AsyncClient, auth_headers, tokens):\n+    \"\"\"Test that Bob cannot access Alice's ticket.\"\"\"\n+    # Bob (user 2) tries to access ticket 1 which belongs to Alice (user 1)\n+    r = await client.get(\"/tickets/1\", headers=auth_headers(tokens[\"bob\"]))\n+    # Should return 403 or 404, not 200 with ticket details\n+    assert r.status_code in [403, 404]\n+    # Should not contain ticket details\n+    if r.status_code == 200:\n+        pytest.fail(\"Should not return ticket details for another user's ticket\")\n",
        "files_changed": [
          "app/routes/tickets.py",
          "test_comprehensive.py",
          "test_cross_user.py"
        ],
