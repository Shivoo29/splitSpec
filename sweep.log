        "diff": "--- a/app/routes/events.py\n+++ b/app/routes/events.py\n@@ -104,7 +104,7 @@\n         return cached\n     total = session.scalar(select(func.count()).select_from(Event)) or 0\n     rows = session.scalars(\n-        select(Event).order_by(Event.starts_at.asc(), Event.id.asc()).limit(limit).offset(offset - 1)\n+        select(Event).order_by(Event.starts_at.asc(), Event.id.asc()).limit(limit).offset(offset)\n     ).all()\n     payload = {\n         \"items\": [event_payload(event) for event in rows],\n@@ -131,4 +131,4 @@\n         raise HTTPException(status_code=404, detail=\"event not found\")\n     payload = event_payload(event)\n     request.app.state.cache.set(key, payload)\n-    return payload+    return payload\n--- a/test_comprehensive_pagination.py\n+++ b/test_comprehensive_pagination.py\n@@ -0,0 +1,89 @@\n+\"\"\"Comprehensive pagination tests to verify the fix.\"\"\"\n+import pytest\n+from httpx import AsyncClient\n+\n+\n+@pytest.mark.asyncio\n+async def test_pagination_comprehensive(client: AsyncClient):\n+    \"\"\"Test pagination with various offset/limit combinations.\"\"\"\n+    \n+    # Get full list\n+    full_response = await client.get(\"/events\")\n+    full_items = full_response.json()[\"items\"]\n+    full_ids = [e[\"id\"] for e in full_items]\n+    total = full_response.json()[\"total\"]\n+    \n+    print(f\"\\nFull list: {full_ids} (total: {total})\")\n+    \n+    # Test 1: offset=0, limit=1 (first item only)\n+    page = await client.get(\"/events\", params={\"limit\": 1, \"offset\": 0})\n+    page_ids = [e[\"id\"] for e in page.json()[\"items\"]]\n+    print(f\"offset=0, limit=1: {page_ids}\")\n+    assert page_ids == full_ids[:1], f\"Expected {full_ids[:1]}, got {page_ids}\"\n+    \n+    # Test 2: offset=1, limit=1 (second item only)\n+    page = await client.get(\"/events\", params={\"limit\": 1, \"offset\": 1})\n+    page_ids = [e[\"id\"] for e in page.json()[\"items\"]]\n+    print(f\"offset=1, limit=1: {page_ids}\")\n+    assert page_ids == full_ids[1:2], f\"Expected {full_ids[1:2]}, got {page_ids}\"\n+    \n+    # Test 3: offset=2, limit=1 (third item only)\n+    page = await client.get(\"/events\", params={\"limit\": 1, \"offset\": 2})\n+    page_ids = [e[\"id\"] for e in page.json()[\"items\"]]\n+    print(f\"offset=2, limit=1: {page_ids}\")\n+    assert page_ids == full_ids[2:3], f\"Expected {full_ids[2:3]}, got {page_ids}\"\n+    \n+    # Test 4: offset=0, limit=3 (all items)\n+    page = await client.get(\"/events\", params={\"limit\": 3, \"offset\": 0})\n+    page_ids = [e[\"id\"] for e in page.json()[\"items\"]]\n+    print(f\"offset=0, limit=3: {page_ids}\")\n+    assert page_ids == full_ids, f\"Expected {full_ids}, got {page_ids}\"\n+    \n+    # Test 5: offset=3, limit=10 (beyond total, should be empty)\n+    page = await client.get(\"/events\", params={\"limit\": 10, \"offset\": 3})\n+    page_ids = [e[\"id\"] for e in page.json()[\"items\"]]\n+    print(f\"offset=3, limit=10: {page_ids}\")\n+    assert page_ids == [], f\"Expected empty list, got {page_ids}\"\n+    \n+    # Test 6: Verify no duplicates when paginating through all items\n+    all_paginated = []\n+    for i in range(0, total, 2):  # Page through with limit=2\n+        page = await client.get(\"/events\", params={\"limit\": 2, \"offset\": i})\n+        page_ids = [e[\"id\"] for e in page.json()[\"items\"]]\n+        all_paginated.extend(page_ids)\n+        print(f\"offset={i}, limit=2: {page_ids}\")\n+    \n+    # Check no duplicates\n+    assert len(all_paginated) == len(set(all_paginated)), f\"Duplicate IDs found: {all_paginated}\"\n+    \n+    # Check ordering matches full list\n+    assert all_paginated == full_ids, f\"Paginated {all_paginated} != full {full_ids}\"\n+    \n+    print(\"\\n\u2713 All pagination tests passed!\")\n+\n+\n+@pytest.mark.asyncio\n+async def test_pagination_metadata(client: AsyncClient):\n+    \"\"\"Test that pagination metadata is correct.\"\"\"\n+    \n+    # Get full list\n+    full_response = await client.get(\"/events\")\n+    total = full_response.json()[\"total\"]\n+    \n+    # Test with limit=2, offset=0\n+    page = await client.get(\"/events\", params={\"limit\": 2, \"offset\": 0})\n+    data = page.json()\n+    \n+    assert data[\"total\"] == total\n+    assert data[\"limit\"] == 2\n+    assert data[\"offset\"] == 0\n+    assert len(data[\"items\"]) <= 2\n+    \n+    # Test with limit=2, offset=2\n+    page = await client.get(\"/events\", params={\"limit\": 2, \"offset\": 2})\n+    data = page.json()\n+    \n+    assert data[\"total\"] == total\n+    assert data[\"limit\"] == 2\n+    assert data[\"offset\"] == 2\n+    assert len(data[\"items\"]) <= 2\n--- a/test_pagination_issue.py\n+++ b/test_pagination_issue.py\n@@ -0,0 +1,59 @@\n+\"\"\"Test to demonstrate the pagination off-by-one issue.\"\"\"\n+import pytest\n+from httpx import AsyncClient\n+\n+\n+@pytest.mark.asyncio\n+async def test_pagination_off_by_one(client: AsyncClient):\n+    \"\"\"Test that pagination returns contiguous, non-overlapping slices.\"\"\"\n+    \n+    # Get full list\n+    full_response = await client.get(\"/events\")\n+    full_items = full_response.json()[\"items\"]\n+    full_ids = [e[\"id\"] for e in full_items]\n+    print(f\"Full list: {full_ids}\")\n+    \n+    # Get page 1 (offset 0, limit 2)\n+    page1 = await client.get(\"/events\", params={\"limit\": 2, \"offset\": 0})\n+    page1_items = page1.json()[\"items\"]\n+    page1_ids = [e[\"id\"] for e in page1_items]\n+    print(f\"Page 1 (offset 0, limit 2): {page1_ids}\")\n+    \n+    # Get page 2 (offset 2, limit 2)\n+    page2 = await client.get(\"/events\", params={\"limit\": 2, \"offset\": 2})\n+    page2_items = page2.json()[\"items\"]\n+    page2_ids = [e[\"id\"] for e in page2_items]\n+    print(f\"Page 2 (offset 2, limit 2): {page2_ids}\")\n+    \n+    # Check for duplicates\n+    all_paginated_ids = page1_ids + page2_ids\n+    assert len(all_paginated_ids) == len(set(all_paginated_ids)), \"Duplicate IDs found in pagination\"\n+    \n+    # Check ordering matches\n+    assert all_paginated_ids == full_ids, f\"Paginated order {all_paginated_ids} != full order {full_ids}\"\n+    \n+    # Get page 3 (offset 4, limit 2) - should be empty or have remaining items\n+    page3 = await client.get(\"/events\", params={\"limit\": 2, \"offset\": 4})\n+    page3_items = page3.json()[\"items\"]\n+    page3_ids = [e[\"id\"] for e in page3_items]\n+    print(f\"Page 3 (offset 4, limit 2): {page3_ids}\")\n+    \n+    # All pages combined should match full list\n+    all_pages_ids = page1_ids + page2_ids + page3_ids\n+    assert all_pages_ids == full_ids, f\"All pages {all_pages_ids} != full list {full_ids}\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_offset_zero_returns_first_page(client: AsyncClient):\n+    \"\"\"Test that offset=0 returns the first 'limit' items.\"\"\"\n+    \n+    # Get full list\n+    full_response = await client.get(\"/events\")\n+    full_ids = [e[\"id\"] for e in full_response.json()[\"items\"]]\n+    \n+    # Get first page with offset 0\n+    page1 = await client.get(\"/events\", params={\"limit\": 2, \"offset\": 0})\n+    page1_ids = [e[\"id\"] for e in page1.json()[\"items\"]]\n+    \n+    # First page should be first 2 items from full list\n+    assert page1_ids == full_ids[:2], f\"First page {page1_ids} != first 2 items {full_ids[:2]}\"\n",
