        "case_id": "issue-10",
        "diff": "--- a/app/money.py\n+++ b/app/money.py\n@@ -2,11 +2,11 @@\n \n Float is rejected at the boundary so no binary floating point ever reaches an\n amount or a total. Amounts are quantized to the currency's cash unit with\n-bankers rounding.\n+rounding that rounds half-way cases up (away from zero).\n \"\"\"\n from __future__ import annotations\n \n-from decimal import ROUND_HALF_EVEN, Decimal\n+from decimal import ROUND_HALF_UP, Decimal\n \n SUPPORTED = {\"USD\": 2, \"EUR\": 2, \"GBP\": 2, \"CHF\": 2, \"CAD\": 2, \"JPY\": 0}\n \n@@ -26,7 +26,7 @@\n def quantize(amount: object, currency: str) -> Decimal:\n     amount = assert_amount(amount)\n     places = Decimal(10) ** -cash_places(currency)\n-    return amount.quantize(places, rounding=ROUND_HALF_EVEN)\n+    return amount.quantize(places, rounding=ROUND_HALF_UP)\n \n \n def total(amounts: list[object]) -> Decimal:\n@@ -37,4 +37,4 @@\n     amount = assert_amount(amount)\n     if currency is not None:\n         amount = quantize(amount, currency)\n-    return str(amount)+    return str(amount)\n--- a/test_edge_cases.py\n+++ b/test_edge_cases.py\n@@ -0,0 +1,47 @@\n+\"\"\"Test edge cases for the money rounding fix.\"\"\"\n+from decimal import Decimal\n+from app import money\n+\n+\n+def test_various_half_cent_cases():\n+    \"\"\"Test various half-cent cases to ensure they all round up.\"\"\"\n+    # Half-cent cases that should round up\n+    assert money.quantize(Decimal(\"0.005\"), \"USD\") == Decimal(\"0.01\")\n+    assert money.quantize(Decimal(\"1.005\"), \"USD\") == Decimal(\"1.01\")\n+    assert money.quantize(Decimal(\"1.015\"), \"USD\") == Decimal(\"1.02\")\n+    assert money.quantize(Decimal(\"1.025\"), \"USD\") == Decimal(\"1.03\")\n+    assert money.quantize(Decimal(\"1.035\"), \"USD\") == Decimal(\"1.04\")\n+    assert money.quantize(Decimal(\"1.045\"), \"USD\") == Decimal(\"1.05\")\n+    assert money.quantize(Decimal(\"2.345\"), \"USD\") == Decimal(\"2.35\")\n+    assert money.quantize(Decimal(\"9.995\"), \"USD\") == Decimal(\"10.00\")\n+\n+\n+def test_non_half_cent_cases():\n+    \"\"\"Test that non-half-cent cases still work correctly.\"\"\"\n+    # Cases that should round down\n+    assert money.quantize(Decimal(\"1.001\"), \"USD\") == Decimal(\"1.00\")\n+    assert money.quantize(Decimal(\"1.004\"), \"USD\") == Decimal(\"1.00\")\n+    \n+    # Cases that should round up\n+    assert money.quantize(Decimal(\"1.006\"), \"USD\") == Decimal(\"1.01\")\n+    assert money.quantize(Decimal(\"1.009\"), \"USD\") == Decimal(\"1.01\")\n+    \n+    # Exact cent values should remain unchanged\n+    assert money.quantize(Decimal(\"1.00\"), \"USD\") == Decimal(\"1.00\")\n+    assert money.quantize(Decimal(\"1.01\"), \"USD\") == Decimal(\"1.01\")\n+    assert money.quantize(Decimal(\"1.99\"), \"USD\") == Decimal(\"1.99\")\n+\n+\n+def test_jpy_rounding():\n+    \"\"\"Test that JPY (which has 0 decimal places) still works.\"\"\"\n+    assert money.quantize(Decimal(\"100.0\"), \"JPY\") == Decimal(\"100\")\n+    assert money.quantize(Decimal(\"100.4\"), \"JPY\") == Decimal(\"100\")\n+    assert money.quantize(Decimal(\"100.5\"), \"JPY\") == Decimal(\"101\")\n+    assert money.quantize(Decimal(\"100.9\"), \"JPY\") == Decimal(\"101\")\n+\n+\n+if __name__ == \"__main__\":\n+    test_various_half_cent_cases()\n+    test_non_half_cent_cases()\n+    test_jpy_rounding()\n+    print(\"All edge case tests passed!\")\n--- a/test_total_function.py\n+++ b/test_total_function.py\n@@ -0,0 +1,23 @@\n+\"\"\"Test that the total function still works correctly.\"\"\"\n+from decimal import Decimal\n+from app import money\n+\n+\n+def test_total_function():\n+    \"\"\"Test that the total function still works correctly.\"\"\"\n+    # Test with simple values\n+    assert money.total([Decimal(\"1.00\"), Decimal(\"2.00\")]) == Decimal(\"3.00\")\n+    \n+    # Test with values that might have half-cents when summed\n+    assert money.total([Decimal(\"1.015\"), Decimal(\"2.025\")]) == Decimal(\"3.04\")\n+    \n+    # Test with mixed types (strings are OK, but not floats)\n+    assert money.total([Decimal(\"1.00\"), \"2.00\", \"3.00\"]) == Decimal(\"6.00\")\n+    \n+    # Test with empty list\n+    assert money.total([]) == Decimal(\"0\")\n+\n+\n+if __name__ == \"__main__\":\n+    test_total_function()\n+    print(\"Total function tests passed!\")\n",
