        "case_id": "issue-09",
        "summary": "A newly created event is sometimes missing from the events list endpoint even though the event exists and its direct URL works.",
        "invariants": [],
        "inputs": [],
        "expected_outputs": [],
        "out_of_scope": [
          "UI rendering of the events page",
