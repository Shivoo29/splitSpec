        "diff": "--- a/app/routes/events.py\n+++ b/app/routes/events.py\n@@ -6,7 +6,7 @@\n \n from fastapi import APIRouter, Depends, HTTPException, Query, Request\n from pydantic import BaseModel, Field, field_validator\n-from sqlalchemy import select\n+from sqlalchemy import select, func\n from sqlalchemy.orm import Session\n \n from app import money\n@@ -102,7 +102,7 @@\n     cached = request.app.state.cache.get(key)\n     if cached is not None:\n         return cached\n-    total = len(session.scalars(select(Event).limit(limit).offset(offset)).all())\n+    total = session.scalar(select(func.count()).select_from(Event))\n     rows = session.scalars(\n         select(Event).order_by(Event.starts_at.asc(), Event.id.asc()).limit(limit).offset(offset)\n     ).all()\n@@ -131,4 +131,4 @@\n         raise HTTPException(status_code=404, detail=\"event not found\")\n     payload = event_payload(event)\n     request.app.state.cache.set(key, payload)\n-    return payload+    return payload\n--- a/test_edge_cases.py\n+++ b/test_edge_cases.py\n@@ -0,0 +1,33 @@\n+\"\"\"Test edge cases for pagination.\"\"\"\n+import pytest\n+from httpx import AsyncClient\n+\n+\n+@pytest.mark.asyncio\n+async def test_different_pagination_combinations(client: AsyncClient):\n+    \"\"\"Test various pagination combinations.\"\"\"\n+    test_cases = [\n+        (\"/events?limit=1&offset=0\", 1),\n+        (\"/events?limit=1&offset=1\", 1),\n+        (\"/events?limit=1&offset=2\", 1),\n+        (\"/events?limit=5&offset=0\", 3),\n+        (\"/events?limit=5&offset=10\", 0),\n+    ]\n+    \n+    for url, expected_items in test_cases:\n+        r = await client.get(url)\n+        assert r.status_code == 200\n+        body = r.json()\n+        assert body['total'] == 3, f\"Expected total to be 3 for {url}, got {body['total']}\"\n+        assert len(body['items']) == expected_items, f\"Expected {expected_items} items for {url}, got {len(body['items'])}\"\n+\n+\n+@pytest.mark.asyncio\n+async def test_offset_beyond_total(client: AsyncClient):\n+    \"\"\"Test that offset beyond total returns empty items but correct total.\"\"\"\n+    r = await client.get(\"/events?limit=10&offset=100\")\n+    assert r.status_code == 200\n+    body = r.json()\n+    \n+    assert body['total'] == 3, f\"Expected total to be 3, got {body['total']}\"\n+    assert len(body['items']) == 0, f\"Expected 0 items, got {len(body['items'])}\"\n--- a/test_pagination_issue.py\n+++ b/test_pagination_issue.py\n@@ -0,0 +1,36 @@\n+\"\"\"Test to verify the pagination total issue.\"\"\"\n+import pytest\n+from httpx import AsyncClient\n+\n+\n+@pytest.mark.asyncio\n+async def test_pagination_total_issue(client: AsyncClient):\n+    \"\"\"Test that total reflects all events, not just the current page.\"\"\"\n+    \n+    # Get first page with limit=2\n+    r1 = await client.get(\"/events?limit=2&offset=0\")\n+    assert r1.status_code == 200\n+    body1 = r1.json()\n+    \n+    # Get second page with limit=2\n+    r2 = await client.get(\"/events?limit=2&offset=2\")\n+    assert r2.status_code == 200\n+    body2 = r2.json()\n+    \n+    # Get all events with large limit\n+    r3 = await client.get(\"/events?limit=100\")\n+    assert r3.status_code == 200\n+    body3 = r3.json()\n+    \n+    print(f\"Page 1 (limit=2, offset=0): total={body1['total']}, items={len(body1['items'])}\")\n+    print(f\"Page 2 (limit=2, offset=2): total={body2['total']}, items={len(body2['items'])}\")\n+    print(f\"All events (limit=100): total={body3['total']}, items={len(body3['items'])}\")\n+    \n+    # The total should be the same across all requests and equal to the actual total number of events\n+    assert body1['total'] == body2['total'] == body3['total'], \"Total should be consistent across pagination\"\n+    assert body1['total'] == 3, f\"Expected total to be 3, got {body1['total']}\"\n+    \n+    # Each page should have the expected number of items\n+    assert len(body1['items']) == 2, f\"Expected 2 items in first page, got {len(body1['items'])}\"\n+    assert len(body2['items']) == 1, f\"Expected 1 item in second page, got {len(body2['items'])}\"\n+    assert len(body3['items']) == 3, f\"Expected 3 items with large limit, got {len(body3['items'])}\"\n",
