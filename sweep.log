        "case_id": "issue-07",
        "summary": "Concurrent registration requests for the same user and event must not result in multiple confirmed registrations for that user\u2011event pair.",
        "invariants": [
          "At any point in time, the system must contain at most one registration record with status 'confirmed' for a given (user_id, event_id) combination."
        ],
        "inputs": [
          "Two or more registration requests submitted simultaneously (or near\u2011simultaneously) for the same user_id and event_id via the public registration API."
        ],
        "expected_outputs": [
          "Exactly one registration record with status 'confirmed' is persisted for that (user_id, event_id).",
          "All additional concurrent requests receive an error response or a no\u2011op indicating that a registration already exists."
        ],
        "out_of_scope": [
