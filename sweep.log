 print(f\"Page 1 (offset 0): {page1_ids}\")\n+    print(f\"Page 2 (offset 2): {page2_ids}\")\n+    print(f\"Page 3 (offset 4): {page3_ids}\")\n+    print(f\"Paginated concatenated: {paginated_ids}\")\n+    \n+    # Check that paginated results match full results\n+    assert paginated_ids == full_ids, f\"Paginated {paginated_ids} != Full {full_ids}\"\n+    \n+    # Check no duplicates\n+    assert len(paginated_ids) == len(set(paginated_ids)), \"Duplicate items found\"\n+    \n+    # Check all items are present\n+    assert len(paginated_ids) == len(full_ids), \"Missing items\"\n+\n+\n+@pytest.mark.anyio\n+async def test_offset_zero(client: AsyncClient):\n+    \"\"\"Test that offset=0 returns the first items.\"\"\"\n+    response = await client.get(\"/events\", params={\"limit\": 2, \"offset\": 0})\n+    data = response.json()\n+    ids = [e[\"id\"] for e in data[\"items\"]]\n+    \n+    print(f\"Offset 0 with limit 2: {ids}\")\n+    # Should be first 2 items: [3, 1]\n+    assert ids == [3, 1], f\"Expected [3, 1], got {ids}\"\n+\n+\n+@pytest.mark.anyio\n+async def test_offset_two(client: AsyncClient):\n+    \"\"\"Test that offset=2 returns items starting from position 2.\"\"\"\n+    response = await client.get(\"/events\", params={\"limit\": 2, \"offset\": 2})\n+    data = response.json()\n+    ids = [e[\"id\"] for e in data[\"items\"]]\n+    \n+    print(f\"Offset 2 with limit 2: {ids}\")\n+    # Should be items at positions 2 and 3: [2] (only one item left)\n+    assert ids == [2], f\"Expected [2], got {ids}\"\n--- a/test_pagination_verification.py\n+++ b/test_pagination_verification.py\n@@ -0,0 +1,91 @@\n+\"\"\"Comprehensive test to verify pagination fix.\"\"\"\n+import pytest\n+from httpx import AsyncClient\n+\n+\n+@pytest.mark.anyio\n+async def test_pagination_matches_full_list(client: AsyncClient):\n+    \"\"\"Verify that paginated results exactly match the full list.\"\"\"\n+    # Get all events without pagination\n+    full_response = await client.get(\"/events\")\n+    full_data = full_response.json()\n+    full_ids = [e[\"id\"] for e in full_data[\"items\"]]\n+    total = full_data[\"total\"]\n+    \n+    print(f\"\\nFull list (total={total}): {full_ids}\")\n+    \n+    # Test pagination with limit=2\n+    paginated_ids = []\n+    for offset in range(0, total, 2):\n+        response = await client.get(\"/events\", params={\"limit\": 2, \"offset\": offset})\n+        data = response.json()\n+        page_ids = [e[\"id\"] for e in data[\"items\"]]\n+        paginated_ids.extend(page_ids)\n+        print(f\"  Page at offset {offset}: {page_ids}\")\n+    \n+    print(f\"Paginated concatenated: {paginated_ids}\")\n+    \n+    # Verify no duplicates\n+    assert len(paginated_ids) == len(set(paginated_ids)), \"Duplicate items in paginated results\"\n+    \n+    # Verify all items present\n+    assert len(paginated_ids) == len(full_ids), f\"Item count mismatch: {len(paginated_ids)} != {len(full_ids)}\"\n+    \n+    # Verify exact match\n+    assert paginated_ids == full_ids, f\"Order mismatch: {paginated_ids} != {full_ids}\"\n+    \n+    print(\"\u2713 Pagination matches full list perfectly!\")\n+\n+\n+@pytest.mark.anyio\n+async def test_offset_behavior(client: AsyncClient):\n+    \"\"\"Test that offset parameter works correctly.\"\"\"\n+    # Test offset=0 (first page)\n+    response = await client.get(\"/events\", params={\"limit\": 2, \"offset\": 0})\n+    data = response.json()\n+    ids = [e[\"id\"] for e in data[\"items\"]]\n+    assert ids == [3, 1], f\"Offset 0 should return [3, 1], got {ids}\"\n+    print(f\"\u2713 Offset 0: {ids}\")\n+    \n+    # Test offset=1 (second item)\n+    response = await client.get(\"/events\", params={\"limit\": 2, \"offset\": 1})\n+    data = response.json()\n+    ids = [e[\"id\"] for e in data[\"items\"]]\n+    assert ids == [1, 2], f\"Offset 1 should return [1, 2], got {ids}\"\n+    print(f\"\u2713 Offset 1: {ids}\")\n+    \n+    # Test offset=2 (third item)\n+    response = await client.get(\"/events\", params={\"limit\": 2, \"offset\": 2})\n+    data = response.json()\n+    ids = [e[\"id\"] for e in data[\"items\"]]\n+    assert ids == [2], f\"Offset 2 should return [2], got {ids}\"\n+    print(f\"\u2713 Offset 2: {ids}\")\n+    \n+    # Test offset=3 (beyond data)\n+    response = await client.get(\"/events\", params={\"limit\": 2, \"offset\": 3})\n+    data = response.json()\n+    ids = [e[\"id\"] for e in data[\"items\"]]\n+    assert ids == [], f\"Offset 3 should return [], got {ids}\"\n+    print(f\"\u2713 Offset 3: {ids}\")\n+\n+\n+@pytest.mark.anyio\n+async def test_pagination_with_different_limits(client: AsyncClient):\n+    \"\"\"Test pagination with various limit values.\"\"\"\n+    full_response = await client.get(\"/events\")\n+    full_ids = [e[\"id\"] for e in full_response.json()[\"items\"]]\n+    \n+    for limit in [1, 2, 3, 10]:\n+        paginated_ids = []\n+        offset = 0\n+        while True:\n+            response = await client.get(\"/events\", params={\"limit\": limit, \"offset\": offset})\n+            data = response.json()\n+            page_ids = [e[\"id\"] for e in data[\"items\"]]\n+            if not page_ids:\n+                break\n+            paginated_ids.extend(page_ids)\n+            offset += limit\n+        \n+        assert paginated_ids == full_ids, f\"Pagination with limit={limit} failed: {paginated_ids} != {full_ids}\"\n+        print(f\"\u2713 Limit {limit}: {paginated_ids}\")\n",
