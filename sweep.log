      "contract": {
        "case_id": "issue-03",
        "summary": "Events created with a non\u2011UTC timezone offset are stored and retrieved with an incorrect UTC conversion, causing a two\u2011hour shift.",
        "invariants": [
          "When an event creation request includes a start_time that carries a non\u2011zero timezone offset, the system must store the start_time as the exact same instant converted to UTC.",
          "When an event is retrieved via the API, the returned start_time must correspond to the UTC instant that was stored, i.e., the original local time adjusted by the supplied offset."
        ],
        "inputs": [
          "POST /events (or equivalent creation endpoint) with a start_time value that includes an explicit offset, e.g. \"2023-09-15T10:00:00+02:00\"",
          "GET /events/{id} (or equivalent retrieval endpoint) for the event created above"
        ],
        "expected_outputs": [
          "The stored UTC timestamp equals the input timestamp converted to UTC (e.g., \"2023-09-15T08:00:00Z\" for a +02:00 input).",
          "The retrieval response contains a start_time that reflects this UTC timestamp (either as an ISO\u20118601 Z\u2011suffix string or as a timezone\u2011aware datetime equivalent to the stored UTC instant)."
        ],
        "out_of_scope": [
          "Rendering of the time on the front\u2011end UI, including any client\u2011side timezone adjustments.",
          "Handling of events that are created without an explicit offset (i.e., already in UTC).",
          "Any behavior unrelated to the start_time field (e.g., end_time, location, payment processing)."
        ],
        "ambiguities": [
          "Exact request/response field name and format for the start_time (e.g., ISO\u20118601 string, separate timezone field).",
