        "contents": "import pytest\nimport pytest_asyncio\nimport httpx\nfrom app.main import create_app\nfrom app.timeutil import FixedClock\nfrom seed import ALICE_TOKEN, seed\n\n@pytest.fixture\ndef app():\n    # Setup app with in-memory db as in conftest.py\n    application = create_app(\"sqlite://\", clock=FixedClock.from_iso(\"2026-01-01T12:00:00+00:00\"))\n    with application.state.sessionmaker() as session:\n        seed(session)\n    return application\n\n@pytest_asyncio.fixture\nasync def client(app):\n    transport = httpx.ASGITransport(app=app)\n    async with httpx.AsyncClient(transport=transport, base_url=\"http://test\") as ac:\n        yield ac\n\n@pytest.mark.asyncio\nasync def test_cross_user_ticket_access(client):\n    # Ticket 4 belongs to User 3 (Carol), not Alice (User 1)\n    # Alice should not be able to access it\n    response = await client.get(\n        \"/tickets/4\",\n        headers={\"Authorization\": f\"Bearer {ALICE_TOKEN}\"}\n    )\n    \n    # Assert that Alice cannot access Carol's ticket\n    # The requirement is that it must not return details.\n    # An error code is expected (403 or 404).\n    assert response.status_code != 200, f\"Alice successfully accessed Carol's ticket: {response.json()}\"\n    \n    # Ticket 3 belongs to User 1 (Alice)\n    # Alice should be able to access it\n    response_ok = await client.get(\n        \"/tickets/3\",\n        headers={\"Authorization\": f\"Bearer {ALICE_TOKEN}\"}\n    )\n    assert response_ok.status_code == 200, f\"Alice failed to access her own ticket: {response_ok.status_code}\"\n    assert response_ok.json()[\"user_id\"] == 1",
