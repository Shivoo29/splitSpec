        "diff": "--- a/app/routes/events.py\n+++ b/app/routes/events.py\n@@ -13,7 +13,7 @@\n from app.auth import get_current_user\n from app.db import get_session\n from app.models import Event, User\n-from app.timeutil import iso8601_utc\n+from app.timeutil import iso8601_utc, to_utc_naive\n \n router = APIRouter(prefix=\"/events\", tags=[\"events\"])\n \n@@ -78,7 +78,7 @@\n     event = Event(\n         title=payload.title,\n         description=payload.description,\n-        starts_at=payload.starts_at.replace(tzinfo=None),\n+        starts_at=to_utc_naive(payload.starts_at),\n         capacity=payload.capacity,\n         price=money.quantize(payload.price, payload.currency),\n         currency=payload.currency,\n@@ -131,4 +131,4 @@\n         raise HTTPException(status_code=404, detail=\"event not found\")\n     payload = event_payload(event)\n     request.app.state.cache.set(key, payload)\n-    return payload+    return payload\n--- a/final_verification_test.py\n+++ b/final_verification_test.py\n@@ -0,0 +1,41 @@\n+\"\"\"Final verification test for the timezone offset fix.\"\"\"\n+import pytest\n+from httpx import AsyncClient\n+\n+\n+@pytest.mark.asyncio\n+async def test_issue_03_timezone_conversion(client: AsyncClient, auth_headers, tokens):\n+    \"\"\"\n+    Test that demonstrates the fix for issue-03.\n+    \n+    When an event is created with a start time that includes a non-zero timezone offset,\n+    the API should preserve the intended instant and return the correct UTC representation.\n+    \"\"\"\n+    # Create event with +02:00 timezone offset\n+    # 10:00 in +02:00 timezone should be stored as 08:00 UTC\n+    r = await client.post(\n+        \"/events\",\n+        headers=auth_headers(tokens[\"alice\"]),\n+        json={\n+            \"title\": \"Morning Standup\",\n+            \"starts_at\": \"2023-09-15T10:00:00+02:00\",\n+            \"capacity\": 5,\n+            \"price\": \"10.00\",\n+        },\n+    )\n+    \n+    # Verify the response\n+    assert r.status_code == 201\n+    assert r.json()[\"starts_at\"] == \"2023-09-15T08:00:00+00:00\"\n+    \n+    event_id = r.json()[\"id\"]\n+    \n+    # Retrieve the event and verify the time is correct\n+    got = await client.get(f\"/events/{event_id}\")\n+    assert got.status_code == 200\n+    assert got.json()[\"starts_at\"] == \"2023-09-15T08:00:00+00:00\"\n+    \n+    print(\"\u2713 Issue-03 fixed: Timezone offset is properly converted to UTC\")\n+    print(f\"  Input: 2023-09-15T10:00:00+02:00 (10:00 in +02:00 timezone)\")\n+    print(f\"  Stored: 2023-09-15T08:00:00+00:00 (08:00 UTC)\")\n+    print(f\"  The instant is preserved correctly!\")\n--- a/test_comprehensive_timezone.py\n+++ b/test_comprehensive_timezone.py\n@@ -0,0 +1,66 @@\n+\"\"\"Comprehensive test for timezone handling.\"\"\"\n+import pytest\n+from httpx import AsyncClient\n+\n+\n+@pytest.mark.asyncio\n+async def test_various_timezones(client: AsyncClient, auth_headers, tokens):\n+    \"\"\"Test that various timezone offsets are properly converted to UTC.\"\"\"\n+    \n+    # Test 1: Positive offset (+02:00)\n+    r = await client.post(\n+        \"/events\",\n+        headers=auth_headers(tokens[\"alice\"]),\n+        json={\n+            \"title\": \"Test +02:00\",\n+            \"starts_at\": \"2023-09-15T10:00:00+02:00\",\n+            \"capacity\": 5,\n+            \"price\": \"10.00\",\n+        },\n+    )\n+    assert r.status_code == 201\n+    assert r.json()[\"starts_at\"] == \"2023-09-15T08:00:00+00:00\"  # 10:00 - 2:00\n+    \n+    # Test 2: Negative offset (-05:00)\n+    r = await client.post(\n+        \"/events\",\n+        headers=auth_headers(tokens[\"alice\"]),\n+        json={\n+            \"title\": \"Test -05:00\",\n+            \"starts_at\": \"2023-09-15T10:00:00-05:00\",\n+            \"capacity\": 5,\n+            \"price\": \"10.00\",\n+        },\n+    )\n+    assert r.status_code == 201\n+    assert r.json()[\"starts_at\"] == \"2023-09-15T15:00:00+00:00\"  # 10:00 + 5:00\n+    \n+    # Test 3: UTC (Z)\n+    r = await client.post(\n+        \"/events\",\n+        headers=auth_headers(tokens[\"alice\"]),\n+        json={\n+            \"title\": \"Test UTC\",\n+            \"starts_at\": \"2023-09-15T10:00:00Z\",\n+            \"capacity\": 5,\n+            \"price\": \"10.00\",\n+        },\n+    )\n+    assert r.status_code == 201\n+    assert r.json()[\"starts_at\"] == \"2023-09-15T10:00:00+00:00\"  # UTC stays UTC\n+    \n+    # Test 4: Naive datetime (no timezone)\n+    r = await client.post(\n+        \"/events\",\n+        headers=auth_headers(tokens[\"alice\"]),\n+        json={\n+            \"title\": \"Test Naive\",\n+            \"starts_at\": \"2023-09-15T10:00:00\",\n+            \"capacity\": 5,\n+            \"price\": \"10.00\",\n+        },\n+    )\n+    assert r.status_code == 201\n+    assert r.json()[\"starts_at\"] == \"2023-09-15T10:00:00+00:00\"  # Naive treated as UTC\n+    \n+    print(\"All timezone tests passed!\")\n--- a/test_edge_cases.py\n+++ b/test_edge_cases.py\n@@ -0,0 +1,38 @@\n+\"\"\"Test edge cases for timezone handling.\"\"\"\n+import pytest\n+from httpx import AsyncClient\n+\n+\n+@pytest.mark.asyncio\n+async def test_edge_cases(client: AsyncClient, auth_headers, tokens):\n+    \"\"\"Test edge cases for timezone handling.\"\"\"\n+    \n+    # Test with +00:00 (explicit UTC)\n+    r = await client.post(\n+        \"/events\",\n+        headers=auth_headers(tokens[\"alice\"]),\n+        json={\n+            \"title\": \"Test +00:00\",\n+            \"starts_at\": \"2023-09-15T10:00:00+00:00\",\n+            \"capacity\": 5,\n+            \"price\": \"10.00\",\n+        },\n+    )\n+    assert r.status_code == 201\n+    assert r.json()[\"starts_at\"] == \"2023-09-15T10:00:00+00:00\"\n+    \n+    # Test with fractional minutes in offset\n+    r = await client.post(\n+        \"/events\",\n+        headers=auth_headers(tokens[\"alice\"]),\n+        json={\n+            \"title\": \"Test +05:30\",\n+            \"starts_at\": \"2023-09-15T10:00:00+05:30\",\n+            \"capacity\": 5,\n+            \"price\": \"10.00\",\n+        },\n+    )\n+    assert r.status_code == 201\n+    assert r.json()[\"starts_at\"] == \"2023-09-15T04:30:00+00:00\"  # 10:00 - 5:30\n+    \n+    print(\"Edge case tests passed!\")\n--- a/test_pydantic_datetime.py\n+++ b/test_pydantic_datetime.py\n@@ -0,0 +1,27 @@\n+\"\"\"Test how Pydantic handles datetime parsing.\"\"\"\n+from datetime import datetime\n+from pydantic import BaseModel\n+\n+\n+class TestModel(BaseModel):\n+    dt: datetime\n+\n+\n+# Test with timezone offset\n+result = TestModel(dt=\"2023-09-15T10:00:00+02:00\")\n+print(f\"Input: 2023-09-15T10:00:00+02:00\")\n+print(f\"Parsed datetime: {result.dt}\")\n+print(f\"Timezone info: {result.dt.tzinfo}\")\n+print(f\"UTC equivalent: {result.dt.astimezone(None)}\")\n+\n+# Test with UTC\n+result2 = TestModel(dt=\"2023-09-15T10:00:00Z\")\n+print(f\"\\nInput: 2023-09-15T10:00:00Z\")\n+print(f\"Parsed datetime: {result2.dt}\")\n+print(f\"Timezone info: {result2.dt.tzinfo}\")\n+\n+# Test with no timezone\n+result3 = TestModel(dt=\"2023-09-15T10:00:00\")\n+print(f\"\\nInput: 2023-09-15T10:00:00\")\n+print(f\"Parsed datetime: {result3.dt}\")\n+print(f\"Timezone info: {result3.dt.tzinfo}\")\n--- a/test_roundtrip_timezone.py\n+++ b/test_roundtrip_timezone.py\n@@ -0,0 +1,38 @@\n+\"\"\"Test round-trip for timezone handling.\"\"\"\n+import pytest\n+from httpx import AsyncClient\n+\n+\n+@pytest.mark.asyncio\n+async def test_timezone_roundtrip(client: AsyncClient, auth_headers, tokens):\n+    \"\"\"Test that timezone conversion is preserved in round-trip.\"\"\"\n+    \n+    # Create event with +02:00 timezone offset\n+    r = await client.post(\n+        \"/events\",\n+        headers=auth_headers(tokens[\"alice\"]),\n+        json={\n+            \"title\": \"Morning Standup\",\n+            \"starts_at\": \"2023-09-15T10:00:00+02:00\",\n+            \"capacity\": 5,\n+            \"price\": \"10.00\",\n+        },\n+    )\n+    assert r.status_code == 201\n+    event_id = r.json()[\"id\"]\n+    \n+    # Verify creation response\n+    assert r.json()[\"starts_at\"] == \"2023-09-15T08:00:00+00:00\"\n+    \n+    # Retrieve the event\n+    got = await client.get(f\"/events/{event_id}\")\n+    assert got.status_code == 200\n+    \n+    # Verify retrieval response matches creation response\n+    assert got.json()[\"starts_at\"] == \"2023-09-15T08:00:00+00:00\"\n+    \n+    # Verify the instant is correct (10:00 in +02:00 timezone = 08:00 UTC)\n+    # The stored time should represent the same instant\n+    print(f\"Created: {r.json()['starts_at']}\")\n+    print(f\"Retrieved: {got.json()['starts_at']}\")\n+    print(\"Round-trip test passed!\")\n--- a/test_timezone_offset.py\n+++ b/test_timezone_offset.py\n@@ -0,0 +1,36 @@\n+\"\"\"Test to reproduce the timezone offset issue.\"\"\"\n+import pytest\n+from httpx import AsyncClient\n+\n+\n+@pytest.mark.asyncio\n+async def test_timezone_offset_preserved(client: AsyncClient, auth_headers, tokens):\n+    \"\"\"Test that a timezone offset is properly converted to UTC.\"\"\"\n+    # Create event with +02:00 timezone offset (10:00 in timezone = 08:00 UTC)\n+    r = await client.post(\n+        \"/events\",\n+        headers=auth_headers(tokens[\"alice\"]),\n+        json={\n+            \"title\": \"Morning Standup\",\n+            \"starts_at\": \"2023-09-15T10:00:00+02:00\",\n+            \"capacity\": 5,\n+            \"price\": \"10.00\",\n+        },\n+    )\n+    print(f\"Create response: {r.status_code}\")\n+    print(f\"Create response body: {r.json()}\")\n+    assert r.status_code == 201\n+    \n+    # The stored UTC time should be 08:00:00 (10:00 - 2:00)\n+    assert r.json()[\"starts_at\"] == \"2023-09-15T08:00:00+00:00\"\n+    \n+    event_id = r.json()[\"id\"]\n+    \n+    # Retrieve the event and verify the time is correct\n+    got = await client.get(f\"/events/{event_id}\")\n+    print(f\"Get response: {got.status_code}\")\n+    print(f\"Get response body: {got.json()}\")\n+    assert got.status_code == 200\n+    \n+    # The retrieved time should represent the same instant (08:00 UTC)\n+    assert got.json()[\"starts_at\"] == \"2023-09-15T08:00:00+00:00\"\n",
