= await client.post(\"/events\", headers=auth_headers(tokens[\"alice\"]), json=payload)\n+    assert r.status_code == 201\n+    # Verify event was created\n+    listing = (await client.get(\"/events\")).json()\n+    titles = [e[\"title\"] for e in listing[\"items\"]]\n+    assert \"Free Event\" in titles\n+\n+\n+async def test_missing_title_is_rejected(client, auth_headers, tokens):\n+    \"\"\"Test that missing title field is rejected.\"\"\"\n+    payload = {\n+        \"starts_at\": \"2026-06-01T09:00:00Z\",\n+        \"capacity\": 10,\n+        \"price\": \"25.00\",\n+        \"currency\": \"USD\",\n+    }\n+    r = await client.post(\"/events\", headers=auth_headers(tokens[\"alice\"]), json=payload)\n+    assert r.status_code == 422\n+\n+\n+async def test_null_title_is_rejected(client, auth_headers, tokens):\n+    \"\"\"Test that null title is rejected.\"\"\"\n+    payload = {\n+        \"title\": None,\n+        \"starts_at\": \"2026-06-01T09:00:00Z\",\n+        \"capacity\": 10,\n+        \"price\": \"25.00\",\n+        \"currency\": \"USD\",\n+    }\n+    r = await client.post(\"/events\", headers=auth_headers(tokens[\"alice\"]), json=payload)\n+    assert r.status_code == 422\n--- a/visible_tests/issue-01/test_issue_requirements.py\n+++ b/visible_tests/issue-01/test_issue_requirements.py\n@@ -0,0 +1,59 @@\n+\"\"\"Visible: comprehensive tests for issue-01 requirements.\"\"\"\n+from __future__ import annotations\n+\n+\n+async def test_empty_string_title_rejected(client, auth_headers, tokens):\n+    \"\"\"Test that empty string title is rejected (issue-01 requirement).\"\"\"\n+    payload = {\n+        \"title\": \"\",\n+        \"starts_at\": \"2026-06-01T09:00:00Z\",\n+        \"capacity\": 10,\n+        \"price\": \"25.00\",\n+        \"currency\": \"USD\",\n+    }\n+    r = await client.post(\"/events\", headers=auth_headers(tokens[\"alice\"]), json=payload)\n+    # Must respond with client-error HTTP status code\n+    assert 400 <= r.status_code < 500\n+    # Must include validation error indication\n+    assert r.json() is not None\n+    # Must not persist the event\n+    listing = (await client.get(\"/events\")).json()\n+    titles = [e[\"title\"] for e in listing[\"items\"]]\n+    assert \"\" not in titles\n+\n+\n+async def test_negative_ticket_price_rejected(client, auth_headers, tokens):\n+    \"\"\"Test that negative ticket price is rejected (issue-01 requirement).\"\"\"\n+    payload = {\n+        \"title\": \"Nightly Build\",\n+        \"starts_at\": \"2026-06-01T09:00:00Z\",\n+        \"capacity\": 10,\n+        \"price\": \"-5.00\",\n+        \"currency\": \"USD\",\n+    }\n+    r = await client.post(\"/events\", headers=auth_headers(tokens[\"alice\"]), json=payload)\n+    # Must respond with client-error HTTP status code\n+    assert 400 <= r.status_code < 500\n+    # Must include validation error indication\n+    assert r.json() is not None\n+    # Must not persist the event\n+    listing = (await client.get(\"/events\")).json()\n+    titles = [e[\"title\"] for e in listing[\"items\"]]\n+    assert \"Nightly Build\" not in titles\n+\n+\n+async def test_valid_event_still_works(client, auth_headers, tokens):\n+    \"\"\"Test that valid events can still be created (regression test).\"\"\"\n+    payload = {\n+        \"title\": \"Valid Event\",\n+        \"starts_at\": \"2026-06-01T09:00:00Z\",\n+        \"capacity\": 10,\n+        \"price\": \"25.00\",\n+        \"currency\": \"USD\",\n+    }\n+    r = await client.post(\"/events\", headers=auth_headers(tokens[\"alice\"]), json=payload)\n+    assert r.status_code == 201\n+    # Verify event was created\n+    listing = (await client.get(\"/events\")).json()\n+    titles = [e[\"title\"] for e in listing[\"items\"]]\n+    assert \"Valid Event\" in titles\n--- a/visible_tests/issue-01/test_validation.py\n+++ b/visible_tests/issue-01/test_validation.py\n@@ -0,0 +1,36 @@\n+\"\"\"Visible: validation tests for event creation.\"\"\"\n+from __future__ import annotations\n+\n+\n+async def test_empty_title_is_rejected(client, auth_headers, tokens):\n+    \"\"\"Test that empty title is rejected with client-error status code.\"\"\"\n+    payload = {\n+        \"title\": \"\",\n+        \"starts_at\": \"2026-06-01T09:00:00Z\",\n+        \"capacity\": 10,\n+        \"price\": \"25.00\",\n+        \"currency\": \"USD\",\n+    }\n+    r = await client.post(\"/events\", headers=auth_headers(tokens[\"alice\"]), json=payload)\n+    assert r.status_code == 422  # 422 is the standard FastAPI/Pydantic validation error code\n+    # Verify event was not created\n+    listing = (await client.get(\"/events\")).json()\n+    titles = [e[\"title\"] for e in listing[\"items\"]]\n+    assert \"\" not in titles\n+\n+\n+async def test_negative_price_is_rejected(client, auth_headers, tokens):\n+    \"\"\"Test that negative price is rejected with client-error status code.\"\"\"\n+    payload = {\n+        \"title\": \"Nightly Build\",\n+        \"starts_at\": \"2026-06-01T09:00:00Z\",\n+        \"capacity\": 10,\n+        \"price\": \"-5.00\",\n+        \"currency\": \"USD\",\n+    }\n+    r = await client.post(\"/events\", headers=auth_headers(tokens[\"alice\"]), json=payload)\n+    assert r.status_code == 422  # 422 is the standard FastAPI/Pydantic validation error code\n+    # Verify event was not created\n+    listing = (await client.get(\"/events\")).json()\n+    titles = [e[\"title\"] for e in listing[\"items\"]]\n+    assert \"Nightly Build\" not in titles\n",
